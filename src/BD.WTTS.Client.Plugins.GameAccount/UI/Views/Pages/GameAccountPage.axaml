<spp:PageBase
    Description="{Binding Description, Source={x:Static s:Plugin.Instance}, Mode=OneWay}"
    Subtitle="{Binding Author, Source={x:Static s:Plugin.Instance}, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter=Plugin_Author}"
    Title="{Binding Name, Source={x:Static s:Plugin.Instance}, Mode=OneWay}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="BD.WTTS.UI.Views.Pages.GameAccountPage"
    x:CompileBindings="True"
    x:DataType="spp:GameAccountPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ms="https://steampp.net/settings"
    xmlns:s="https://steampp.net/services"
    xmlns:spp="https://steampp.net/ui"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <spp:PageBase.PreviewImage>
        <ui:FAImageIconSource Source="{Binding Icon, Source={x:Static s:Plugin.Instance}, Mode=OneWay, Converter={StaticResource BitmapAssetValueConverter}}" />
    </spp:PageBase.PreviewImage>
    <spp:PageBase.TabContent>
        <!--<TabStrip
            Margin="4"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="{DynamicResource ControlOnImageFillColorDefaultBrush}"
            CornerRadius="{StaticResource ControlCornerRadius}"
            ItemContainerTheme="{StaticResource TabItemStyle}">
            <TabStripItem Content="多平台账号切换" />
            <TabStripItem Content="Steam 家庭共享库管理" />
        </TabStrip>-->
    </spp:PageBase.TabContent>
    <spp:PageBase.ActionContent>
        <StackPanel Orientation="Horizontal" Spacing="2">
            <Button
                Command="{Binding LoginNewCommand}"
                DockPanel.Dock="Right"
                Padding="8,4"
                Theme="{StaticResource TransparentButton}">
                <Panel>
                    <Viewbox
                        Height="16"
                        HorizontalAlignment="Left"
                        Width="16">
                        <ui:FASymbolIcon Symbol="Add" />
                    </Viewbox>
                    <TextBlock
                        HorizontalAlignment="Left"
                        Margin="28,4,0,4"
                        Text="{Binding Path=Res.UserChange_LoginNewAccount, Mode=OneWay, Source={x:Static s:ResourceService.Current}}"
                        VerticalAlignment="Center" />
                </Panel>
            </Button>
            <Button
                Command="{Binding SaveCurrentUserCommand}"
                DockPanel.Dock="Right"
                IsVisible="{Binding !IsSelectedSteam}"
                Padding="8,4"
                Theme="{StaticResource TransparentButton}">
                <Panel>
                    <Viewbox
                        Height="16"
                        HorizontalAlignment="Left"
                        Width="16">
                        <ui:FASymbolIcon Symbol="Save" />
                    </Viewbox>
                    <TextBlock
                        HorizontalAlignment="Left"
                        Margin="28,4,0,4"
                        Text="{Binding Path=Res.GameAccount_SaveCurrentAccount, Mode=OneWay, Source={x:Static s:ResourceService.Current}}"
                        VerticalAlignment="Center" />
                </Panel>
            </Button>
            <!--  <Button  -->
            <!--  Command="{Binding ShareManageCommand}"  -->
            <!--  DockPanel.Dock="Right"  -->
            <!--  IsVisible="{Binding IsSelectedSteam}"  -->
            <!--  Padding="8,4"  -->
            <!--  Theme="{StaticResource TransparentButton}">  -->
            <!--     <Panel> -->
            <!--  <Viewbox  -->
            <!--  Height="16"  -->
            <!--  HorizontalAlignment="Left"  -->
            <!--  Width="16">  -->
            <!--             <ui:FASymbolIcon Symbol="ShareAndroid" /> -->
            <!--         </Viewbox> -->
            <!--  <TextBlock  -->
            <!--  HorizontalAlignment="Left"  -->
            <!--  Margin="28,4,0,4"  -->
            <!--  Text="{Binding Path=Res.AccountChange_Title, Mode=OneWay, Source={x:Static s:ResourceService.Current}}"  -->
            <!--  VerticalAlignment="Center" />  -->
            <!--     </Panel> -->
            <!-- </Button> -->
            <Button
                Command="{Binding RefreshCommand}"
                DockPanel.Dock="Right"
                Padding="8,4"
                Theme="{StaticResource TransparentButton}">
                <Panel>
                    <Viewbox
                        Height="16"
                        HorizontalAlignment="Left"
                        Width="16">
                        <ui:FASymbolIcon Symbol="Refresh" />
                    </Viewbox>
                    <TextBlock
                        HorizontalAlignment="Left"
                        Margin="28,4,0,4"
                        Text="{Binding Path=Res.Refresh, Mode=OneWay, Source={x:Static s:ResourceService.Current}}"
                        VerticalAlignment="Center" />
                </Panel>
            </Button>
            <DropDownButton
                Content="{StaticResource More}"
                FontFamily="{StaticResource SymbolThemeFontFamily}"
                FontSize="20"
                HorizontalContentAlignment="Center"
                Padding="8"
                Theme="{StaticResource TransparentButton}"
                VerticalContentAlignment="Center">
                <DropDownButton.Flyout>
                    <ui:FAMenuFlyout Placement="BottomEdgeAlignedRight">
                        <ui:FAMenuFlyoutItem
                            IsVisible="{Binding !IsSelectedSteam}"
                            Text="平台设置"
                            x:Name="PlatformSettingButton" />
                        <!--<ui:FAMenuFlyoutItem x:Name="PluginSettingButton" Text="{Binding Path=Res.Settings_Plugin, Mode=OneWay,Source={x:Static s:ResourceService.Current}}" />-->
                        <ui:FAToggleMenuFlyoutItem
                            IsChecked="{Binding Source={x:Static ms:GameAccountSettings.IsShowAccountName}, Path=Value, Mode=TwoWay}"
                            IsVisible="{Binding IsSelectedSteam}"
                            Text="显示用户名" />
                        <ui:FAMenuFlyoutSeparator IsVisible="{Binding !IsSelectedSteam}" />
                        <ui:FAMenuFlyoutItem IsEnabled="False">
                            <ui:FAMenuFlyoutItem.Text>
                                <MultiBinding StringFormat="{}{0}{1}">
                                    <ReflectionBinding
                                        Mode="OneWay"
                                        Path="Res.Plugin_Version"
                                        Source="{x:Static s:ResourceService.Current}" />
                                    <ReflectionBinding
                                        Mode="OneWay"
                                        Path="Version"
                                        Source="{x:Static s:Plugin.Instance}" />
                                </MultiBinding>
                            </ui:FAMenuFlyoutItem.Text>
                        </ui:FAMenuFlyoutItem>
                        <!--<ui:FAMenuFlyoutItem Text="{Binding Path=Res.ViewInStore, Mode=OneWay, Source={x:Static s:ResourceService.Current}}" />
                        <ui:FAMenuFlyoutItem Text="{Binding Path=Res.UseHelp, Mode=OneWay, Source={x:Static s:ResourceService.Current}}" />
                        <ui:FAMenuFlyoutItem Text="{Binding Path=Res.AboutThisPlugin, Mode=OneWay, Source={x:Static s:ResourceService.Current}}" />-->
                    </ui:FAMenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </StackPanel>
    </spp:PageBase.ActionContent>
    <ui:FATabView
        Background="Transparent"
        CloseButtonOverlayMode="OnPointerOver"
        IsAddTabButtonVisible="False"
        Padding="0"
        SelectedItem="{Binding SelectedPlatform}"
        SelectionChanged="TabView_SelectedItemChanged"
        TabCloseRequested="TabView_TabCloseRequested"
        TabItems="{Binding GamePlatforms}"
        TabWidthMode="Equal"
        VerticalAlignment="Stretch">
        <ui:FATabView.TabStripFooter>
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button
                    Grid.Column="0"
                    Content="&#xE710;"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    HorizontalAlignment="Left"
                    Theme="{StaticResource TabViewButtonStyle}"
                    VerticalAlignment="Center">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuItem
                                Header="{Binding Path=Res.AddPlatform, Mode=OneWay, Source={x:Static s:ResourceService.Current}}"
                                IsVisible="{Binding !!AddGamePlatforms.Count}"
                                ItemsSource="{Binding AddGamePlatforms}">
                                <MenuItem.Styles>
                                    <Style Selector="MenuItem" x:DataType="spp:PlatformAccount">
                                        <Setter Property="Header" Value="{Binding FullName}" />
                                        <Setter Property="Icon">
                                            <Setter.Value>
                                                <Template>
                                                    <PathIcon Data="{Binding Icon, Converter={StaticResource ResourceKeyValueConverter}}" />
                                                </Template>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Command" Value="{Binding $parent[spp:PageBase].((spp:GameAccountPageViewModel)DataContext).AddPlatformCommand}" />
                                        <Setter Property="CommandParameter" Value="{Binding}" />
                                    </Style>
                                </MenuItem.Styles>
                                <!--<MenuItem.DataTemplates>
                                    <DataTemplate DataType="{x:Type spp:PlatformAccount}">
                                        <MenuItem
                                            Command="{Binding $parent[spp:PageBase].((spp:GameAccountPageViewModel)DataContext).AddPlatformCommand}"
                                            CommandParameter="{Binding}"
                                            Header="{Binding FullName}">
                                            <MenuItem.Icon>
                                                <PathIcon Data="{Binding Icon, Converter={StaticResource ResourceKeyValueConverter}}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </DataTemplate>
                                </MenuItem.DataTemplates>-->
                            </MenuItem>
                            <MenuItem Header="-" IsVisible="{Binding !!AddGamePlatforms.Count}" />
                            <MenuItem Command="{Binding LoginNewCommand}" Header="{Binding Path=Res.UserChange_LoginNewAccount, Mode=OneWay, Source={x:Static s:ResourceService.Current}}">
                                <MenuItem.Icon>
                                    <ui:FASymbolIcon Symbol="Add" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <!--<ui:FAMenuFlyoutSeparator />
                            <ui:FAMenuFlyoutSubItem Text="{Binding Path=Res.GameAccount_EndProcessWay, Mode=OneWay, Source={x:Static s:ResourceService.Current}}">
                                <ui:FARadioMenuFlyoutItem
                                    GroupName="KillMethond"
                                    IconSource="Games"
                                    Text="TaskKill" />

                 <ui:FARadioMenuFlyoutItem
                                    GroupName="KillMethond"
                                    IconSource="Icons"
                                    Text="Direct" />
                            </ui:FAMenuFlyoutSubItem>
                            <ui:FAMenuFlyoutSubItem Text="{Binding Path=Res.GameAccount_StartProcessWay, Mode=OneWay, Source={x:Static s:ResourceService.Current}}">
                                <ui:FARadioMenuFlyoutItem
                                    GroupName="StartMethond"
                                    IconSource="Games"
                                    Text="Explorer" />
                                <ui:FARadioMenuFlyoutItem
                                    GroupName="Test Group"
                                    IconSource="Icons"
                                    Text="Direct" />
                            </ui:FAMenuFlyoutSubItem>
                            <ui:FAMenuFlyoutSeparator />
                            <ui:FAToggleMenuFlyoutItem IconSource="Safe" Text="{Binding Path=Res.AdministratorStartup, Mode=OneWay, Source={x:Static s:ResourceService.Current}}" />-->
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <AutoCompleteBox
                    Grid.Column="2"
                    Width="280"
                    MaxWidth="320"
                    Margin="12,0,8,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Classes="Search"
                    Text="{Binding SelectedPlatform.SearchText, Mode=TwoWay}" />
            </Grid>
        </ui:FATabView.TabStripFooter>
        <ui:FATabView.Styles>
            <Style Selector="ui|FATabViewItem" x:DataType="spp:PlatformAccount">
                <!--<Setter Property="IconSource">
                    <ui:FAFontIconSource Glyph="{Binding Icon}" />
                </Setter>-->
                <Setter Property="Content" Value="{Binding}" />
                <Setter Property="ContentTemplate">
                    <DataTemplate DataType="spp:PlatformAccount">
                        <spp:AccountItems />
                    </DataTemplate>
                </Setter>
            </Style>
        </ui:FATabView.Styles>
        <ui:FATabView.TabItemTemplate>
            <DataTemplate DataType="spp:PlatformAccount">
                <DockPanel>
                    <PathIcon
                        Data="{Binding Icon, Converter={StaticResource ResourceKeyValueConverter}}"
                        DockPanel.Dock="Left"
                        Height="16"
                        Margin="0,0,8,0"
                        Width="16" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding FullName}" />
                </DockPanel>
            </DataTemplate>
        </ui:FATabView.TabItemTemplate>
    </ui:FATabView>
</spp:PageBase>

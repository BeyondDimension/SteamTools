<UserControl
    x:Class="BD.WTTS.UI.Views.Pages.ScriptStorePage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:spp="https://steampp.net/ui"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:vm="using:BD.WTTS.UI.ViewModels"
    d:DesignHeight="500"
    d:DesignWidth="700"
    x:CompileBindings="True"
    x:DataType="vm:ScriptStorePageViewModel"
    mc:Ignorable="d">
    <UserControl.Styles>
        <Style Selector="Border.store-card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="11,9" />
        </Style>
        <Style Selector="Border.store-card.store-row:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
        </Style>
        <Style Selector="TextBlock.store-caption">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Theme" Value="{StaticResource CaptionTextBlockStyle}" />
        </Style>
        <Style Selector="Border.store-badge">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="7,2" />
        </Style>
        <Style Selector="Border.store-badge.installed">
            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
        </Style>
        <Style Selector="Border.store-badge.installed TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
        </Style>
        <Style Selector="Border.store-badge.update">
            <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
        </Style>
        <Style Selector="Border.store-badge.update TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
        </Style>
        <Style Selector="TabStrip#StoreFilterTabs">
            <Setter Property="(Grid.Column)" Value="1" />
        </Style>
        <ContainerQuery Name="storeToolbar" Query="max-width:560">
            <Style Selector="TabStrip#StoreFilterTabs">
                <Setter Property="(Grid.Row)" Value="1" />
                <Setter Property="(Grid.Column)" Value="0" />
                <Setter Property="(Grid.ColumnSpan)" Value="3" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Margin" Value="0,6,0,0" />
            </Style>
        </ContainerQuery>
    </UserControl.Styles>

    <Grid
        Margin="6,2,6,4"
        RowDefinitions="Auto,*"
        RowSpacing="8">
        <!-- Compact Top Search, Filter, Refresh & External Sources -->
        <Border
            Classes="store-card"
            Container.Name="storeToolbar"
            Container.Sizing="Width"
            Padding="10,8">
            <StackPanel Spacing="6">
                <Grid
                    ColumnDefinitions="*,Auto,Auto"
                    ColumnSpacing="8"
                    RowDefinitions="Auto,Auto">
                    <TextBox
                        PlaceholderText="{x:Static spp:Strings.Script_SearchPlaceholder}"
                        Text="{Binding SearchText, Mode=TwoWay}">
                        <TextBox.KeyBindings>
                            <KeyBinding Command="{Binding RefreshCommand}" Gesture="Enter" />
                        </TextBox.KeyBindings>
                    </TextBox>

                    <TabStrip
                        Name="StoreFilterTabs"
                        VerticalAlignment="Center"
                        Background="{DynamicResource ControlOnImageFillColorDefaultBrush}"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        ItemContainerTheme="{StaticResource TabItemStyle}"
                        SelectedIndex="{Binding SelectedFilterIndex, Mode=TwoWay}"
                        Theme="{StaticResource TabStripStyle}">
                        <TabStripItem Content="{x:Static spp:Strings.Script_Filter_All}" />
                        <TabStripItem Content="{x:Static spp:Strings.Script_Store_Filter_NotInstalled}" />
                        <TabStripItem Content="{x:Static spp:Strings.Script_Store_Filter_Installed}" />
                        <TabStripItem Content="{x:Static spp:Strings.Script_Filter_Updatable}" />
                    </TabStrip>

                    <Button
                        Grid.Column="2"
                        Padding="8,5"
                        VerticalAlignment="Center"
                        Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding !IsLoading}"
                        Theme="{StaticResource TransparentButton}"
                        ToolTip.Tip="{x:Static spp:Strings.Refresh}">
                        <ui:FASymbolIcon FontSize="14" Symbol="Refresh" />
                    </Button>
                </Grid>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        Classes="store-caption"
                        Text="{Binding CountSummary}" />

                    <WrapPanel
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        ItemSpacing="4"
                        LineSpacing="2">
                        <TextBlock
                            Margin="0,0,2,0"
                            VerticalAlignment="Center"
                            Classes="store-caption"
                            Text="{x:Static spp:Strings.Script_GetScriptsFrom}" />
                        <Button
                            Padding="7,3"
                            Command="{Binding OpenBrowserCommand, Source={x:Static spp:App.Instance}}"
                            CommandParameter="https://scriptcat.org/zh-CN"
                            Theme="{StaticResource TransparentButton}"
                            ToolTip.Tip="{x:Static spp:Strings.Script_OpenScriptCatTip}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <ui:FASymbolIcon FontSize="12" Symbol="Open" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Static spp:Strings.Script_Source_ScriptCat}" />
                            </StackPanel>
                        </Button>
                        <Button
                            Padding="7,3"
                            Command="{Binding OpenBrowserCommand, Source={x:Static spp:App.Instance}}"
                            CommandParameter="https://greasyfork.org/"
                            Theme="{StaticResource TransparentButton}"
                            ToolTip.Tip="{x:Static spp:Strings.Script_OpenGreasyForkTip}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <ui:FASymbolIcon FontSize="12" Symbol="Open" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Static spp:Strings.Script_Source_GreasyFork}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Main List / Loading / Error / Empty -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <ProgressBar
                Margin="0,0,0,6"
                IsIndeterminate="True"
                IsVisible="{Binding IsLoading}" />

            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,4,0" Spacing="8">
                    <!-- Error Banner with Retry -->
                    <ui:FAInfoBar
                        IsClosable="False"
                        IsOpen="{Binding HasError}"
                        IsVisible="{Binding HasError}"
                        Message="{Binding ErrorMessage}"
                        Severity="Error">
                        <ui:FAInfoBar.ActionButton>
                            <Button
                                Classes="accent"
                                Command="{Binding RefreshCommand}"
                                Content="{x:Static spp:Strings.Retry}" />
                        </ui:FAInfoBar.ActionButton>
                    </ui:FAInfoBar>

                    <!-- Script Cards -->
                    <ItemsRepeater ItemsSource="{Binding FilteredScripts}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="6" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ScriptStoreItemViewModel">
                                <Border Classes="store-card store-row">
                                    <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="10">
                                        <Border
                                            Width="40"
                                            Height="40"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource LayerFillColorAltBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            ClipToBounds="True"
                                            CornerRadius="8">
                                            <spp:Image2
                                                Margin="5"
                                                FallbackSource="avares://BD.WTTS.Client.Plugins.Accelerator/UI/Assets/script.ico"
                                                RenderOptions.BitmapInterpolationMode="HighQuality"
                                                Source="{Binding IconUrl}"
                                                Stretch="Uniform" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <WrapPanel
                                                VerticalAlignment="Center"
                                                ItemSpacing="6"
                                                LineSpacing="3">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Text="{Binding Name}"
                                                    TextWrapping="Wrap"
                                                    Theme="{StaticResource BodyStrongTextBlockStyle}" />
                                                <Border Classes="store-badge">
                                                    <TextBlock
                                                        Classes="store-caption"
                                                        Text="{Binding VersionDisplay}" />
                                                </Border>
                                                <Border
                                                    Classes="store-badge update"
                                                    IsVisible="{Binding IsUpdate}">
                                                    <TextBlock
                                                        Classes="store-caption"
                                                        Text="{Binding NewVersionBadge}" />
                                                </Border>
                                                <Border
                                                    Classes="store-badge installed"
                                                    IsVisible="{Binding ShowInstalledBadge}">
                                                    <TextBlock
                                                        Classes="store-caption"
                                                        Text="{x:Static spp:Strings.Installed}" />
                                                </Border>
                                            </WrapPanel>

                                            <TextBlock
                                                Classes="store-caption"
                                                IsVisible="{Binding HasDescription}"
                                                MaxLines="2"
                                                Text="{Binding Describe}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap"
                                                ToolTip.Tip="{Binding Describe}" />

                                            <WrapPanel
                                                VerticalAlignment="Center"
                                                ItemSpacing="10"
                                                LineSpacing="2">
                                                <TextBlock Classes="store-caption">
                                                    <Run Text="{x:Static spp:Strings.Script_Inspect_LabelAuthor}" /><Run Text="：" /><Run Text="{Binding AuthorName}" />
                                                </TextBlock>
                                                <TextBlock
                                                    Classes="store-caption"
                                                    IsVisible="{Binding HasMatchSummary}"
                                                    Text="{Binding MatchSummary}"
                                                    ToolTip.Tip="{Binding MatchTooltip}" />
                                            </WrapPanel>
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <Button
                                                Padding="7,5"
                                                Command="{Binding OpenBrowserCommand, Source={x:Static spp:App.Instance}}"
                                                CommandParameter="{Binding SourceLink}"
                                                IsVisible="{Binding HasSourceLink}"
                                                Theme="{StaticResource TransparentButton}"
                                                ToolTip.Tip="{x:Static spp:Strings.Script_OpenHomepage}">
                                                <ui:FASymbolIcon FontSize="13" Symbol="Open" />
                                            </Button>

                                            <ui:FAProgressRing
                                                Width="20"
                                                Height="20"
                                                IsActive="{Binding IsDownloading}"
                                                IsVisible="{Binding IsDownloading}" />

                                            <Button
                                                Padding="10,4"
                                                Classes="accent"
                                                Command="{Binding $parent[UserControl].((vm:ScriptStorePageViewModel)DataContext).DownloadScriptItemCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding ShowGetButton}">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <ui:FASymbolIcon FontSize="13" Symbol="Download" />
                                                    <TextBlock VerticalAlignment="Center" Text="{x:Static spp:Strings.L10nAccel_072}" />
                                                </StackPanel>
                                            </Button>

                                            <Button
                                                Padding="10,4"
                                                Classes="accent"
                                                Command="{Binding $parent[UserControl].((vm:ScriptStorePageViewModel)DataContext).DownloadScriptItemCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding ShowUpdateButton}"
                                                ToolTip.Tip="{Binding UpdateButtonTooltip}">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <ui:FASymbolIcon FontSize="13" Symbol="Download" />
                                                    <TextBlock VerticalAlignment="Center" Text="{x:Static spp:Strings.L10nAccel_073}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <!-- Empty State -->
                    <Border
                        Classes="store-card"
                        IsVisible="{Binding ShowEmptyState}"
                        Padding="20">
                        <StackPanel HorizontalAlignment="Center" Spacing="6">
                            <TextBlock
                                HorizontalAlignment="Center"
                                Text="{x:Static spp:Strings.CommunityFix_ItemsEmpty}"
                                Theme="{StaticResource BodyStrongTextBlockStyle}" />
                            <Button
                                Margin="0,2,0,0"
                                HorizontalAlignment="Center"
                                Command="{Binding ClearFilterCommand}"
                                Content="{x:Static spp:Strings.Script_ClearFilter}"
                                IsVisible="{Binding HasActiveFilter}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

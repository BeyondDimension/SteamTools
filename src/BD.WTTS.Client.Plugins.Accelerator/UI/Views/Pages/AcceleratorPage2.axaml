<spp:PageBase
	x:Class="BD.WTTS.UI.Views.Pages.AcceleratorPage2"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:enum="using:BD.WTTS.Enums"
	xmlns:i="using:Avalonia.Xaml.Interactivity"
	xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
	xmlns:ir="using:Avalonia.Xaml.Interactions.Responsive"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:ms="https://steampp.net/settings"
	xmlns:s="https://steampp.net/services"
	xmlns:spp="https://steampp.net/ui"
	xmlns:sys="using:System"
	xmlns:ui="using:FluentAvalonia.UI.Controls"
	Title="{x:Static spp:Strings.CommunityFix}"
	d:DesignHeight="650"
	d:DesignWidth="800"
	x:CompileBindings="True"
	x:DataType="spp:AcceleratorPageViewModel"
	Description="{x:Static spp:Strings.L10nAccel_076}"
	OpenPaneLength="335"
	ScrollViewer.VerticalScrollBarVisibility="Disabled"
	Subtitle="{Binding Author, Source={x:Static s:Plugin.Instance}, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter=Plugin_Author}"
	mc:Ignorable="d">
	<spp:PageBase.Styles>
		<Style Selector="Button.operationBusy">
			<Setter Property="Opacity" Value="0" />
		</Style>
		<Style Selector="StackPanel.compact TextBlock.headerActionLabel">
			<Setter Property="IsVisible" Value="False" />
		</Style>
	</spp:PageBase.Styles>
	<spp:PageBase.PreviewImage>
		<ui:FAImageIconSource
			Source="{Binding Icon, Source={x:Static s:Plugin.Instance}, Mode=OneWay, Converter={StaticResource BitmapAssetValueConverter}}" />
	</spp:PageBase.PreviewImage>
	<spp:PageBase.ActionContent>
		<StackPanel Orientation="Horizontal" Spacing="2">
			<i:Interaction.Behaviors>
				<spp:AdaptiveBehavior SourceControl="{Binding $parent[TopLevel]}">
					<ir:AdaptiveClassSetter MinWidth="0" MaxWidth="700" ClassName="compact" />
				</spp:AdaptiveBehavior>
			</i:Interaction.Behaviors>
			<Grid>
				<Button
					x:Name="ToggleAccelerationButton"
					MinHeight="40"
					MinWidth="160"
					HorizontalContentAlignment="Center"
					Padding="14,7"
					Classes.accent="{Binding Source={x:Static s:ProxyService.Current}, Path=!ProxyStatus, Mode=OneWay}"
					Classes.operationBusy="{Binding Source={x:Static s:ProxyService.Current}, Path=ProxyStarting, Mode=OneWay}"
					Command="{Binding StartProxyCommand}"
					IsEnabled="{Binding Source={x:Static s:ProxyService.Current}, Path=!ProxyStarting, Mode=OneWay}"
					IsHitTestVisible="{Binding Source={x:Static s:ProxyService.Current}, Path=!ProxyStarting, Mode=OneWay}">
					<Grid>
						<StackPanel Orientation="Horizontal" Spacing="9"
						            IsVisible="{Binding Source={x:Static s:ProxyService.Current}, Path=!ProxyStatus, Mode=OneWay}">
							<Viewbox Width="17" Height="17">
								<ui:FAFontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="{StaticResource SpeedHigh}" />
							</Viewbox>
							<TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
							           Text="{x:Static spp:Strings.CommunityFix_StartProxy}" />
						</StackPanel>
						<StackPanel Orientation="Horizontal" Spacing="9"
						            IsVisible="{Binding Source={x:Static s:ProxyService.Current}, Path=ProxyStatus, Mode=OneWay}">
							<Viewbox Width="16" Height="16">
								<ui:FASymbolIcon Symbol="StopFilled" />
							</Viewbox>
							<TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
							           Text="{x:Static spp:Strings.CommunityFix_StopProxy}" />
							<Border Padding="6,2" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4">
								<TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
								           Text="{Binding Source={x:Static s:ProxyService.Current}, Path=AccelerateTime, Mode=OneWay, Converter={StaticResource StringFormatConverter}}" />
							</Border>
						</StackPanel>
					</Grid>
				</Button>
				<Border
					x:Name="ProxyOperationIndicator"
					MinHeight="40"
					Padding="12,7"
					Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
					BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
					BorderThickness="1"
					CornerRadius="8"
					IsVisible="{Binding Source={x:Static s:ProxyService.Current}, Path=ProxyStarting, Mode=OneWay}">
					<StackPanel Orientation="Horizontal" Spacing="9">
						<ProgressBar
							Width="18"
							Height="18"
							Classes="Circle"
							Foreground="{DynamicResource AccentFillColorDefaultBrush}"
							IsIndeterminate="{Binding Source={x:Static s:ProxyService.Current}, Path=ProxyStarting, Mode=OneWay}" />
						<TextBlock
							VerticalAlignment="Center"
							FontWeight="SemiBold"
							IsVisible="{Binding Source={x:Static s:ProxyService.Current}, Path=!ProxyStopping, Mode=OneWay}"
							Text="{x:Static spp:Strings.CommunityFix_Starting}" />
						<TextBlock
							VerticalAlignment="Center"
							FontWeight="SemiBold"
							IsVisible="{Binding Source={x:Static s:ProxyService.Current}, Path=ProxyStopping, Mode=OneWay}"
							Text="{x:Static spp:Strings.CommunityFix_Stopping}" />
					</StackPanel>
				</Border>
			</Grid>

			<Separator
				Height="18"
				Margin="5,0"
				VerticalAlignment="Center"
				Background="{DynamicResource ButtonBorderBrush}"
				Classes="Vertical"
				DockPanel.Dock="Right"
				IsHitTestVisible="False" />

			<Button
				Padding="8,4"
				Command="{Binding RefreshCommand}"
				DockPanel.Dock="Right"
				AutomationProperties.Name="{x:Static spp:Strings.Refresh}"
				ToolTip.Tip="{x:Static spp:Strings.Refresh}"
				Theme="{StaticResource TransparentButton}">
				<Panel>
					<Viewbox
						Width="16"
						Height="16"
						HorizontalAlignment="Left">
						<ui:FASymbolIcon Symbol="Refresh" />
					</Viewbox>
					<TextBlock
						Margin="28,4,0,4"
						HorizontalAlignment="Left"
						VerticalAlignment="Center"
						Classes="headerActionLabel"
						Text="{x:Static spp:Strings.Refresh}" />
				</Panel>
			</Button>

			<ToggleButton
				Padding="8,4"
				DockPanel.Dock="Right"
				IsChecked="{Binding $parent[spp:PageBase].IsPaneOpen, Mode=TwoWay}"
				AutomationProperties.Name="{x:Static spp:Strings.CommunityFix_MenuName}"
				ToolTip.Tip="{x:Static spp:Strings.CommunityFix_MenuName}"
				Theme="{StaticResource TransparentToggleButton}">
				<Panel>
					<Viewbox
						Width="16"
						Height="16"
						HorizontalAlignment="Left">
						<ui:FASymbolIcon Symbol="Settings" />
					</Viewbox>
					<TextBlock
						Margin="28,4,0,4"
						HorizontalAlignment="Left"
						VerticalAlignment="Center"
						Classes="headerActionLabel"
						Text="{x:Static spp:Strings.CommunityFix_MenuName}" />
				</Panel>
			</ToggleButton>

			<DropDownButton
				Padding="8"
				HorizontalContentAlignment="Center"
				VerticalContentAlignment="Center"
				Content="{StaticResource More}"
				FontFamily="{StaticResource SymbolThemeFontFamily}"
				FontSize="20"
				Theme="{StaticResource TransparentButton}">
				<DropDownButton.Flyout>
					<ui:FAMenuFlyout Placement="BottomEdgeAlignedRight">
						<!--<ui:FAMenuFlyoutSubItem ItemsSource="{Binding Source={x:Static ms:ProxySettings.ProxyModes}, Path=., Mode=OneWay}" Text="加速模式">
                            <ui:FAMenuFlyoutSubItem.ItemTemplate>
                                <DataTemplate>
                                    <ui:FARadioMenuFlyoutItem GroupName="ProxyMode" Text="{Binding}" />
                                </DataTemplate>
                            </ui:FAMenuFlyoutSubItem.ItemTemplate>
                        </ui:FAMenuFlyoutSubItem>-->
						<!--<ui:FAMenuFlyoutItem Text="{x:Static spp:Strings.Settings_Plugin}" />-->
						<!--<ui:FAMenuFlyoutSeparator />-->
						<!--<ui:FAMenuFlyoutItem Text="安装证书" />
                        <ui:FAMenuFlyoutItem Text="移除证书" />
                        <ui:FAMenuFlyoutItem Text="打开证书文件夹" />
                        <ui:FAMenuFlyoutSeparator />
                        <ui:FAMenuFlyoutItem Text="编辑 hosts 文件" />
                        <ui:FAMenuFlyoutItem Text="重置 hosts 文件" />
                        <ui:FAMenuFlyoutItem Text="打开 hosts 文件夹" />
                        <ui:FAMenuFlyoutSeparator />-->
						<ui:FAMenuFlyoutItem IsEnabled="False">
							<ui:FAMenuFlyoutItem.Text>
								<MultiBinding StringFormat="{}{0}{1}">
									<CompiledBindingExtension
										Mode="OneWay"
										Path="."
										Source="{x:Static spp:Strings.Plugin_Version}" />
									<CompiledBindingExtension
										Mode="OneWay"
										Path="Version"
										Source="{x:Static s:Plugin.Instance}" />
								</MultiBinding>
							</ui:FAMenuFlyoutItem.Text>
						</ui:FAMenuFlyoutItem>
						<!--<ui:FAMenuFlyoutItem Text="{x:Static spp:Strings.ViewInStore}" />
                        <ui:FAMenuFlyoutItem Text="{x:Static spp:Strings.UseHelp}" />
                        <ui:FAMenuFlyoutItem Text="{x:Static spp:Strings.AboutThisPlugin}" />-->
					</ui:FAMenuFlyout>
				</DropDownButton.Flyout>
			</DropDownButton>
		</StackPanel>
	</spp:PageBase.ActionContent>
	<spp:PageBase.PaneContent>
		<StackPanel Margin="15,20" Spacing="10">
			<TextBlock Text="{x:Static spp:Strings.CommunityFix_ProxyMode}" Theme="{StaticResource BodyStrongTextBlockStyle}" />

			<TabStrip
				Name="ProxyModeTab"
				Background="{DynamicResource ControlOnImageFillColorDefaultBrush}"
				CornerRadius="{StaticResource ControlCornerRadius}"
				ItemContainerTheme="{StaticResource TabItemStyle}"
				ItemsSource="{Binding Source={x:Static ms:ProxySettings.ProxyModes}, Path=., Mode=OneWay}"
				SelectedItem="{Binding Source={x:Static ms:ProxySettings.ProxyMode}, Path=Value, Mode=TwoWay}"
				Theme="{StaticResource TabStripStyle}">
				<TabStrip.IsEnabled>
					<MultiBinding Converter="{x:Static BoolConverters.And}">
						<CompiledBindingExtension Source="{x:Static s:ProxyService.Current}" Path="!ProxyStatus" />
						<CompiledBindingExtension Source="{x:Static s:ProxyService.Current}" Path="!ProxyStarting" />
					</MultiBinding>
				</TabStrip.IsEnabled>
				<TabStrip.ItemTemplate>
					<DataTemplate DataType="spp:ProxyMode">
						<TextBlock Text="{Binding}" />
					</DataTemplate>
				</TabStrip.ItemTemplate>
			</TabStrip>

			<TextBlock Text="{x:Static spp:Strings.CommunityFix_MenuName}" Theme="{StaticResource BodyStrongTextBlockStyle}" />

			<ToggleSwitch
				VerticalAlignment="Center"
				Classes="NoContent"
				IsChecked="{Binding Source={x:Static s:ProxyService.Current}, Path=IsEnableScript, Mode=TwoWay}"
				OffContent="{x:Static spp:Strings.CommunityFix_EnableScriptService}"
				OnContent="{x:Static spp:Strings.CommunityFix_EnableScriptService}" />

			<ToggleSwitch
				VerticalAlignment="Center"
				Classes="NoContent"
				IsChecked="{Binding Source={x:Static ms:ProxySettings.ProgramStartupRunProxy}, Path=Value, Mode=TwoWay}"
				OffContent="{x:Static spp:Strings.CommunityFix_AutoRunProxy}"
				OnContent="{x:Static spp:Strings.CommunityFix_AutoRunProxy}" />

			<!--<StackPanel Orientation="Horizontal" Spacing="4">
                <ToggleButton
                    Padding="8"
                    Theme="{StaticResource TransparentToggleButton}"
                    ToolTip.Tip="{x:Static spp:Strings.GameList_OnlyInstalled}">
                    <Viewbox Width="20" Height="20">
                        <ui:FASymbolIcon Symbol="Play" />
                    </Viewbox>
                </ToggleButton>

                <ToggleButton
                    Padding="8"
                    Theme="{StaticResource TransparentToggleButton}"
                    ToolTip.Tip="{x:Static spp:Strings.GameList_OnlyCloudArchive}">
                    <Viewbox Width="20" Height="20">
                        <ui:FASymbolIcon Symbol="CloudSyncComplete" />
                    </Viewbox>
                </ToggleButton>
            </StackPanel>-->

			<Button
				HorizontalAlignment="Stretch"
				Command="{Binding ProxySettingsCommand}"
				Content="{x:Static spp:Strings.CommunityFix_ProxySettings}" />

			<Separator Margin="0,8" Classes="Horizontal" />

			<ItemsControl>
				<ItemsControl.Items>
					<Button
						HorizontalAlignment="Stretch"
						Command="{Binding SetupCertificateCommand}"
						Content="{x:Static spp:Strings.CommunityFix_SetupCertificate}" />
					<Button
						HorizontalAlignment="Stretch"
						Command="{Binding DeleteCertificateCommand}"
						Content="{x:Static spp:Strings.CommunityFix_DeleteCertificate}" />
					<Button
						HorizontalAlignment="Stretch"
						Command="{Binding ShowCertificateCommand}"
						Content="{x:Static spp:Strings.L10nAccel_049}" />
					<Button
						HorizontalAlignment="Stretch"
						Command="{Binding OpenCertificateDirCommand}"
						Content="{x:Static spp:Strings.CommunityFix_OpenCertificateDir}" />
				</ItemsControl.Items>
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<spp:FixedWrapPanel ItemsPerLine="2" Spacing="5" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
			</ItemsControl>

			<Separator Margin="0,8" Classes="Horizontal" />

			<ItemsControl>
				<ItemsControl.Items>
					<Button
						HorizontalAlignment="Stretch"
						Command="{Binding EditHostsFileCommand}"
						Content="{x:Static spp:Strings.CommunityFix_EditHostsFile}" />
					<Button
						HorizontalAlignment="Stretch"
						Command="{Binding ResetHostsFileCommand}"
						Content="{x:Static spp:Strings.CommunityFix_ResetHostsFile}" />
					<Button
						HorizontalAlignment="Stretch"
						Command="{Binding OpenHostsDirCommand}"
						Content="{x:Static spp:Strings.CommunityFix_OpenHostsDir}" />
					<Button
						HorizontalAlignment="Stretch"
						Command="{Binding OpenLogFileCommand}"
						Content="{x:Static spp:Strings.L10nAccel_050}" />
				</ItemsControl.Items>
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<spp:FixedWrapPanel ItemsPerLine="2" Spacing="5" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
			</ItemsControl>

			<!--<ui:FAComboBox ItemsSource="{Binding Source={x:Static ms:ProxySettings.ProxyModes}, Path=., Mode=OneWay}" SelectedItem="{Binding Source={x:Static ms:ProxySettings.ProxyMode}, Path=Value, Mode=TwoWay}">
                <ui:FAComboBox.ItemTemplate>
                    <DataTemplate DataType="spp:ProxyMode">
                        <TextBlock Text="{Binding}" />
                    </DataTemplate>
                </ui:FAComboBox.ItemTemplate>
            </ui:FAComboBox>-->

			<StackPanel IsVisible="{x:Static spp:XunYouSDK.IsSupported}}" Spacing="10">
				<Separator Margin="0,8" Classes="Horizontal" />

				<TextBlock Text="{x:Static spp:Strings.L10nAccel_051}" Theme="{StaticResource BodyStrongTextBlockStyle}" />

				<ToggleSwitch
					VerticalAlignment="Center"
					Classes="NoContent"
					IsChecked="{Binding Source={x:Static ms:ProxySettings.AutoShowWattAcceleratorWindow}, Path=Value, Mode=TwoWay}"
					OffContent="{x:Static spp:Strings.GameAccelerator_SetShowWattWindow}"
					OnContent="{x:Static spp:Strings.GameAccelerator_SetShowWattWindow}" />

				<!--<TextBlock Text="{x:Static spp:Strings.GameAccelerator_WattAcceleratorInstallPath}" Theme="{StaticResource BodyStrongTextBlockStyle}" />

            <ui:FASettingsExpander Description="{Binding Source={x:Static ms:GameAcceleratorSettings.WattAcceleratorDirPath}, Path=Value, Mode=OneWay}}" IsExpanded="True">
                <ui:FASettingsExpander.IconSource>
                    <ui:FAFontIconSource FontFamily="Segoe Fluent Icons" Glyph="&#xE756;" />
                </ui:FASettingsExpander.IconSource>
                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="5">
                    <Button Content="打开文件夹" />
                    <Button Content="选择路径" />
                </StackPanel>
            </ui:FASettingsExpander>-->

				<!--<ItemsControl>
                    <ItemsControl.Items>
					</ItemsControl.Items>
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<spp:FixedWrapPanel ItemsPerLine="2" Spacing="5" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
				</ItemsControl>-->

				<Button
					HorizontalAlignment="Stretch"
					Command="{Binding ShowXunYouWindow, Source={x:Static s:GameAcceleratorService.Current}}"
					Content="{x:Static spp:Strings.GameAccelerator_ShowWattAccelerator}">
					<Button.CommandParameter>
						<x:Boolean>True</x:Boolean>
					</Button.CommandParameter>
				</Button>
				<Button
					HorizontalAlignment="Stretch"
					Command="{Binding InstallAcceleratorCommand, Source={x:Static s:GameAcceleratorService.Current}}"
					Content="{x:Static spp:Strings.GameAccelerator_InstallWattAccelerator}" />
				<Button
					HorizontalAlignment="Stretch"
					Command="{Binding UninstallAcceleratorCommand, Source={x:Static s:GameAcceleratorService.Current}}"
					Content="{x:Static spp:Strings.GameAccelerator_UninstallWattAccelerator}" />

			</StackPanel>
		</StackPanel>
	</spp:PageBase.PaneContent>
	<Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,*">
		<Grid.Resources>
			<sys:Double x:Key="AdaptiveWidth">900</sys:Double>
		</Grid.Resources>
		<Grid.Styles>
			<Style Selector="StackPanel.small">
				<Setter Property="Grid.Row" Value="1" />
				<Setter Property="HorizontalAlignment" Value="Center" />
			</Style>
			<Style Selector="StackPanel.wide">
				<Setter Property="Grid.Row" Value="0" />
				<Setter Property="HorizontalAlignment" Value="Right" />
			</Style>

			<Style Selector="TabStrip.small">
				<Setter Property="Grid.ColumnSpan" Value="2" />
				<Setter Property="HorizontalAlignment" Value="Center" />
			</Style>
			<Style Selector="TabStrip.wide">
				<Setter Property="HorizontalAlignment" Value="Left" />
			</Style>
		</Grid.Styles>
		<TabStrip
			x:Name="AcceleratorTabs"
			VerticalAlignment="Top"
			ItemContainerTheme="{StaticResource TabItemStyle}"
			Theme="{StaticResource TabStripStyle}">
			<i:Interaction.Behaviors>
				<spp:AdaptiveBehavior SourceControl="{Binding $parent[TopLevel]}">
					<ir:AdaptiveClassSetter
						MinWidth="0"
						MaxWidth="{StaticResource AdaptiveWidth}"
						ClassName="small" />
					<ir:AdaptiveClassSetter
						MinWidth="{StaticResource AdaptiveWidth}"
						MaxWidth="Infinity"
						ClassName="wide" />
				</spp:AdaptiveBehavior>
			</i:Interaction.Behaviors>
			<TabStripItem Content="{x:Static spp:Strings.L10nAccel_052}"
			              IsVisible="{Binding Source={x:Static s:ProxyService.Current}, Path=!ProxyStatus, Mode=OneWay}">
				<!--<WrapPanel>-->
				<TextBlock Text="{x:Static spp:Strings.L10nAccel_052}" />
				<!--<Border
                        Margin="5,0,0,0"
                        Padding="5,1"
                        VerticalAlignment="Center"
                        CornerRadius="2">
						<Border.Background>
							<LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
								<GradientStop Offset="0.0" Color="#48C6EF" />
								<GradientStop Offset="1.0" Color="#6F86D6" />
							</LinearGradientBrush>
						</Border.Background>
						<TextBlock
                            VerticalAlignment="Center"
                            FontSize="10"
                            Foreground="White"
                            Text="免费" />
                    </Border>
                </WrapPanel>-->
			</TabStripItem>
			<TabStripItem Content="{x:Static spp:Strings.CommunityFix_Services}"
			              IsVisible="{Binding Source={x:Static s:ProxyService.Current}, Path=ProxyStatus, Mode=OneWay}" />
			<TabStripItem Content="{x:Static spp:Strings.L10nAccel_053}"
			              IsVisible="{Binding Source={x:Static s:ProxyService.Current}, Path=IsAnyProxyScripts, Mode=OneWay}" />
			<TabStripItem Content="{x:Static spp:Strings.CommunityFix_ProxyLog}"
			              IsVisible="{Binding Source={x:Static s:ProxyService.Current}, Path=ProxyStatus, Mode=OneWay}" />
			<TabStripItem Content="{x:Static spp:Strings.CommunityFix_FlowStatistics}"
			              IsVisible="{Binding Source={x:Static s:ProxyService.Current}, Path=ProxyStatus, Mode=OneWay}" />
			<TabStripItem Name="GameAccTab">
				<!--<WrapPanel>-->
				<TextBlock Text="{x:Static spp:Strings.L10nAccel_054}" />
				<!--<Border
                        Margin="5,0,0,0"
                        Padding="5,1"
                        VerticalAlignment="Center"
                        CornerRadius="2">
						<Border.Background>
							<LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
								<GradientStop Offset="0.0" Color="#EEAD92" />
								<GradientStop Offset="1.0" Color="#6018DC" />
							</LinearGradientBrush>
						</Border.Background>
						<TextBlock
                            VerticalAlignment="Center"
                            FontSize="10"
                            Foreground="White"
                            Text="收费" />
                    </Border>-->
				<!--</WrapPanel>-->
			</TabStripItem>
			<TabStripItem Content="{x:Static spp:Strings.L10nAccel_055}" IsVisible="True" />
			<TabStripItem Content="dummy_tab_for_transisit_animation" IsVisible="False" />
		</TabStrip>
		<Carousel
			Grid.Row="2"
			Margin="0,10,0,0"
			Classes="AnimeSlide"
			SelectedIndex="{Binding #AcceleratorTabs.SelectedIndex}">

			<!--  平台加速  -->
			<ScrollViewer
				Padding="0,0,10,0"
				HorizontalScrollBarVisibility="Disabled"
				VerticalScrollBarVisibility="Auto">
				<spp:ContentLoader
					IsLoading="{Binding Source={x:Static s:ProxyService.Current}, Path=IsLoadingAccelerate, Mode=OneWay}"
					IsShowNoResultText="{Binding Source={x:Static s:ProxyService.Current}, Path=!ProxyDomainsList.Count, Mode=OneWay}"
					NoResultMessage="{x:Static spp:Strings.CommunityFix_ItemsEmpty}">
					<ItemsControl ItemsSource="{Binding Source={x:Static s:ProxyService.Current}, Path=ProxyDomainsList, Mode=OneWay}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Orientation="Vertical" Spacing="{StaticResource SettingsSpacing}" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>

						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="spp:AccelerateProjectGroupDTO">
								<Border>
									<!--<ui:FASettingsExpander ItemsSource="{Binding Items}">-->
									<ui:FASettingsExpander IsClickEnabled="False">
										<ui:FASettingsExpander.Header>
											<StackPanel Orientation="Horizontal" Spacing="10">
												<CheckBox IsChecked="{Binding ThreeStateEnable, Mode=TwoWay}" />
												<spp:Image2
													Width="30"
													Height="30"
													VerticalAlignment="Center"
													RenderOptions.BitmapInterpolationMode="HighQuality"
													Source="{Binding IconUrl}"
													Stretch="UniformToFill" />
												<TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
											</StackPanel>
										</ui:FASettingsExpander.Header>
										<ui:FASettingsExpanderItem Theme="{StaticResource SettingsExpanderItem2}">
											<TreeView ItemsSource="{Binding ObservableItems}" SelectionMode="Single">
												<TreeView.ItemTemplate>
													<TreeDataTemplate DataType="spp:AccelerateProjectDTO" ItemsSource="{Binding ObservableItems}">
														<DockPanel Margin="8,0">
															<CheckBox
																HorizontalAlignment="Left"
																DockPanel.Dock="Left"
																IsChecked="{Binding ThreeStateEnable, Mode=TwoWay}">
																<StackPanel Orientation="Horizontal" Spacing="8">
																	<TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
																	<Border
																		Padding="5,0"
																		CornerRadius="5"
																		IsVisible="{Binding ProxyType, Converter={StaticResource EnumEqualValueConverter}, ConverterParameter={x:Static enum:ProxyType.ServerAccelerate}}"
																		ToolTip.Tip="{x:Static spp:Strings.L10nAccel_047}">
																		<Border.Background>
																			<LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
																				<GradientStop Offset="0.0" Color="#43cbff" />
																				<GradientStop Offset="1.0" Color="#9708cc" />
																			</LinearGradientBrush>
																		</Border.Background>
																		<TextBlock
																			VerticalAlignment="Center"
																			FontSize="10"
																			Text="Beta" />
																	</Border>
																</StackPanel>
															</CheckBox>
															<TextBlock
																HorizontalAlignment="Right"
																VerticalAlignment="Center"
																DockPanel.Dock="Right"
																Text="{Binding DomainNamesArray[0]}" />
														</DockPanel>
													</TreeDataTemplate>
												</TreeView.ItemTemplate>
											</TreeView>
										</ui:FASettingsExpanderItem>
									</ui:FASettingsExpander>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</spp:ContentLoader>
			</ScrollViewer>

			<!--  加速服务  -->
			<spp:AcceleratorServiceStatus />

			<!--  加速脚本  -->
			<spp:ProxyServiceStatus />

			<!--  加速日志  -->
			<spp:ProxyLog Margin="5,0" />

			<!--  流量统计  -->
			<spp:ProxyChartView Margin="5,0" />

			<!--  游戏加速  -->
			<Panel x:DataType="spp:GameAcceleratorPageViewModel">
				<Panel.DataContext>
					<spp:GameAcceleratorPageViewModel />
				</Panel.DataContext>
				<spp:ContentLoader
					IsLoading="{Binding Source={x:Static s:GameAcceleratorService.Current}, Path=IsLoadingGames, Mode=OneWay}"
					IsShowNoResultText="{Binding !!!Games.Count}"
					IsVisible="{Binding Source={x:Static s:GameAcceleratorService.Current}, Path=!CurrentAcceleratorGame.IsAccelerated}"
					NoResultMessage="{x:Static spp:Strings.GameAccelerator_GamesEmptyTip}}">
					<ScrollViewer
						Name="GameScrollViewer"
						Padding="0,0,10,0"
						HorizontalScrollBarVisibility="Disabled"
						IsVisible="{Binding !!Games.Count}"
						VerticalScrollBarVisibility="Auto">
						<StackPanel>
							<ItemsRepeater
								HorizontalCacheLength="0"
								ItemsSource="{Binding Games}"
								VerticalCacheLength="1">
								<ItemsRepeater.Layout>
									<UniformGridLayout
										ItemsJustification="Start"
										ItemsStretch="Uniform"
										MinColumnSpacing="10"
										MinItemHeight="240"
										MinItemWidth="200"
										MinRowSpacing="10" />
								</ItemsRepeater.Layout>
								<ItemsRepeater.ItemTemplate>
									<DataTemplate DataType="spp:XunYouGameViewModel">
										<spp:GameAppItem
											ButtonCommand="{Binding GameAcceleratorCommand, Source={x:Static s:GameAcceleratorService.Current}}" />
									</DataTemplate>
								</ItemsRepeater.ItemTemplate>
							</ItemsRepeater>

							<StackPanel
								Margin="0,30"
								HorizontalAlignment="Center"
								Spacing="10">
								<spp:Image2
									Width="100"
									Height="100"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									RenderOptions.BitmapInterpolationMode="HighQuality"
									Source="avares://BD.WTTS.Client.Avalonia/UI/Assets/Icons/empty.png"
									Stretch="UniformToFill" />
								<TextBlock
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Text="{x:Static spp:Strings.L10nAccel_056}" />
							</StackPanel>
						</StackPanel>
					</ScrollViewer>
				</spp:ContentLoader>
				<spp:GameDetail
					Margin="0,0,10,0"
					Content="{Binding Source={x:Static s:GameAcceleratorService.Current}, Path=CurrentAcceleratorGame}"
					IsVisible="{Binding Source={x:Static s:GameAcceleratorService.Current}, Path=CurrentAcceleratorGame.IsAccelerated}" />
			</Panel>

			<!--  网络检测  -->
			<spp:NetworkCheck DataContext="{Binding NetworkCheckControlViewModel}" />

			<TabItem Content="dummy_tab_for_transisit_animation" />
		</Carousel>

		<!--  Side tab of paid game spped up  -->
		<StackPanel
			Grid.ColumnSpan="2"
			IsVisible="{Binding #GameAccTab.IsSelected}"
			Orientation="Horizontal"
			Spacing="5">

			<i:Interaction.Behaviors>
				<spp:AdaptiveBehavior SourceControl="{Binding $parent[TopLevel]}">
					<ir:AdaptiveClassSetter
						MinWidth="0"
						MaxWidth="{StaticResource AdaptiveWidth}"
						ClassName="small" />
					<ir:AdaptiveClassSetter
						MinWidth="{StaticResource AdaptiveWidth}"
						MaxWidth="Infinity"
						ClassName="wide" />
				</spp:AdaptiveBehavior>
			</i:Interaction.Behaviors>
			<Border
				Padding="5,1"
				VerticalAlignment="Center"
				CornerRadius="2"
				IsVisible="{Binding Source={x:Static s:GameAcceleratorService.Current}, Path=VipEndTimeString, Converter={StaticResource IsNullConverter}, ConverterParameter=invert}">
				<Border.Background>
					<LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
						<GradientStop Offset="0.0" Color="#453a94" />
						<GradientStop Offset="1.0" Color="#f43b47" />
					</LinearGradientBrush>
				</Border.Background>
				<TextBlock
					VerticalAlignment="Center"
					FontSize="12"
					Foreground="White"
					Text="{Binding Source={x:Static s:GameAcceleratorService.Current}, Path=VipEndTimeString}" />
			</Border>
			<Button
				Command="{Binding OpenBrowserCommand, Source={x:Static spp:App.Instance}}"
				CommandParameter="https://steampp.net/customer/service"
				Cursor="Hand"
				Theme="{StaticResource TransparentButton}"
				ToolTip.Tip="{x:Static spp:Strings.L10nAccel_057}">
				<ui:FAFontIcon FontSize="22" Glyph="&#xE95B;" />
			</Button>
			<AutoCompleteBox
				Name="SearchGameBox"
				Width="240"
				VerticalAlignment="Center"
				Classes="Search"
				FilterMode="ContainsOrdinal"
				ItemsSource="{Binding Source={x:Static s:GameAcceleratorService.Current}, Path=AllGames}"
				MaxDropDownHeight="300"
				ValueMemberBinding="{Binding Name, x:DataType=spp:XunYouGame}"
				PlaceholderText="{x:Static spp:Strings.GameAccelerator_SearchGame}">
				<AutoCompleteBox.ItemTemplate>
					<DataTemplate DataType="spp:XunYouGame">
						<WrapPanel>
							<spp:Image2
								Width="20"
								Height="20"
								Margin="0,0,5,0"
								HorizontalAlignment="Left"
								VerticalAlignment="Center"
								DecodeWidth="20"
								Source="{Binding IconUrl}">
								<spp:Image2.Transitions>
									<Transitions>
										<DoubleTransition
											Easing="0,0 0,1"
											Property="Width"
											Duration="00:00:00.25" />
										<DoubleTransition
											Easing="0,0 0,1"
											Property="Height"
											Duration="00:00:00.25" />
									</Transitions>
								</spp:Image2.Transitions>
							</spp:Image2>
							<TextBlock
								VerticalAlignment="Center"
								MaxLines="2"
								Text="{Binding Name}"
								TextTrimming="CharacterEllipsis"
								TextWrapping="WrapWithOverflow" />
						</WrapPanel>
					</DataTemplate>
				</AutoCompleteBox.ItemTemplate>
			</AutoCompleteBox>
		</StackPanel>

		<!--  Side tab after speed up  -->
		<StackPanel
			Grid.ColumnSpan="2"
			VerticalAlignment="Center"
			IsVisible="{Binding Source={x:Static s:ProxyService.Current}, Path=ProxyStatus, Mode=OneWay}"
			Orientation="Horizontal"
			Spacing="8">

			<i:Interaction.Behaviors>
				<spp:AdaptiveBehavior SourceControl="{Binding $parent[TopLevel]}">
					<ir:AdaptiveClassSetter
						MinWidth="0"
						MaxWidth="{StaticResource AdaptiveWidth}"
						ClassName="small" />
					<ir:AdaptiveClassSetter
						MinWidth="{StaticResource AdaptiveWidth}"
						MaxWidth="Infinity"
						ClassName="wide" />
				</spp:AdaptiveBehavior>
			</i:Interaction.Behaviors>
			<StackPanel.IsVisible>
				<MultiBinding Converter="{x:Static BoolConverters.And}">
					<CompiledBindingExtension
						Mode="OneWay"
						Path="ProxyStatus"
						Source="{x:Static s:ProxyService.Current}" />
					<Binding Path="!#GameAccTab.IsSelected" />
				</MultiBinding>
			</StackPanel.IsVisible>
			<StackPanel.Styles>
				<Style Selector="TextBlock">
					<Setter Property="VerticalAlignment" Value="Center" />
				</Style>
			</StackPanel.Styles>
			<Button Theme="{StaticResource TransparentButton}" ToolTip.ShowDelay="0">
				<ToolTip.Tip>
					<TextBlock>
						<Run FontSize="16" Text="{x:Static spp:Strings.L10nAccel_058}" />
						<LineBreak />
						<Run
							Text="{x:Static spp:Strings.L10nAccel_059}" />
						<LineBreak />
						<LineBreak />
						<Run FontSize="16" Text="{x:Static spp:Strings.L10nAccel_060}" />
						<LineBreak />
						<Run Text="{x:Static spp:Strings.L10nAccel_061}" />
						<LineBreak />
						<LineBreak />
						<Run FontSize="16" Text="{x:Static spp:Strings.L10nAccel_062}" />
						<LineBreak />
						<Run
							Text="{x:Static spp:Strings.L10nAccel_063}" />
					</TextBlock>
				</ToolTip.Tip>
				<StackPanel Orientation="Horizontal" Spacing="5">
					<ui:FAFontIcon FontSize="20" Glyph="&#xE82F;" />
					<TextBlock Text="{x:Static spp:Strings.L10nAccel_064}" />
				</StackPanel>
			</Button>
			<TextBlock Text="{x:Static spp:Strings.CommunityFix_ProxyMode}" />
			<TextBlock
				Text="{Binding Source={x:Static ms:ProxySettings.ProxyMode}, Path=Value, Mode=OneWay, Converter={StaticResource EnumLocalizationNameConverter}}" />

			<TextBlock Text="{x:Static spp:Strings.CommunityFix_EnableScriptService}" />
			<TextBlock
				Text="{Binding Source={x:Static s:ProxyService.Current}, Path=IsEnableScript, Converter={StaticResource StringFormatConverter}}" />
		</StackPanel>

		<spp:AdControl
			Grid.Row="2"
			Grid.Column="1"
			Width="165"
			Height="390"
			Margin="0,10,0,0"
			VerticalAlignment="Top"
			Standard="Vertical" />
		<spp:ProxyStartingAnimation
			x:Name="ProxyStartingAnimation"
			Grid.Row="2"
			Grid.ColumnSpan="2"
			ZIndex="10">
			<spp:ProxyStartingAnimation.IsVisible>
				<MultiBinding Converter="{x:Static BoolConverters.And}">
					<CompiledBindingExtension Source="{x:Static s:ProxyService.Current}" Path="ProxyStarting" />
					<CompiledBindingExtension Source="{x:Static s:ProxyService.Current}" Path="!ProxyStopping" />
				</MultiBinding>
			</spp:ProxyStartingAnimation.IsVisible>
		</spp:ProxyStartingAnimation>
	</Grid>
</spp:PageBase>
<spp:PageBase
    x:Class="BD.WTTS.UI.Views.Pages.AcceleratorPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="using:Avalonia.Xaml.Interactivity"
    xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ms="https://steampp.net/settings"
    xmlns:s="https://steampp.net/services"
    xmlns:spp="https://steampp.net/ui"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    Title="{x:Static spp:Strings.CommunityFix}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:CompileBindings="True"
    x:DataType="spp:AcceleratorPageViewModel"
    Description="{x:Static spp:Strings.L10nAccel_076}"
    OpenPaneLength="335"
    ScrollViewer.VerticalScrollBarVisibility="Disabled"
    Subtitle="{Binding Author, Source={x:Static s:Plugin.Instance}, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter=Plugin_Author}"
    mc:Ignorable="d">
    <spp:PageBase.PreviewImage>
        <ui:FAImageIconSource Source="{Binding Icon, Source={x:Static s:Plugin.Instance}, Mode=OneWay, Converter={StaticResource BitmapAssetValueConverter}}" />
    </spp:PageBase.PreviewImage>
    <spp:PageBase.ActionContent>
        <StackPanel Orientation="Horizontal" Spacing="2">
            <Button
                Padding="8,4"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Command="{Binding StartProxyCommand}"
                DockPanel.Dock="Right"
                IsVisible="{Binding Source={x:Static s:ProxyService.Current}, Path=!ProxyStatus, Mode=OneWay}"
                Theme="{StaticResource TransparentButton}">
                <!--<SplitButton.Flyout>
                    <ui:FAMenuFlyout>
                        <ui:FAMenuFlyoutSubItem ItemsSource="{Binding Source={x:Static ms:ProxySettings.ProxyModes}, Path=., Mode=OneWay}" Text="加速模式">
                            <ui:FAMenuFlyoutSubItem.ItemTemplate>
                                <DataTemplate>
                                    <ui:FARadioMenuFlyoutItem GroupName="ProxyMode" Text="{Binding}" />
                                </DataTemplate>
                            </ui:FAMenuFlyoutSubItem.ItemTemplate>
                        </ui:FAMenuFlyoutSubItem>
                        <ui:FAToggleMenuFlyoutItem Text="启用脚本" />
                    </ui:FAMenuFlyout>
                </SplitButton.Flyout>-->
                <Panel>
                    <Viewbox
                        Width="16"
                        Height="16"
                        HorizontalAlignment="Left">
                        <ui:FAFontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="{StaticResource SpeedHigh}" />
                    </Viewbox>
                    <TextBlock
                        Margin="28,4,0,4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="{x:Static spp:Strings.CommunityFix_StartProxy}" />
                </Panel>
            </Button>

            <Button
                Padding="8,4"
                Command="{Binding StartProxyCommand}"
                DockPanel.Dock="Right"
                IsVisible="{Binding Source={x:Static s:ProxyService.Current}, Path=ProxyStatus, Mode=OneWay}"
                Theme="{StaticResource TransparentButton}">
                <Panel>
                    <Viewbox
                        Width="16"
                        Height="16"
                        HorizontalAlignment="Left">
                        <ui:FASymbolIcon Symbol="StopFilled" />
                    </Viewbox>
                    <TextBlock
                        Margin="28,4,0,4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} {1}">
                                <Binding Mode="OneTime" Source="{x:Static spp:Strings.CommunityFix_StopProxy}" />
                                <CompiledBindingExtension
                                    Converter="{StaticResource StringFormatConverter}"
                                    Mode="OneWay"
                                    Path="AccelerateTime"
                                    Source="{x:Static s:ProxyService.Current}" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Panel>
            </Button>

            <Separator
                Height="18"
                Margin="5,0"
                VerticalAlignment="Center"
                Background="{DynamicResource ButtonBorderBrush}"
                Classes="Vertical"
                DockPanel.Dock="Right"
                IsHitTestVisible="False" />

            <Button
                Padding="8,4"
                Command="{Binding RefreshCommand}"
                DockPanel.Dock="Right"
                Theme="{StaticResource TransparentButton}">
                <Panel>
                    <Viewbox
                        Width="16"
                        Height="16"
                        HorizontalAlignment="Left">
                        <ui:FASymbolIcon Symbol="Refresh" />
                    </Viewbox>
                    <TextBlock
                        Margin="28,4,0,4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="{x:Static spp:Strings.Refresh}" />
                </Panel>
            </Button>

            <ToggleButton
                Padding="8,4"
                DockPanel.Dock="Right"
                IsChecked="{Binding $parent[spp:PageBase].IsPaneOpen, Mode=TwoWay}"
                Theme="{StaticResource TransparentToggleButton}">
                <Panel>
                    <Viewbox
                        Width="16"
                        Height="16"
                        HorizontalAlignment="Left">
                        <ui:FASymbolIcon Symbol="Settings" />
                    </Viewbox>
                    <TextBlock
                        Margin="28,4,0,4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="{x:Static spp:Strings.CommunityFix_MenuName}" />
                </Panel>
            </ToggleButton>

            <DropDownButton
                Padding="8"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Content="{StaticResource More}"
                FontFamily="{StaticResource SymbolThemeFontFamily}"
                FontSize="20"
                Theme="{StaticResource TransparentButton}">
                <DropDownButton.Flyout>
                    <ui:FAMenuFlyout Placement="BottomEdgeAlignedRight">
                        <!--<ui:FAMenuFlyoutSubItem ItemsSource="{Binding Source={x:Static ms:ProxySettings.ProxyModes}, Path=., Mode=OneWay}" Text="加速模式">
                            <ui:FAMenuFlyoutSubItem.ItemTemplate>
                                <DataTemplate>
                                    <ui:FARadioMenuFlyoutItem GroupName="ProxyMode" Text="{Binding}" />
                                </DataTemplate>
                            </ui:FAMenuFlyoutSubItem.ItemTemplate>
                        </ui:FAMenuFlyoutSubItem>-->
                        <!--<ui:FAMenuFlyoutItem Text="{x:Static spp:Strings.Settings_Plugin}" />-->
                        <!--<ui:FAMenuFlyoutSeparator />-->
                        <!--<ui:FAMenuFlyoutItem Text="安装证书" />
                        <ui:FAMenuFlyoutItem Text="移除证书" />
                        <ui:FAMenuFlyoutItem Text="打开证书文件夹" />
                        <ui:FAMenuFlyoutSeparator />
                        <ui:FAMenuFlyoutItem Text="编辑 hosts 文件" />
                        <ui:FAMenuFlyoutItem Text="重置 hosts 文件" />
                        <ui:FAMenuFlyoutItem Text="打开 hosts 文件夹" />
                        <ui:FAMenuFlyoutSeparator />-->
                        <ui:FAMenuFlyoutItem IsEnabled="False">
                            <ui:FAMenuFlyoutItem.Text>
                                <MultiBinding StringFormat="{}{0}{1}">
                                    <Binding Mode="OneTime" Source="{x:Static spp:Strings.Plugin_Version}" />
                                    <CompiledBindingExtension
                                        Mode="OneWay"
                                        Path="Version"
                                        Source="{x:Static s:Plugin.Instance}" />
                                </MultiBinding>
                            </ui:FAMenuFlyoutItem.Text>
                        </ui:FAMenuFlyoutItem>
                        <!--<ui:FAMenuFlyoutItem Text="{x:Static spp:Strings.ViewInStore}" />
                        <ui:FAMenuFlyoutItem Text="{x:Static spp:Strings.UseHelp}" />
                        <ui:FAMenuFlyoutItem Text="{x:Static spp:Strings.AboutThisPlugin}" />-->
                    </ui:FAMenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </StackPanel>
    </spp:PageBase.ActionContent>
    <spp:PageBase.PaneContent>
        <StackPanel Margin="15,20" Spacing="10">
            <TextBlock Text="{x:Static spp:Strings.CommunityFix_ProxyMode}" Theme="{StaticResource BodyStrongTextBlockStyle}" />

            <TabStrip
                Background="{DynamicResource ControlOnImageFillColorDefaultBrush}"
                CornerRadius="{StaticResource ControlCornerRadius}"
                IsEnabled="{Binding Source={x:Static s:ProxyService.Current}, Path=!ProxyStatus, Mode=OneWay}"
                ItemContainerTheme="{StaticResource TabItemStyle}"
                ItemsSource="{Binding Source={x:Static ms:ProxySettings.ProxyModes}, Path=., Mode=OneWay}"
                SelectedItem="{Binding Source={x:Static ms:ProxySettings.ProxyMode}, Path=Value, Mode=TwoWay}"
                Theme="{StaticResource TabStripStyle}">
                <TabStrip.ItemTemplate>
                    <DataTemplate DataType="spp:ProxyMode">
                        <TextBlock Text="{Binding}" />
                    </DataTemplate>
                </TabStrip.ItemTemplate>
            </TabStrip>

            <TextBlock Text="{x:Static spp:Strings.CommunityFix_MenuName}" Theme="{StaticResource BodyStrongTextBlockStyle}" />
            <DockPanel>
                <ToggleSwitch
                    VerticalAlignment="Center"
                    Classes="NoContent"
                    IsChecked="{Binding Source={x:Static s:ProxyService.Current}, Path=IsEnableScript, Mode=TwoWay}"
                    OffContent="{x:Static spp:Strings.CommunityFix_EnableScriptService}"
                    OnContent="{x:Static spp:Strings.CommunityFix_EnableScriptService}" />

                <!--<WrapPanel>-->
                <TextBlock
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Classes.NotSupport="{Binding Source={x:Static s:ProxyService.Current}, Path=IPv6AddresString, Mode=OneWay, Converter={StaticResource IsNullConverter}}"
                    Classes.Support="{Binding Source={x:Static s:ProxyService.Current}, Path=IPv6AddresString, Mode=OneWay, Converter={StaticResource IsNullConverter}, ConverterParameter=invert}"
                    Theme="{StaticResource CaptionTextBlockStyle}"
                    ToolTip.Tip="{Binding Source={x:Static s:ProxyService.Current}, Path=IPv6AddresString, Mode=OneWay}">
                    <TextBlock.Styles>
                        <Style Selector="TextBlock.Support">
                            <Setter Property="Text" Value="{x:Static spp:Strings.L10nAccel_033}" />
                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                        </Style>
                        <Style Selector="TextBlock.NotSupport">
                            <Setter Property="Text" Value="{x:Static spp:Strings.L10nAccel_034}" />
                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                        </Style>
                    </TextBlock.Styles>
                </TextBlock>
                <!--<Button
						VerticalAlignment="Center"
						Command="{Binding Source={x:Static s:ProxyService.Current}, Path=RefreshIpv6Support, Mode=OneWay}"
						Theme="{StaticResource TransparentButton}"
						ToolTip.Tip="{x:Static spp:Strings.Refresh}">
						<ui:FASymbolIcon Symbol="Refresh" />
					</Button>
				</WrapPanel>-->
            </DockPanel>
            <ToggleSwitch
                VerticalAlignment="Center"
                Classes="NoContent"
                IsChecked="{Binding Source={x:Static ms:ProxySettings.ProgramStartupRunProxy}, Path=Value, Mode=TwoWay}"
                OffContent="{x:Static spp:Strings.CommunityFix_AutoRunProxy}"
                OnContent="{x:Static spp:Strings.CommunityFix_AutoRunProxy}" />

            <!--<StackPanel Orientation="Horizontal" Spacing="4">
                <ToggleButton
                    Padding="8"
                    Theme="{StaticResource TransparentToggleButton}"
                    ToolTip.Tip="{x:Static spp:Strings.GameList_OnlyInstalled}">
                    <Viewbox Width="20" Height="20">
                        <ui:FASymbolIcon Symbol="Play" />
                    </Viewbox>
                </ToggleButton>

                <ToggleButton
                    Padding="8"
                    Theme="{StaticResource TransparentToggleButton}"
                    ToolTip.Tip="{x:Static spp:Strings.GameList_OnlyCloudArchive}">
                    <Viewbox Width="20" Height="20">
                        <ui:FASymbolIcon Symbol="CloudSyncComplete" />
                    </Viewbox>
                </ToggleButton>
            </StackPanel>-->

            <Button
                HorizontalAlignment="Stretch"
                Command="{Binding ProxySettingsCommand}"
                Content="{x:Static spp:Strings.CommunityFix_ProxySettings}" />

            <Separator Margin="0,8" Classes="Horizontal" />

            <Button
                HorizontalAlignment="Stretch"
                Command="{Binding SetupCertificateCommand}"
                Content="{x:Static spp:Strings.CommunityFix_SetupCertificate}" />
            <Button
                HorizontalAlignment="Stretch"
                Command="{Binding DeleteCertificateCommand}"
                Content="{x:Static spp:Strings.CommunityFix_DeleteCertificate}" />
            <Button
                HorizontalAlignment="Stretch"
                Command="{Binding ShowCertificateCommand}"
                Content="{x:Static spp:Strings.L10nAccel_049}" />
            <Button
                HorizontalAlignment="Stretch"
                Command="{Binding OpenCertificateDirCommand}"
                Content="{x:Static spp:Strings.CommunityFix_OpenCertificateDir}" />

            <Separator Margin="0,8" Classes="Horizontal" />

            <Button
                HorizontalAlignment="Stretch"
                Command="{Binding EditHostsFileCommand}"
                Content="{x:Static spp:Strings.CommunityFix_EditHostsFile}" />
            <Button
                HorizontalAlignment="Stretch"
                Command="{Binding ResetHostsFileCommand}"
                Content="{x:Static spp:Strings.CommunityFix_ResetHostsFile}" />
            <Button
                HorizontalAlignment="Stretch"
                Command="{Binding OpenHostsDirCommand}"
                Content="{x:Static spp:Strings.CommunityFix_OpenHostsDir}" />

            <!--<ui:FAComboBox ItemsSource="{Binding Source={x:Static ms:ProxySettings.ProxyModes}, Path=., Mode=OneWay}" SelectedItem="{Binding Source={x:Static ms:ProxySettings.ProxyMode}, Path=Value, Mode=TwoWay}">
                <ui:FAComboBox.ItemTemplate>
                    <DataTemplate DataType="spp:ProxyMode">
                        <TextBlock Text="{Binding}" />
                    </DataTemplate>
                </ui:FAComboBox.ItemTemplate>
            </ui:FAComboBox>-->

        </StackPanel>
    </spp:PageBase.PaneContent>
    <Grid ColumnDefinitions="*,Auto">
        <ScrollViewer
            Padding="0,0,10,0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Carousel
                Name="AcceleratorCarousel"
                Classes="AnimeSlide"
                SelectedIndex="{Binding Source={x:Static s:ProxyService.Current}, Path=ProxyStatus, Mode=OneWay}">
                <!--<i:Interaction.Behaviors>
                    <ia:DataTriggerBehavior
                        Binding="{Binding Source={x:Static s:ProxyService.Current}, Path=!ProxyStatus, Mode=OneWay}"
                        ComparisonCondition="Equal"
                        Value="True">
                        <ia:ChangePropertyAction
                            PropertyName="SelectedIndex"
                            TargetObject="{Binding #AcceleratorCarousel}"
                            Value="0" />
                    </ia:DataTriggerBehavior>
                    <ia:DataTriggerBehavior
                        Binding="{Binding Source={x:Static s:ProxyService.Current}, Path=!ProxyStatus, Mode=OneWay}"
                        ComparisonCondition="Equal"
                        Value="False">
                        <ia:ChangePropertyAction
                            PropertyName="SelectedIndex"
                            TargetObject="{Binding #AcceleratorCarousel}"
                            Value="1" />
                    </ia:DataTriggerBehavior>
                </i:Interaction.Behaviors>-->

                <spp:ContentLoader IsLoading="{Binding Source={x:Static s:ProxyService.Current}, Path=IsLoadingAccelerate, Mode=OneWay}" IsShowNoResultText="{Binding Source={x:Static s:ProxyService.Current}, Path=!ProxyDomainsList.Count, Mode=OneWay}" NoResultMessage="{x:Static spp:Strings.CommunityFix_ItemsEmpty}">
                    <Grid ColumnDefinitions="*,Auto">
                        <ItemsControl ItemsSource="{Binding Source={x:Static s:ProxyService.Current}, Path=ProxyDomainsList, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" Spacing="{StaticResource SettingsSpacing}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="spp:AccelerateProjectGroupDTO">
                                    <Border>
                                        <!--<ui:FASettingsExpander ItemsSource="{Binding Items}">-->
                                        <ui:FASettingsExpander IsClickEnabled="False">
                                            <ui:FASettingsExpander.Header>
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <CheckBox IsChecked="{Binding ThreeStateEnable, Mode=TwoWay}" />
                                                    <spp:Image2
                                                        Width="30"
                                                        Height="30"
                                                        VerticalAlignment="Center"
                                                        RenderOptions.BitmapInterpolationMode="HighQuality"
                                                        Source="{Binding IconUrl}"
                                                        Stretch="UniformToFill" />
                                                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                                </StackPanel>
                                            </ui:FASettingsExpander.Header>
                                            <ui:FASettingsExpanderItem Theme="{StaticResource SettingsExpanderItem2}">
                                                <TreeView ItemsSource="{Binding ObservableItems}" SelectionMode="Single">
                                                    <TreeView.ItemTemplate>
                                                        <TreeDataTemplate DataType="spp:AccelerateProjectDTO" ItemsSource="{Binding ObservableItems}">
                                                            <DockPanel Margin="8,0">
                                                                <CheckBox
                                                                    HorizontalAlignment="Left"
                                                                    DockPanel.Dock="Left"
                                                                    IsChecked="{Binding ThreeStateEnable, Mode=TwoWay}">
                                                                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                                                </CheckBox>
                                                                <TextBlock
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center"
                                                                    DockPanel.Dock="Right"
                                                                    Text="{Binding DomainNamesArray[0]}" />
                                                            </DockPanel>
                                                        </TreeDataTemplate>
                                                    </TreeView.ItemTemplate>
                                                </TreeView>
                                            </ui:FASettingsExpanderItem>
                                            <!--<ui:FASettingsExpander.ItemTemplate>
                                        <DataTemplate DataType="spp:AccelerateProjectDTO">
                                            <ui:FASettingsExpanderItem IsClickEnabled="True">
                                                <ui:FASettingsExpanderItem.Content>
                                                    <TextBlock Text="{Binding Name}" />
                                                </ui:FASettingsExpanderItem.Content>
                                                <ui:FASettingsExpanderItem.IconSource>
                                                    <ui:FASymbolIconSource Symbol="Accept" />
                                                </ui:FASettingsExpanderItem.IconSource>
                                                <ui:FASettingsExpanderItem.Footer>
                                                    <TextBlock Text="{Binding DomainNamesArray[0]}" />
                                                </ui:FASettingsExpanderItem.Footer>
                                            </ui:FASettingsExpanderItem>
                                        </DataTemplate>
                                    </ui:FASettingsExpander.ItemTemplate>-->
                                        </ui:FASettingsExpander>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>
                    </Grid>
                </spp:ContentLoader>

                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,*,Auto">
                    <TabStrip
                        x:Name="Tabs"
                        ItemContainerTheme="{StaticResource TabItemStyle}"
                        Theme="{StaticResource TabStripStyle}">
                        <TabStripItem Content="{x:Static spp:Strings.CommunityFix_FlowStatistics}" />
                        <TabStripItem Content="{x:Static spp:Strings.CommunityFix_Services}" />
                    </TabStrip>
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Spacing="8">
                        <StackPanel.Styles>
                            <Style Selector="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </StackPanel.Styles>
                        <!--<StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <TextBlock FontSize="26" Text="{x:Static spp:Strings.CommunityFix_AlreadyProxy}" />
                        <TextBlock
                            Margin="5,0,0,0"
                            FontSize="26"
                            Text="{Binding AccelerateTime,
                                                     Source={x:Static s:ProxyService.Current},
                                                     StringFormat={}{0:hh\\:mm\\:ss}}" />
                    </StackPanel>-->
                        <TextBlock>
                            <Run Text="{x:Static spp:Strings.CommunityFix_ProxyMode}" /><Run Text="：" />
                            <Run Text="{Binding Source={x:Static ms:ProxySettings.ProxyMode}, Path=Value, Mode=OneWay, Converter={StaticResource EnumLocalizationNameConverter}}" />

                            <Run Text="  " />

                            <Run Text="{x:Static spp:Strings.CommunityFix_EnableScriptService}" /><Run Text="：" />
                            <Run Text="{Binding Source={x:Static s:ProxyService.Current}, Path=IsEnableScript, Converter={StaticResource StringFormatConverter}}" />
                        </TextBlock>
                    </StackPanel>

                    <Carousel
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Classes="AnimeSlide"
                        SelectedIndex="{Binding #Tabs.SelectedIndex}">

                        <spp:ProxyChartView Margin="5,0" />

                        <Grid ColumnDefinitions="*,20,*">
                            <Border
                                Grid.Column="0"
                                Padding="10"
                                Classes="paper">
                                <DockPanel>
                                    <TextBlock
                                        Margin="0,0,0,10"
                                        DockPanel.Dock="Top"
                                        FontSize="16"
                                        Text="{x:Static spp:Strings.CommunityFix_AccelerationsEnable}" />
                                    <ScrollViewer>
                                        <ItemsControl ItemsSource="{Binding EnableProxyDomains, Source={x:Static s:ProxyService.Current}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type spp:AccelerateProjectDTO}">
                                                    <StackPanel Margin="10">
                                                        <DockPanel>
                                                            <TextBlock Text="{Binding Name}" />
                                                        </DockPanel>
                                                        <Separator Classes="Separator" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>

                            <Border
                                Grid.Column="2"
                                Padding="10"
                                Classes="paper">
                                <DockPanel>
                                    <TextBlock
                                        Margin="0,0,0,10"
                                        DockPanel.Dock="Top"
                                        FontSize="16"
                                        Text="{x:Static spp:Strings.CommunityFix_ScriptsEnable}" />
                                    <ScrollViewer>
                                        <ItemsControl ItemsSource="{Binding EnableProxyScripts^, Source={x:Static s:ProxyService.Current}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type spp:ScriptDTO}">
                                                    <StackPanel Margin="10">
                                                        <DockPanel>
                                                            <TextBlock Text="{Binding Name}" />
                                                        </DockPanel>
                                                        <Separator Classes="Separator" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>


                        <!--<TabItem Header="加速日志">

					    </TabItem>-->
                        <!--<TabItem Header="AD">
					
						</TabItem>-->
                    </Carousel>
                </Grid>
            </Carousel>
        </ScrollViewer>

        <spp:AdControl
            Grid.Column="1"
            Width="165"
            Height="390"
            VerticalAlignment="Top"
            Standard="Vertical" />
    </Grid>
</spp:PageBase>

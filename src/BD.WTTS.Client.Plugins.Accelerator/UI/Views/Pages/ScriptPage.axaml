<spp:PageBase
    x:Class="BD.WTTS.UI.Views.Pages.ScriptPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ms="https://steampp.net/settings"
    xmlns:s="https://steampp.net/services"
    xmlns:spp="https://steampp.net/ui"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    Title="{x:Static spp:Strings.ScriptConfig}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:CompileBindings="True"
    x:DataType="spp:ScriptPageViewModel"
    Description="{x:Static spp:Strings.L10nAccel_076}"
    Subtitle="{Binding Author, Source={x:Static s:Plugin.Instance}, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter=Plugin_Author}"
    mc:Ignorable="d">
    <spp:PageBase.Styles>
        <Style Selector="spp|AppItem /template/ TextBlock#HeaderText">
            <Setter Property="Grid.ColumnSpan" Value="0" />
        </Style>
    </spp:PageBase.Styles>
    <spp:PageBase.PreviewImage>
        <ui:FAImageIconSource Source="avares://BD.WTTS.Client.Plugins.Accelerator/UI/Assets/script.ico" />
    </spp:PageBase.PreviewImage>
    <spp:PageBase.ActionContent>
        <StackPanel Orientation="Horizontal" Spacing="2">
            <Button
                Padding="8,4"
                Command="{Binding ScriptStoreCommand}"
                DockPanel.Dock="Right"
                Theme="{StaticResource TransparentButton}">
                <Panel>
                    <Viewbox
                        Width="16"
                        Height="16"
                        HorizontalAlignment="Left">
                        <ui:FASymbolIcon Symbol="Globe" />
                    </Viewbox>
                    <TextBlock
                        Margin="28,4,0,4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="{x:Static spp:Strings.ScriptStore}" />
                </Panel>
            </Button>
            <Separator
                Height="18"
                Margin="0"
                VerticalAlignment="Center"
                Background="{DynamicResource ButtonBorderBrush}"
                Classes="Vertical"
                DockPanel.Dock="Right"
                IsHitTestVisible="False" />
            <Button
                Padding="8,4"
                Command="{Binding $parent[spp:PageBase].((spp:ScriptPageViewModel)DataContext).AddNewScriptCommand}"
                DockPanel.Dock="Right"
                Theme="{StaticResource TransparentButton}">
                <Panel>
                    <Viewbox
                        Width="16"
                        Height="16"
                        HorizontalAlignment="Left">
                        <ui:FASymbolIcon Symbol="Add" />
                    </Viewbox>
                    <TextBlock
                        Margin="28,4,0,4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="{x:Static spp:Strings.Import}" />
                </Panel>
            </Button>
            <Button
                Padding="8,4"
                Command="{Binding $parent[spp:PageBase].((spp:ScriptPageViewModel)DataContext).RefreshALLScriptCommand}"
                DockPanel.Dock="Right"
                Theme="{StaticResource TransparentButton}">
                <Panel>
                    <Viewbox
                        Width="16"
                        Height="16"
                        HorizontalAlignment="Left">
                        <ui:FASymbolIcon Symbol="Refresh" />
                    </Viewbox>
                    <TextBlock
                        Margin="28,4,0,4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="{x:Static spp:Strings.Refresh}" />
                </Panel>
            </Button>
            <DropDownButton
                Padding="8"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Content="{StaticResource More}"
                FontFamily="{StaticResource SymbolThemeFontFamily}"
                FontSize="20"
                Theme="{StaticResource TransparentButton}">
                <DropDownButton.Flyout>
                    <ui:FAMenuFlyout Placement="BottomEdgeAlignedRight">
                        <!--<ui:FAMenuFlyoutItem Text="{x:Static spp:Strings.Script_Settings}" />-->
                        <!--<ui:FAMenuFlyoutSeparator />-->
                        <ui:FAToggleMenuFlyoutItem IsChecked="{Binding Source={x:Static ms:ProxySettings.IsAutoCheckScriptUpdate}, Path=Value, Mode=TwoWay}" Text="{x:Static spp:Strings.Script_AutoUpdate}" />
                        <ui:FAToggleMenuFlyoutItem IsChecked="{Binding Source={x:Static ms:ProxySettings.IsOnlyWorkSteamBrowser}, Path=Value, Mode=TwoWay}" Text="{x:Static spp:Strings.CommunityFix_OnlySteamBrowser}" />
                        <ui:FAMenuFlyoutSeparator />
                        <ui:FAMenuFlyoutItem IsEnabled="False">
                            <ui:FAMenuFlyoutItem.Text>
                                <MultiBinding StringFormat="{}{0}{1}">
                                    <Binding Mode="OneTime" Source="{x:Static spp:Strings.Plugin_Version}" />
                                    <CompiledBindingExtension
                                        Mode="OneWay"
                                        Path="Version"
                                        Source="{x:Static s:Plugin.Instance}" />
                                </MultiBinding>
                            </ui:FAMenuFlyoutItem.Text>
                        </ui:FAMenuFlyoutItem>
                        <!--<ui:FAMenuFlyoutItem Text="{x:Static spp:Strings.ViewInStore}" />
                        <ui:FAMenuFlyoutItem Text="{x:Static spp:Strings.UseHelp}" />
                        <ui:FAMenuFlyoutItem Text="{x:Static spp:Strings.AboutThisPlugin}" />-->
                    </ui:FAMenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </StackPanel>
    </spp:PageBase.ActionContent>
    <spp:ContentLoader
        IsLoading="False"
        IsShowNoResultText="{Binding !!!ProxyScripts.Count, Mode=OneWay}"
        NoResultMessage="{x:Static spp:Strings.L10nAccel_070}">
        <ItemsRepeater Grid.Row="1" ItemsSource="{Binding ProxyScripts}">
            <ItemsRepeater.Layout>
                <UniformGridLayout
                    ItemsJustification="Start"
                    ItemsStretch="Uniform"
                    MinColumnSpacing="10"
                    MinItemHeight="160"
                    MinItemWidth="400"
                    MinRowSpacing="10" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate DataType="spp:ScriptDTO">
                    <spp:AppItem
                        Title="{Binding Name}"
                        Description="{Binding Describe}"
                        ImageMargin="30"
                        ImageStretch="None">
                        <spp:AppItem.Status>
                            <ToggleSwitch Classes="LeftContent" IsChecked="{Binding !Disable, Mode=TwoWay}" />
                        </spp:AppItem.Status>
                        <spp:AppItem.Tags>
                            <MultiBinding StringFormat="{}{0} | {1}">
                                <CompiledBindingExtension Mode="OneWay" Path="AuthorName" />
                                <CompiledBindingExtension Mode="OneWay" Path="Version" />
                            </MultiBinding>
                        </spp:AppItem.Tags>
                        <spp:AppItem.ActionButton>
                            <StackPanel
                                Margin="0,0,3,0"
                                Orientation="Horizontal"
                                Spacing="5">
                                <Button
                                    Command="{Binding $parent[spp:PageBase].((spp:ScriptPageViewModel)DataContext).DownloadScriptItemCommand}"
                                    CommandParameter="{Binding}"
                                    IsVisible="{Binding IsUpdate}"
                                    Theme="{DynamicResource TransparentButton}">
                                    <ToolTip.Tip>
                                        <MultiBinding StringFormat="{}{0} v{1}">
                                            <Binding Mode="OneTime" Source="{x:Static spp:Strings.Script_Update}" />
                                            <CompiledBindingExtension Mode="OneWay" Path="NewVersion" />
                                        </MultiBinding>
                                    </ToolTip.Tip>
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <Viewbox Width="16" Height="16">
                                            <ui:FASymbolIcon Symbol="Download" />
                                        </Viewbox>
                                        <TextBlock VerticalAlignment="Center" Text="{Binding NewVersion}" />
                                        <Ellipse
                                            Width="6"
                                            Height="6"
                                            Fill="#dd5a5a" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Command="{Binding $parent[spp:PageBase].((spp:ScriptPageViewModel)DataContext).EditScriptItemCommand}"
                                    CommandParameter="{Binding}"
                                    Theme="{DynamicResource TransparentButton}"
                                    ToolTip.Tip="{x:Static spp:Strings.Script_Edit}">
                                    <Viewbox Width="16" Height="16">
                                        <ui:FASymbolIcon Symbol="CodeHTML" />
                                    </Viewbox>
                                </Button>
                                <Button
                                    Command="{Binding $parent[spp:PageBase].((spp:ScriptPageViewModel)DataContext).RefreshScriptItemCommand}"
                                    CommandParameter="{Binding}"
                                    Theme="{DynamicResource TransparentButton}"
                                    ToolTip.Tip="{x:Static spp:Strings.Script_Refresh}">
                                    <Viewbox Width="16" Height="16">
                                        <ui:FASymbolIcon Symbol="Refresh" />
                                    </Viewbox>
                                </Button>
                            </StackPanel>
                        </spp:AppItem.ActionButton>
                        <spp:AppItem.MoreFlyout>
                            <ui:FAMenuFlyout>
                                <!--<ui:FAMenuFlyoutItem
                                        Command="{Binding $parent[spp:PageBase].((spp:ScriptPageViewModel)DataContext).EditScriptItemButton}"
                                        CommandParameter="{Binding}"
                                        Text="{x:Static spp:Strings.Script_Edit}" />
                                    <ui:FAMenuFlyoutItem
                                        Command="{Binding $parent[spp:PageBase].((spp:ScriptPageViewModel)DataContext).RefreshScriptItemButton}"
                                        CommandParameter="{Binding}"
                                        Text="{x:Static spp:Strings.Script_Refresh}" />-->
                                <ui:FAMenuFlyoutItem
                                    Command="{Binding OpenBrowserCommand, Source={x:Static spp:App.Instance}}"
                                    CommandParameter="{Binding SourceLink}"
                                    Text="{x:Static spp:Strings.Script_Home}" />
                                <ui:FAMenuFlyoutItem
                                    Command="{Binding $parent[spp:PageBase].((spp:ScriptPageViewModel)DataContext).DownloadScriptItemCommand}"
                                    CommandParameter="{Binding}"
                                    IsVisible="{Binding IsUpdate}">
                                    <ui:FAMenuFlyoutItem.Text>
                                        <MultiBinding StringFormat="{}{0} v{1}">
                                            <Binding Mode="OneTime" Source="{x:Static spp:Strings.Script_Update}" />
                                            <CompiledBindingExtension Mode="OneWay" Path="NewVersion" />
                                        </MultiBinding>
                                    </ui:FAMenuFlyoutItem.Text>
                                </ui:FAMenuFlyoutItem>
                                <ui:FAMenuFlyoutSeparator />
                                <ui:FAMenuFlyoutItem
                                    Command="{Binding $parent[spp:PageBase].((spp:ScriptPageViewModel)DataContext).DeleteScriptItemCommand}"
                                    CommandParameter="{Binding}"
                                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                    Text="{x:Static spp:Strings.Delete}" />
                            </ui:FAMenuFlyout>
                        </spp:AppItem.MoreFlyout>
                        <spp:AppItem.Image>
                            <Panel Width="64">
                                <spp:Image2
                                    FallbackSource="avares://BD.WTTS.Client.Plugins.Accelerator/UI/Assets/script.ico"
                                    IsVisible="{Binding !IsLoading}"
                                    RenderOptions.BitmapInterpolationMode="HighQuality"
                                    Source="{Binding IconUrl}"
                                    Stretch="Uniform" />
                                <ProgressBar
                                    Width="64"
                                    Height="64"
                                    Classes="Circle"
                                    IsIndeterminate="True"
                                    IsVisible="{Binding IsLoading}"
                                    ToolTip.Tip="{x:Static spp:Strings.Script_ImportLoading}" />
                            </Panel>
                        </spp:AppItem.Image>
                    </spp:AppItem>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
    </spp:ContentLoader>
</spp:PageBase>

<UserControl
    x:Class="BD.WTTS.UI.Views.Controls.ProxyChartView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:BD.WTTS.UI.Views.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:spp="https://steampp.net/ui"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <controls:TrafficChart
        x:Name="Chart"
        UploadLabel="{x:Static spp:Strings.Upload}"
        DownloadLabel="{x:Static spp:Strings.Download}"
        TotalUploadLabel="{x:Static spp:Strings.UploadFlow}"
        TotalDownloadLabel="{x:Static spp:Strings.DownloadFlow}"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch" />
</UserControl>

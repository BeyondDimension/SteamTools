<UserControl
    x:Class="BD.WTTS.UI.Views.Pages.NetworkCheck"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ms="https://steampp.net/settings"
    xmlns:s="https://steampp.net/services"
    xmlns:spp="https://steampp.net/ui"
    xmlns:sys="using:System"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:dns="using:BD.WTTS.UI.Views.Controls"
    xmlns:vm="using:BD.WTTS.UI.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="spp:NetworkCheckControlViewModel"
    mc:Ignorable="d">
    <ScrollViewer
        Padding="0,0,10,0"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="8">
            <!--  NAT  -->
            <ui:FASettingsExpander Header="{x:Static spp:Strings.L10nAccel_010}" IsExpanded="True">
                <ui:FASettingsExpander.IconSource>
                    <ui:FAFontIconSource FontFamily="Segoe Fluent Icons" Glyph="&#xE969;" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpander.Footer>
                    <WrapPanel>
                        <ui:FAComboBox
                            Margin="0,0,4,4"
                            IsEditable="False"
                            IsEnabled="{Binding !IsNATChecking}"
                            ItemsSource="{Binding STUNAddress}"
                            SelectedItem="{Binding SelectedSTUNAddress, Mode=TwoWay}"
                            ToolTip.Tip="{x:Static spp:Strings.L10nAccel_011}">
                            <ui:FAComboBox.ItemTemplate>
                                <DataTemplate DataType="sys:String">
                                    <TextBlock Text="{Binding}" />
                                </DataTemplate>
                            </ui:FAComboBox.ItemTemplate>
                        </ui:FAComboBox>
                        <Button
                            x:Name="NATCheckButton"
                            Width="100"
                            Margin="0,0,0,4"
                            Command="{Binding NATCheckCommand}"
                            Content="{x:Static spp:Strings.L10nAccel_012}"
                            IsEnabled="True" />
                    </WrapPanel>
                </ui:FASettingsExpander.Footer>

                <ui:FASettingsExpanderItem Content="{x:Static spp:Strings.L10nAccel_013}">
                    <ui:FASettingsExpanderItem.Footer>
                        <Grid>
                            <ui:FAProgressRing
                                Width="22"
                                Margin="0,-4,0,-10"
                                HorizontalAlignment="Right"
                                IsVisible="{Binding IsNATChecking}" />

                            <DockPanel IsVisible="{Binding !IsNATChecking}">
                                <SelectableTextBlock
                                    x:Name="NATTextBlock"
                                    VerticalAlignment="Center"
                                    Foreground="Gray"
                                    Text="{Binding NATLevel}" />
                                <ui:FAFontIcon
                                    Margin="3,0"
                                    FontSize="20"
                                    Glyph="&#xE946;"
                                    ToolTip.ShowDelay="0">
                                    <ToolTip.Tip>
                                        <TextBlock x:Name="NATTypeTip" Text="{Binding NATTypeTip}" />
                                    </ToolTip.Tip>
                                </ui:FAFontIcon>
                            </DockPanel>
                        </Grid>
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>

                <ui:FASettingsExpanderItem Content="{x:Static spp:Strings.L10nAccel_014}">
                    <ui:FASettingsExpanderItem.Footer>
                        <Grid>
                            <ui:FAProgressRing
                                Width="22"
                                Margin="0,-4,0,-10"
                                HorizontalAlignment="Right"
                                IsVisible="{Binding IsNATChecking}" />
                            <SelectableTextBlock
                                Foreground="Gray"
                                IsVisible="{Binding !IsNATChecking}"
                                Text="{Binding LocalEndPoint}" />
                        </Grid>
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>

                <ui:FASettingsExpanderItem>
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{x:Static spp:Strings.L10nAccel_015}"
                        ToolTip.Tip="{x:Static spp:Strings.L10nAccel_016}" />
                    <ui:FASettingsExpanderItem.Footer>
                        <Grid>
                            <ui:FAProgressRing
                                Width="22"
                                Margin="0,-4,0,-10"
                                HorizontalAlignment="Right"
                                IsVisible="{Binding IsNATChecking}" />
                            <SelectableTextBlock
                                Foreground="Gray"
                                IsVisible="{Binding !IsNATChecking}"
                                Text="{Binding PublicEndPoint}" />
                        </Grid>
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>

                <ui:FASettingsExpanderItem Content="{x:Static spp:Strings.L10nAccel_017}">
                    <ui:FASettingsExpanderItem.Footer>
                        <Grid>
                            <ui:FAProgressRing
                                Width="22"
                                Margin="0,-4,0,-10"
                                HorizontalAlignment="Right"
                                IsVisible="{Binding IsNATChecking}" />

                            <ui:FAFontIcon
                                x:Name="PingOK"
                                HorizontalAlignment="Right"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="26"
                                Foreground="Green"
                                Glyph="&#xe73d;"
                                IsVisible="{Binding PingOkVisible}" />

                            <Grid x:Name="PingError" IsVisible="{Binding PingErrorVisible}">
                                <ui:FAFontIcon
                                    Margin="3"
                                    HorizontalAlignment="Right"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="20"
                                    Foreground="Red"
                                    Glyph="&#xf127;" />
                                <ui:FAFontIcon
                                    HorizontalAlignment="Right"
                                    FontSize="26"
                                    Foreground="White"
                                    Glyph="&#xea39;" />
                            </Grid>
                        </Grid>
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>

                <StackPanel Spacing="8">
                    <TextBlock
                        Margin="-28,0,0,0"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="{x:Static spp:Strings.L10nAccel_018}" />

                    <WrapPanel Margin="-10,0,0,0">
                        <HyperlinkButton
                            VerticalAlignment="Center"
                            Content="{x:Static spp:Strings.L10nAccel_019}"
                            NavigateUri="https://support.xbox.com/zh-CN/help/hardware-network/connect-network/xbox-one-nat-error" />
                        <HyperlinkButton
                            VerticalAlignment="Center"
                            Content="{x:Static spp:Strings.L10nAccel_020}"
                            NavigateUri="https://manuals.playstation.net/document/ct/ps4/settings/nw_test.html" />
                        <HyperlinkButton
                            VerticalAlignment="Center"
                            Content="{x:Static spp:Strings.L10nAccel_021}"
                            NavigateUri="https://www.nintendoswitch.com.cn/support/faq/373.html" />
                        <HyperlinkButton
                            VerticalAlignment="Center"
                            Content="{x:Static spp:Strings.L10nAccel_022}"
                            NavigateUri="https://help.bungie.net/hc/zh-cn/articles/360049496751-%E9%AB%98%E7%BA%A7%E7%96%91%E9%9A%BE%E6%8E%92%E8%A7%A3-%E9%80%9A%E7%94%A8%E5%8D%B3%E6%8F%92%E5%8D%B3%E7%94%A8-%E7%AB%AF%E5%8F%A3%E8%BD%AC%E9%80%81%E4%B8%8E%E7%BD%91%E7%BB%9C%E5%9C%B0%E5%9D%80%E8%BD%AC%E6%8D%A2%E7%B1%BB%E5%9E%8B" />
                        <HyperlinkButton
                            VerticalAlignment="Center"
                            Content="{x:Static spp:Strings.L10nAccel_023}"
                            NavigateUri="https://support.activision.com/tw/zh/articles/port-forward-and-nat-faq" />
                        <HyperlinkButton
                            VerticalAlignment="Center"
                            Content="{x:Static spp:Strings.L10nAccel_024}"
                            NavigateUri="https://support.rockstargames.com/tw/articles/206210548/%E5%A6%82%E4%BD%95%E8%A7%A3%E6%B1%BA-GTA-%E7%B7%9A%E4%B8%8A%E6%A8%A1%E5%BC%8F%E4%B8%AD%E8%88%87%E5%9A%B4%E6%A0%BC-Strict-NAT-%E9%A1%9E%E5%9E%8B%E7%9B%B8%E9%97%9C%E7%9A%84%E9%8C%AF%E8%AA%A4" />
                        <HyperlinkButton
                            VerticalAlignment="Center"
                            Content="{x:Static spp:Strings.L10nAccel_025}"
                            NavigateUri="https://cs.xunyou.com/html/282/15271.shtml" />
                    </WrapPanel>
                </StackPanel>
            </ui:FASettingsExpander>

            <!--  DNS  -->
            <ui:FASettingsExpander Header="{x:Static spp:Strings.L10nAccel_026}" IsExpanded="True">
                <ui:FASettingsExpander.IconSource>
                    <ui:FAFontIconSource FontFamily="Segoe Fluent Icons" Glyph="&#xEDA3;" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpander.Footer>
                    <Button
                        Width="100"
                        Command="{Binding DNSCheckCommand}"
                        Content="{x:Static spp:Strings.L10nAccel_012}" />
                </ui:FASettingsExpander.Footer>

                <TextBlock
                    Margin="-28,0,0,-4"
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    Text="{x:Static spp:Strings.L10nAccel_027}" />

                <ui:FASettingsExpanderItem Content="{x:Static spp:Strings.L10nAccel_028}">
                    <ui:FASettingsExpanderItem.Footer>
                        <TextBox
                            Width="220"
                            Text="{Binding DomainPendingTest, Mode=TwoWay}"
                            PlaceholderText="{Binding DefaultTestDomain}">
                            <TextBox.Styles>
                                <Style Selector="DataValidationErrors">
                                    <Setter Property="Template">
                                        <ControlTemplate>
                                            <DockPanel LastChildFill="True">
                                                <ContentControl
                                                    Content="{Binding (DataValidationErrors.Errors)}"
                                                    ContentTemplate="{TemplateBinding ErrorTemplate}"
                                                    DataContext="{TemplateBinding Owner}"
                                                    DockPanel.Dock="Right"
                                                    IsVisible="{Binding (DataValidationErrors.HasErrors)}" />
                                                <ContentPresenter
                                                    Name="PART_ContentPresenter"
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    CornerRadius="{TemplateBinding CornerRadius}" />
                                            </DockPanel>
                                        </ControlTemplate>
                                    </Setter>
                                    <Setter Property="ErrorTemplate">
                                        <DataTemplate x:DataType="{x:Type x:Object}">
                                            <Canvas
                                                Width="14"
                                                Height="14"
                                                Margin="4,0,1,0"
                                                Background="Transparent">
                                                <ToolTip.Tip>
                                                    <ItemsControl ItemsSource="{Binding}" />
                                                </ToolTip.Tip>
                                                <Path
                                                    Data="M14,7 A7,7 0 0,0 0,7 M0,7 A7,7 0 1,0 14,7 M7,3l0,5 M7,9l0,2"
                                                    Stroke="Red"
                                                    StrokeThickness="2" />
                                            </Canvas>
                                        </DataTemplate>
                                    </Setter>
                                </Style>
                            </TextBox.Styles>
                        </TextBox>
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>

                <ui:FASettingsExpanderItem>
                    <dns:DnsListEditor DataContext="{x:Static vm:DnsListEditorViewModel.ServerList}" />
                </ui:FASettingsExpanderItem>

                <TextBlock
                    Margin="-28,0,0,-4"
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    Text="{x:Static spp:Strings.L10nAccel_029}" />

                <ui:FASettingsExpanderItem Content="{x:Static spp:Strings.L10nAccel_001}">
                    <ui:FASettingsExpanderItem.Footer>
                        <Grid>
                            <ui:FAProgressRing
                                Width="22"
                                Margin="0,-4,0,-10"
                                IsVisible="{Binding IsDNSChecking}" />
                            <SelectableTextBlock IsVisible="{Binding !IsDNSChecking}" Text="{Binding DNSTestDelay}" />
                        </Grid>
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>

                <ui:FASettingsExpanderItem Content="{x:Static spp:Strings.L10nAccel_030}">
                    <ui:FASettingsExpanderItem.Footer>
                        <Grid>
                            <ui:FAProgressRing
                                Width="22"
                                Margin="0,-4,0,-10"
                                IsVisible="{Binding IsDNSChecking}" />
                            <SelectableTextBlock IsVisible="{Binding !IsDNSChecking}" Text="{Binding DNSTestResult}" />
                        </Grid>
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
            </ui:FASettingsExpander>

            <!--  IPV6  -->
            <ui:FASettingsExpander Header="{x:Static spp:Strings.L10nAccel_031}" IsExpanded="True">
                <ui:FASettingsExpander.IconSource>
                    <ui:FAFontIconSource FontFamily="Segoe Fluent Icons" Glyph="&#xE968;" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpander.Footer>
                    <Button
                        Width="100"
                        Command="{Binding IPv6CheckCommand}"
                        Content="{x:Static spp:Strings.L10nAccel_012}" />
                </ui:FASettingsExpander.Footer>

                <ui:FASettingsExpanderItem Content="{x:Static spp:Strings.L10nAccel_032}">
                    <ui:FASettingsExpanderItem.Footer>
                        <Grid>
                            <ui:FAProgressRing
                                Width="22"
                                Margin="0,-4,0,-10"
                                IsVisible="{Binding IsIPv6Checking}" />
                            <Grid IsVisible="{Binding !IsIPv6Checking}">
                                <TextBlock
                                    Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                    IsVisible="{Binding IsSupportIPv6}"
                                    Text="{x:Static spp:Strings.L10nAccel_033}" />
                                <TextBlock
                                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                    IsVisible="{Binding !IsSupportIPv6}"
                                    Text="{x:Static spp:Strings.L10nAccel_034}" />
                            </Grid>
                        </Grid>
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>

                <ui:FASettingsExpanderItem Content="{x:Static spp:Strings.L10nAccel_035}">
                    <ui:FASettingsExpanderItem.Footer>
                        <Grid>
                            <ui:FAProgressRing
                                Width="22"
                                Margin="0,-4,0,-10"
                                IsVisible="{Binding IsIPv6Checking}" />
                            <SelectableTextBlock
                                Foreground="Gray"
                                IsVisible="{Binding !IsIPv6Checking}"
                                Text="{Binding IPv6Address}" />
                        </Grid>
                    </ui:FASettingsExpanderItem.Footer>
                </ui:FASettingsExpanderItem>
            </ui:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>

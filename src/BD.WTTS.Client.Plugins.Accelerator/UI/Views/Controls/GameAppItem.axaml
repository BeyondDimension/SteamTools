<UserControl
    x:Class="BD.WTTS.UI.Views.Controls.GameAppItem"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://steampp.net/services"
    xmlns:spp="https://steampp.net/ui"
    d:DesignHeight="160"
    d:DesignWidth="220"
    x:DataType="spp:XunYouGameViewModel"
    mc:Ignorable="d">
    <UserControl.Styles>
        <Style Selector="Button#ActionBtn">
            <Setter Property="IsVisible" Value="{Binding Source={x:Static s:GameAcceleratorService.Current}, Path=!CurrentAcceleratorGame?.IsAccelerating, FallbackValue=True, TargetNullValue=True}" />
        </Style>
        <Style Selector="Grid.Accelerating Button#ActionBtn">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="IsEnabled" Value="False" />
        </Style>
        <Style Selector="Grid.Accelerator Panel.AppName TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Grid.UnAccelerator Panel.AppName TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style Selector="Grid.Accelerator Panel.AppName">
            <Setter Property="Grid.ColumnSpan" Value="2" />
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="Grid.UnAccelerator Panel.AppName">
            <Setter Property="Grid.Row" Value="2" />
        </Style>
        <Style Selector="Grid Panel.AppName TextBlock.LeftMargin">
            <Setter Property="Margin" Value="25 0 0 0" />
        </Style>
        <Style Selector="spp|GameAppItem:pointerover spp|Image2.Scale">
            <Setter Property="RenderTransform" Value="scale(1.1)" />
        </Style>

        <Style Selector="spp|GameAppItem spp|Image2.Scale">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="spp|GameAppItem Border#LayoutRoot:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BoxShadow" Value="{StaticResource InfoBoxShadow}" />
        </Style>

        <Style Selector="spp|GameAppItem Border#ShadowBox">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="spp|GameAppItem:pointerover Border#ShadowBox">
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="spp|GameAppItem:pointerover Border#ShadowBox, Border#ShadowBox:focus-within">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <!--<Style Selector="spp|GameAppItem Border.Status">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        </Style>-->
    </UserControl.Styles>
    <Border
        Name="LayoutRoot"
        MinHeight="160"
        Background="{DynamicResource ControlFillColorDefaultBrush}"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        ClipToBounds="True"
        CornerRadius="{StaticResource OverlayCornerRadius}">
        <spp:RippleEffect>
            <Grid
                Classes.Accelerating="{Binding IsAccelerating}"
                Classes.Accelerator="{Binding IsAccelerated}"
                Classes.UnAccelerator="{Binding !IsAccelerated}"
                ColumnDefinitions="*,Auto"
                RowDefinitions="30,*,48">
                <Viewbox
                    Grid.RowSpan="2"
                    Grid.ColumnSpan="2"
                    Stretch="UniformToFill">
                    <spp:Image2
                        DecodeWidth="300"
                        FallbackSource="avares://BD.WTTS.Client.Plugins.Accelerator/UI/Assets/defaultBackground.png"
                        Source="{Binding PicInfo.Small.Url}"
                        Stretch="UniformToFill" />
                </Viewbox>

                <!--<spp:Image2
                    Grid.RowSpan="2"
                    Grid.ColumnSpan="2"
                    Margin="10,0,50,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    DecodeWidth="250"
                    Source="{Binding LogoUrl}"
                    Stretch="Uniform" />-->

                <Border
                    Name="ShadowBox"
                    Grid.RowSpan="2"
                    Grid.ColumnSpan="2"
                    Padding="5"
                    Background="#80000000">
                    <Button
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Classes="Plain"
                        Command="{Binding Path=DeleteMyGameCommand, Source={x:Static s:GameAcceleratorService.Current}}"
                        CommandParameter="{Binding}"
                        Cursor="Hand"
                        IsVisible="{Binding !IsAccelerating}"
                        ToolTip.Tip="{x:Static spp:Strings.Delete}">
                        <Viewbox Width="20" Height="20">
                            <PathIcon
                                Classes="CloseIcon"
                                Foreground="White" />
                        </Viewbox>
                    </Button>
                </Border>

                <Panel Margin="10,5" Classes="AppName">
                    <!--  spp:Animations.EnableAnimations2="True"  -->
                    <spp:Image2
                        Name="AppIcon"
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        DecodeWidth="20"
                        IsVisible="{Binding !$self.IsFailed}"
                        Source="{Binding PicInfo.Icon.Url}">
                        <spp:Image2.Transitions>
                            <Transitions>
                                <DoubleTransition
                                    Easing="0,0 0,1"
                                    Property="Width"
                                    Duration="00:00:00.25" />
                                <DoubleTransition
                                    Easing="0,0 0,1"
                                    Property="Height"
                                    Duration="00:00:00.25" />
                            </Transitions>
                        </spp:Image2.Transitions>
                    </spp:Image2>
                    <TextBlock
                        VerticalAlignment="Center"
                        Classes.LeftMargin="{Binding !#AppIcon.IsFailed}"
                        MaxLines="2"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis" />
                </Panel>

                <Border
                    Grid.Row="2"
                    Margin="10,5"
                    Classes="Status"
                    IsVisible="{Binding IsAccelerated}">
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Text="{Binding SelectedArea?.Name}" />
                        <DockPanel>
                            <Ellipse
                                Width="6"
                                Height="6"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Left"
                                Fill="{Binding PingValue, Converter={x:Static spp:GameAppItem.PingBrushConverter}, FallbackValue=#FF4F58}" />
                            <TextBlock
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right"
                                FontSize="12"
                                Foreground="{Binding PingValue, Converter={x:Static spp:GameAppItem.PingBrushConverter}}"
                                Text="{Binding PingValue}" />
                        </DockPanel>
                    </WrapPanel>
                </Border>

                <ProgressBar
                    Grid.Row="2"
                    Grid.Column="1"
                    Width="20"
                    Height="20"
                    Margin="10,5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Classes="Circle"
                    IsIndeterminate="True"
                    IsVisible="{Binding IsAccelerating}" />

                <Button
                    Name="ActionBtn"
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="10,5"
                    Command="{Binding $parent[spp:GameAppItem].ButtonCommand}"
                    CommandParameter="{Binding}"
                    Content="{Binding IsAccelerated, Converter={x:Static spp:GameAppItem.AccelerateOrStopTextConverter}, FallbackValue={x:Static spp:Strings.GameAccelerator_Accelerate}}" />
            </Grid>
        </spp:RippleEffect>
    </Border>
</UserControl>

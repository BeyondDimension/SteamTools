<UserControl
    x:Class="BD.WTTS.UI.Views.Controls.AcceleratorPathAskBox"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:s="https://steampp.net/services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="using:Avalonia.Xaml.Interactivity"
    xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ms="https://steampp.net/settings"
    xmlns:spp="https://steampp.net/ui"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    MinWidth="380"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <StackPanel Spacing="15">
        <TextBlock
            HorizontalAlignment="Center"
            FontSize="21"
            TextAlignment="Center">
            <Run Text="{x:Static spp:Strings.L10nAccel_041}" />
            <LineBreak />
            <Run Text="{x:Static spp:Strings.L10nAccel_042}" />
        </TextBlock>

        <ui:FASettingsExpander
            x:Name="PathSelect"
            Description="{Binding Source={x:Static ms:GameAcceleratorSettings.WattAcceleratorDirPath}, Path=Value}"
            Header="{x:Static spp:Strings.L10nAccel_043}"
            IsClickEnabled="True"
            IsVisible="False">
            <ui:FASettingsExpander.IconSource>
                <ui:FAFontIconSource FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE188;" />
            </ui:FASettingsExpander.IconSource>
            <ui:FASettingsExpander.Footer>
                <Button Click="SelectWattAcceleratorInstallPath" Content="{x:Static spp:Strings.LocalAuth_ExportAuth_SelectPath}" />
            </ui:FASettingsExpander.Footer>
        </ui:FASettingsExpander>

        <!--<TextBlock Text="需要下载 Watt 加速器插件才可使用，确定要下载吗?" />-->

        <Panel>
            <Button
                Margin="0,15"
                Padding="20,10"
                HorizontalAlignment="Center"
                Classes="TransparentAccent"
                Click="OKButton_Click"
                Content="{x:Static spp:Strings.L10nAccel_044}"
                FontSize="14" />

            <Button
                Margin="10,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Click="CustomInstallButton_Click"
                Theme="{StaticResource TransparentButton}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="{x:Static spp:Strings.L10nAccel_045}" />
                    <ui:FAFontIcon Glyph="&#xE70D;" IsVisible="{Binding !#PathSelect.IsVisible}" />
                    <ui:FAFontIcon Glyph="&#xE70E;" IsVisible="{Binding #PathSelect.IsVisible}" />
                </StackPanel>
            </Button>
        </Panel>
    </StackPanel>
</UserControl>

<spp:PageBase
    x:Class="BD.WTTS.UI.Views.Pages.ASFSettingsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ms="https://steampp.net/settings"
    xmlns:s="https://steampp.net/services"
    xmlns:spp="https://steampp.net/ui"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    Title="{x:Static spp:Strings.L10nAsf_Text008}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="spp:ASFSettingsPageViewModel"
    Description="{x:Static spp:Strings.L10nAsf_Text105}"
    Subtitle="{Binding Author, Source={x:Static s:Plugin.Instance}, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter=Plugin_Author}"
    mc:Ignorable="d">
    <spp:PageBase.PreviewImage>
        <ui:FAImageIconSource Source="{Binding Icon, Source={x:Static s:Plugin.Instance}, Mode=OneWay, Converter={StaticResource BitmapAssetValueConverter}}" />
    </spp:PageBase.PreviewImage>
    <spp:PageBase.ActionContent>
        <StackPanel Orientation="Horizontal" Spacing="2">
            <Button
                Padding="8,4"
                Command="{Binding SelectGlobalFiles}"
                DockPanel.Dock="Right"
                Theme="{StaticResource TransparentButton}">
                <Panel>
                    <Viewbox
                        Width="16"
                        Height="16"
                        HorizontalAlignment="Left">
                        <ui:FASymbolIcon Symbol="Import" />
                    </Viewbox>
                    <TextBlock
                        Margin="28,4,0,4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="{x:Static spp:Strings.L10nAsf_Text009}" />
                </Panel>
            </Button>
            <Button
                Padding="8,4"
                Command="{Binding SetEncryptionKey}"
                DockPanel.Dock="Right"
                Theme="{StaticResource TransparentButton}">
                <Panel>
                    <Viewbox
                        Width="16"
                        Height="16"
                        HorizontalAlignment="Left">
                        <ui:FASymbolIcon Symbol="Settings" />
                    </Viewbox>
                    <TextBlock
                        Margin="28,4,0,4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="{x:Static spp:Strings.L10nAsf_Text010}" />
                </Panel>
            </Button>
            <Button
                Padding="8,4"
                Command="{Binding RefreshGlobalConfig}"
                DockPanel.Dock="Right"
                Theme="{StaticResource TransparentButton}">
                <Panel>
                    <Viewbox
                        Width="16"
                        Height="16"
                        HorizontalAlignment="Left">
                        <ui:FASymbolIcon Symbol="Refresh" />
                    </Viewbox>
                    <TextBlock
                        Margin="28,4,0,4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="{x:Static spp:Strings.L10nAsf_Text011}" />
                </Panel>
            </Button>
        </StackPanel>
    </spp:PageBase.ActionContent>
    <spp:ContentLoader IsLoading="False">

        <StackPanel Spacing="{StaticResource SettingsSpacing}">
            <TextBlock
                Margin="0,0,0,10"
                Text="{x:Static spp:Strings.L10nAsf_Text012}"
                Theme="{StaticResource SubtitleTextBlockStyle}" />
            <ui:FASettingsExpander
                Header="{x:Static spp:Strings.L10nAsf_Text013}"
                IconSource="Globe"
                IsClickEnabled="False"
                IsExpanded="True">
                <ui:FASettingsExpander.IconSource>
                    <ui:FAFontIconSource FontFamily="Segoe Fluent Icons" Glyph="&#xE7F1;" />
                </ui:FASettingsExpander.IconSource>
                <ui:FASettingsExpander.Footer>
                    <Button
                        Command="{Binding OpenASFFolder}"
                        CommandParameter="ASF"
                        Content="{x:Static spp:Strings.L10nAsf_Text014}" />
                </ui:FASettingsExpander.Footer>

                <ui:FASettingsExpanderItem
                    ActionIconSource="Open"
                    Command="{Binding OpenASFFolder}"
                    CommandParameter="config"
                    Content="{x:Static spp:Strings.L10nAsf_Text015}"
                    IsClickEnabled="True"
                    ToolTip.Tip="{Binding Path=., Mode=OneTime, Source={x:Static spp:Strings.Settings_General_BrowseCustomFolder}, Converter={StaticResource StringFormatConverter}, ConverterParameter=config}" />
                <ui:FASettingsExpanderItem
                    ActionIconSource="Open"
                    Command="{Binding OpenASFFolder}"
                    CommandParameter="plugin"
                    Content="{x:Static spp:Strings.L10nAsf_Text016}"
                    IsClickEnabled="True"
                    ToolTip.Tip="{Binding Path=., Mode=OneTime, Source={x:Static spp:Strings.Settings_General_BrowseCustomFolder}, Converter={StaticResource StringFormatConverter}, ConverterParameter=plugin}" />
                <ui:FASettingsExpanderItem
                    ActionIconSource="Open"
                    Command="{Binding OpenASFFolder}"
                    CommandParameter="Logs"
                    Content="{x:Static spp:Strings.L10nAsf_Text017}"
                    IsClickEnabled="True"
                    ToolTip.Tip="{Binding Path=., Mode=OneTime, Source={x:Static spp:Strings.Settings_General_BrowseCustomFolder}, Converter={StaticResource StringFormatConverter}, ConverterParameter=Logs}" />
                <ui:FASettingsExpanderItem
                    ActionIconSource="Open"
                    Command="{Binding OpenASFFolder}"
                    CommandParameter="www"
                    Content="{x:Static spp:Strings.L10nAsf_Text018}"
                    IsClickEnabled="True"
                    ToolTip.Tip="{Binding Path=., Mode=OneTime, Source={x:Static spp:Strings.Settings_General_BrowseCustomFolder}, Converter={StaticResource StringFormatConverter}, ConverterParameter=www}" />
            </ui:FASettingsExpander>

            <!--<spp:OptionsDisplayItem Header="ASF 文件路径">
                <spp:OptionsDisplayItem.Description>
                    <TextBlock
                        MaxWidth="120"
                        MaxLines="1"
                        Text="{Binding Source={x:Static ms:ASFSettings.ArchiSteamFarmExePath}, Path=Value, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </spp:OptionsDisplayItem.Description>
                <spp:OptionsDisplayItem.Icon>
                    <ui:FAFontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE756;" />
                </spp:OptionsDisplayItem.Icon>
                <spp:OptionsDisplayItem.ActionButton>
                    <Button Command="{Binding SelectASFExePath}" Content="选择路径" />
                </spp:OptionsDisplayItem.ActionButton>
            </spp:OptionsDisplayItem>-->

            <spp:OptionsDisplayItem Header="{x:Static spp:Strings.L10nAsf_Text019}">
                <spp:OptionsDisplayItem.Icon>
                    <ui:FAFontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE770;" />
                </spp:OptionsDisplayItem.Icon>
                <spp:OptionsDisplayItem.ActionButton>
                    <ToggleSwitch Classes="LeftContent" IsChecked="{Binding Source={x:Static ms:ASFSettings.AutoRunArchiSteamFarm}, Path=Value, Mode=TwoWay}" />
                </spp:OptionsDisplayItem.ActionButton>
            </spp:OptionsDisplayItem>

            <spp:OptionsDisplayItem Header="{x:Static spp:Strings.L10nAsf_Text020}">
                <spp:OptionsDisplayItem.Icon>
                    <ui:FAFontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE83D;" />
                </spp:OptionsDisplayItem.Icon>
                <spp:OptionsDisplayItem.ActionButton>
                    <ToggleSwitch Classes="LeftContent" IsChecked="{Binding Source={x:Static ms:ASFSettings.CheckArchiSteamFarmExe}, Path=Value, Mode=TwoWay}" />
                </spp:OptionsDisplayItem.ActionButton>
            </spp:OptionsDisplayItem>

            <spp:OptionsDisplayItem Header="{x:Static spp:Strings.L10nAsf_Text021}">
                <spp:OptionsDisplayItem.Icon>
                    <ui:FAFontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE704;" />
                </spp:OptionsDisplayItem.Icon>
                <spp:OptionsDisplayItem.ActionButton>
                    <ui:FANumberBox Minimum="5000" Value="{Binding Source={x:Static ms:ASFSettings.IPCPortId}, Path=Value, Mode=TwoWay}" />
                </spp:OptionsDisplayItem.ActionButton>
            </spp:OptionsDisplayItem>

            <spp:OptionsDisplayItem Header="{x:Static spp:Strings.L10nAsf_Text022}">
                <spp:OptionsDisplayItem.Icon>
                    <ui:FAFontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE770;" />
                </spp:OptionsDisplayItem.Icon>
                <spp:OptionsDisplayItem.ActionButton>
                    <ToggleSwitch Classes="LeftContent" IsChecked="{Binding Source={x:Static ms:ASFSettings.IPCPortOccupiedRandom}, Path=Value, Mode=TwoWay}" />
                </spp:OptionsDisplayItem.ActionButton>
            </spp:OptionsDisplayItem>

            <spp:OptionsDisplayItem Header="{x:Static spp:Strings.L10nAsf_Text023}">
                <spp:OptionsDisplayItem.Icon>
                    <ui:FAFontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF2B7;" />
                </spp:OptionsDisplayItem.Icon>
                <spp:OptionsDisplayItem.ActionButton>
                    <ui:FANumberBox Minimum="1" Value="{Binding Source={x:Static ms:ASFSettings.ConsoleMaxLine}, Path=Value, Mode=TwoWay}" />
                </spp:OptionsDisplayItem.ActionButton>
            </spp:OptionsDisplayItem>

            <spp:OptionsDisplayItem Header="{x:Static spp:Strings.L10nAsf_Text024}">
                <spp:OptionsDisplayItem.Icon>
                    <ui:FAFontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8E9;" />
                </spp:OptionsDisplayItem.Icon>
                <spp:OptionsDisplayItem.ActionButton>
                    <ui:FANumberBox Minimum="1" Value="{Binding Source={x:Static ms:ASFSettings.ConsoleFontSize}, Path=Value, Mode=TwoWay}" />
                </spp:OptionsDisplayItem.ActionButton>
            </spp:OptionsDisplayItem>

        </StackPanel>
    </spp:ContentLoader>
</spp:PageBase>

<UserControl
    x:Class="BD.WTTS.UI.Views.Controls.ArchiSteamFarmExePathSettingsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ms="https://steampp.net/settings"
    xmlns:s="https://steampp.net/services"
    xmlns:spp="https://steampp.net/ui"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:CompileBindings="True"
    x:DataType="spp:ArchiSteamFarmExePathSettingsPageViewModel"
    mc:Ignorable="d">
    <StackPanel Margin="{StaticResource PageMargin}" Spacing="{StaticResource SettingsSpacing}">
        <TextBlock Margin="0,0,0,5" Text="{x:Static spp:Strings.L10nAsf_Text001}" />
        <ui:FASettingsExpander
            Description="{Binding Source={x:Static ms:ASFSettings.ArchiSteamFarmExePath}, Path=Value, Mode=OneWay}"
            Header="{x:Static spp:Strings.L10nAsf_Text002}"
            IsClickEnabled="True">
            <ui:FASettingsExpander.IconSource>
                <ui:FAFontIconSource FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE188;" />
            </ui:FASettingsExpander.IconSource>
            <ui:FASettingsExpander.Footer>
                <Button Command="{Binding SelectProgramPath}" Content="{x:Static spp:Strings.L10nAsf_Text003}" />
            </ui:FASettingsExpander.Footer>
        </ui:FASettingsExpander>
        <ui:FASettingsExpander
            Description="{x:Static spp:Strings.L10nAsf_Text004}"
            Header="{x:Static spp:Strings.L10nAsf_Text005}"
            IsClickEnabled="True">
            <ui:FASettingsExpander.IconSource>
                <ui:FAFontIconSource FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE896;" />
            </ui:FASettingsExpander.IconSource>
            <ui:FASettingsExpander.Footer>
                <Button Command="{Binding DownloadASF}" Content="{x:Static spp:Strings.L10nAsf_Text006}" />
            </ui:FASettingsExpander.Footer>
        </ui:FASettingsExpander>
    </StackPanel>
</UserControl>

<UserControl
	x:Class="BD.WTTS.UI.Views.Pages.IdleSteamLoginPage"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:spp="https://steampp.net/ui"
	x:CompileBindings="True"
	x:DataType="spp:IdleSteamLoginPageViewModel">
	<spp:SteamLoginView DataContext="{Binding Login}" ShowRememberLogin="True"
	                    RememberLogin="{Binding $parent[spp:IdleSteamLoginPage].((spp:IdleSteamLoginPageViewModel)DataContext).Login.RememberLogin, Mode=TwoWay}" />
</UserControl>
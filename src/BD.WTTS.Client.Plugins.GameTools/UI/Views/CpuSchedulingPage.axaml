<spp:PageBase
    x:Class="BD.WTTS.UI.Views.Pages.CpuSchedulingPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:spp="https://steampp.net/ui"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    x:DataType="spp:CpuSchedulingPageViewModel"
    Title="{x:Static spp:Strings.GameTools_Cpu_Title}">
    <spp:PageBase.PreviewImage>
        <ui:FAImageIconSource Source="avares://BD.WTTS.Client.Plugins.GameTools/UI/Assets/CPU.png" />
    </spp:PageBase.PreviewImage>
    <TabControl Margin="12">
        <TabItem Header="{x:Static spp:Strings.GameTools_Cpu_Processes}">
            <Grid Margin="0,8,0,0" ColumnDefinitions="*,12,*">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                    <StackPanel Spacing="4">
                        <TextBox
                            AutomationProperties.Name="{x:Static spp:Strings.GameTools_Cpu_Search}"
                            Text="{Binding Search}"
                            PlaceholderText="{x:Static spp:Strings.GameTools_Cpu_Search}" />
                        <WrapPanel>
                            <CheckBox Content="{x:Static spp:Strings.GameTools_Cpu_WindowsOnly}" IsChecked="{Binding WindowedOnly}" />
                            <Button
                                x:Name="WindowPicker"
                                Content="{x:Static spp:Strings.GameTools_Cpu_PickWindow}"
                                IsEnabled="{Binding RulesAreEditable}" />
                        </WrapPanel>
                    </StackPanel>
                    <Grid
                        Grid.Row="1"
                        Margin="8,0,14,0"
                        ColumnDefinitions="2.5*,0.85*,1.1*,1.2*,1.1*"
                        ColumnSpacing="4">
                        <TextBlock Text="{x:Static spp:Strings.GameTools_Cpu_Process}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{x:Static spp:Strings.GameTools_Cpu_ProcessorUsage}" />
                        <TextBlock Grid.Column="2" Text="{x:Static spp:Strings.GameTools_Cpu_Memory}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" Text="{x:Static spp:Strings.GameTools_Cpu_Priority}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="4" Text="{x:Static spp:Strings.GameTools_Cpu_Affinity}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <ListBox
                        Grid.Row="2"
                        ItemsSource="{Binding Processes}"
                        SelectedItem="{Binding SelectedProcess, Mode=TwoWay}"
                        SelectionChanged="ProcessSelectionChanged">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="spp:CpuProcessRow">
                                <Grid
                                    Margin="0,2"
                                    ColumnDefinitions="2.5*,0.85*,1.1*,1.2*,1.1*"
                                    ColumnSpacing="4"
                                    RowDefinitions="Auto,Auto"
                                    ToolTip.Tip="{Binding ImagePath}">
                                    <Grid ColumnDefinitions="20,*" ColumnSpacing="6">
                                        <Image Width="18" Height="18" Source="{Binding Icon}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Pid}" Theme="{StaticResource CaptionTextBlockStyle}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding CpuUsage}" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding Memory}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{Binding Priority}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="{Binding Affinity}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.ColumnSpan="5"
                                        IsVisible="{Binding HasStatus}"
                                        Text="{Binding Status}"
                                        TextTrimming="CharacterEllipsis"
                                        Theme="{StaticResource CaptionTextBlockStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock
                        Grid.Row="2"
                        Margin="8"
                        IsHitTestVisible="False"
                        IsVisible="{Binding HasNoProcesses}"
                        Text="{x:Static spp:Strings.GameTools_Cpu_NoProcesses}"
                        TextWrapping="Wrap" />
                </Grid>

                <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,8,8" Spacing="12">
                        <TextBlock
                            IsVisible="{Binding HasNoProcess}"
                            Text="{x:Static spp:Strings.GameTools_Cpu_SelectProcess}"
                            TextWrapping="Wrap" />
                        <StackPanel IsVisible="{Binding HasProcess}" Spacing="8">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding SelectedProcess.Name}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedProcess.ImagePath}" TextWrapping="Wrap" Theme="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock Text="{Binding SelectedProcess.Status}" TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                <TextBlock VerticalAlignment="Center" Text="{x:Static spp:Strings.GameTools_Cpu_Priority}" />
                                <ComboBox
                                    Grid.Column="1"
                                    MinWidth="144"
                                    AutomationProperties.Name="{x:Static spp:Strings.GameTools_Cpu_Priority}"
                                    IsEnabled="{Binding CanEdit}"
                                    ItemsSource="{Binding Priorities}"
                                    SelectedItem="{Binding SelectedPriority, Mode=TwoWay}"
                                    SelectionChanged="PrioritySelectionChanged" />
                                <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="{x:Static spp:Strings.GameTools_Cpu_Eco}" />
                                <ComboBox
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    MinWidth="144"
                                    AutomationProperties.Name="{x:Static spp:Strings.GameTools_Cpu_Eco}"
                                    IsEnabled="{Binding CanEditEco}"
                                    ItemsSource="{Binding EcoModes}"
                                    SelectedItem="{Binding SelectedEcoMode, Mode=TwoWay}" />
                                <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="{x:Static spp:Strings.GameTools_Cpu_MemoryPriority}" />
                                <ComboBox
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    MinWidth="144"
                                    AutomationProperties.Name="{x:Static spp:Strings.GameTools_Cpu_MemoryPriority}"
                                    IsEnabled="{Binding CanEditMemory}"
                                    ItemsSource="{Binding MemoryPriorities}"
                                    SelectedItem="{Binding SelectedMemoryPriority, Mode=TwoWay}" />
                            </Grid>
                            <StackPanel IsVisible="{Binding NeedsRealtimeConfirmation}" Spacing="4">
                                <TextBlock Text="{x:Static spp:Strings.GameTools_Cpu_RealtimeWarning}" TextWrapping="Wrap" />
                                <CheckBox x:Name="RealtimeConfirm" Content="{x:Static spp:Strings.GameTools_Cpu_RealtimeConfirm}" />
                            </StackPanel>
                            <WrapPanel IsEnabled="{Binding CanEdit}">
                                <Button Margin="0,0,6,4" Click="Apply_Click" Content="{x:Static spp:Strings.GameTools_Cpu_Apply}" />
                                <Button Margin="0,0,6,4" Click="Restore_Click" Content="{x:Static spp:Strings.GameTools_Cpu_Restore}" />
                                <Button Margin="0,0,6,4" Click="Reload_Click" Content="{x:Static spp:Strings.GameTools_Cpu_RefreshEditor}" />
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock FontWeight="SemiBold" Text="{x:Static spp:Strings.GameTools_Cpu_Topology}" />
                            <TextBlock
                                IsVisible="{Binding HasNoTopology}"
                                Text="{x:Static spp:Strings.GameTools_Cpu_TopologyUnavailable}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                IsVisible="{Binding HasMultipleGroups}"
                                Text="{x:Static spp:Strings.GameTools_Cpu_MultiGroup}"
                                TextWrapping="Wrap" />
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="{x:Static spp:Strings.GameTools_Cpu_Presets}"
                                IsEnabled="{Binding CanEditAffinity}"
                                IsVisible="{Binding HasTopology}"
                                ItemsSource="{Binding Presets}"
                                PlaceholderText="{x:Static spp:Strings.GameTools_Cpu_Presets}"
                                SelectionChanged="PresetSelected" />
                            <ItemsControl IsEnabled="{Binding CanEditAffinity}" ItemsSource="{Binding CoreGrid}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="spp:CpuCoreRow">
                                        <Border
                                            MinWidth="132"
                                            Margin="0,0,6,6"
                                            Padding="6"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{Binding Label}" Theme="{StaticResource CaptionTextBlockStyle}" />
                                                <ItemsControl ItemsSource="{Binding Tiles}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="3" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="spp:CpuTile">
                                                            <ToggleButton
                                                                Padding="6,4"
                                                                Content="{Binding Label}"
                                                                IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel IsEnabled="{Binding CanEdit}" IsVisible="{Binding HasProcess}" Spacing="6">
                            <Separator />
                            <CheckBox
                                x:Name="MatchFullPath"
                                Content="{x:Static spp:Strings.GameTools_Cpu_MatchPath}"
                                IsChecked="True"
                                IsEnabled="{Binding CanMatchPath}" />
                            <Button Click="SaveRule_Click" Content="{x:Static spp:Strings.GameTools_Cpu_SaveRule}" />
                            <TextBlock Margin="0,6,0,0" FontWeight="SemiBold" Text="{x:Static spp:Strings.GameTools_Cpu_Templates}" TextWrapping="Wrap" />
                            <Button Click="GameRule_Click">
                                <TextBlock Text="{x:Static spp:Strings.GameTools_Cpu_GameTemplate}" TextWrapping="Wrap" />
                            </Button>
                            <Button Click="BackgroundRule_Click">
                                <TextBlock Text="{x:Static spp:Strings.GameTools_Cpu_BackgroundTemplate}" TextWrapping="Wrap" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </TabItem>

        <TabItem Header="{x:Static spp:Strings.GameTools_Cpu_Rules}">
            <ScrollViewer Margin="0,8,0,0">
                <StackPanel IsEnabled="{Binding RulesAreEditable}" Spacing="8">
                    <CheckBox
                        Click="DisableAll_Click"
                        Content="{x:Static spp:Strings.GameTools_Cpu_DisableAll}"
                        IsChecked="{Binding DisableAllRules, Mode=OneWay}" />
                    <TextBlock Text="{x:Static spp:Strings.GameTools_Cpu_RuleHelp}" TextWrapping="Wrap" />
                    <TextBlock IsVisible="{Binding HasNoRules}" Text="{x:Static spp:Strings.GameTools_Cpu_NoRules}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Rules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="spp:CpuRuleRow">
                                <Grid Margin="0,4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Theme="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Click="ToggleRule_Click" Content="{Binding ToggleLabel}" />
                                    <Button Grid.Column="2" Click="RemoveRule_Click" Content="{x:Static spp:Strings.GameTools_Cpu_RemoveRule}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</spp:PageBase>

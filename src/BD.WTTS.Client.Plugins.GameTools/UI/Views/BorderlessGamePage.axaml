<spp:PageBase
    x:Class="BD.WTTS.UI.Views.Pages.BorderlessGamePage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="using:Avalonia.Xaml.Interactivity"
    xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://steampp.net/services"
    xmlns:spp="https://steampp.net/ui"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    Title="{x:Static spp:Strings.L10nGames_BorderlessTitle}"
    d:DesignHeight="850"
    d:DesignWidth="800"
    x:CompileBindings="True"
    x:DataType="spp:BorderlessGamePageViewModel"
    Description="{x:Static spp:Strings.L10nGames_BorderlessDescription}"
    Subtitle="{Binding Author, Source={x:Static s:Plugin.Instance}, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter=Plugin_Author}"
    mc:Ignorable="d">
    <spp:PageBase.PreviewImage>
        <ui:FAImageIconSource Source="avares://BD.WTTS.Client.Plugins.GameTools/UI/Assets/BorderlessWindow.png" />
    </spp:PageBase.PreviewImage>
    <spp:PageBase.ActionContent>
        <StackPanel Orientation="Horizontal" Spacing="2">
            <ToggleButton
                Padding="8,4"
                DockPanel.Dock="Right"
                IsChecked="{Binding $parent[spp:PageBase].IsPaneOpen, Mode=TwoWay}"
                Theme="{StaticResource TransparentButton}">
                <Panel>
                    <Viewbox
                        Width="16"
                        Height="16"
                        HorizontalAlignment="Left">
                        <ui:FAFontIcon Glyph="&#xE81C;" />
                    </Viewbox>
                    <TextBlock
                        Margin="28,4,0,4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="{x:Static spp:Strings.L10nGames_ViewWindowHistory}" />
                </Panel>
            </ToggleButton>
            <DropDownButton
                Padding="8"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Content="{StaticResource More}"
                FontFamily="{StaticResource SymbolThemeFontFamily}"
                FontSize="20"
                Theme="{StaticResource TransparentButton}">
                <DropDownButton.Flyout>
                    <ui:FAMenuFlyout Placement="BottomEdgeAlignedRight">
                        <!--<ui:FAMenuFlyoutItem x:Name="PluginSettingButton" Text="{x:Static spp:Strings.Settings_Plugin}" />-->
                        <!--<ui:FAMenuFlyoutSeparator  />-->
                        <ui:FAMenuFlyoutItem IsEnabled="False">
                            <ui:FAMenuFlyoutItem.Text>
                                <MultiBinding StringFormat="{}{0}{1}">
                                    <Binding Mode="OneTime" Source="{x:Static spp:Strings.Plugin_Version}" />
                                    <CompiledBindingExtension
                                        Mode="OneWay"
                                        Path="Version"
                                        Source="{x:Static s:Plugin.Instance}" />
                                </MultiBinding>
                            </ui:FAMenuFlyoutItem.Text>
                        </ui:FAMenuFlyoutItem>
                        <!--<ui:FAMenuFlyoutItem Text="{x:Static spp:Strings.ViewInStore}" />
                        <ui:FAMenuFlyoutItem Text="{x:Static spp:Strings.UseHelp}" />
                        <ui:FAMenuFlyoutItem Text="{x:Static spp:Strings.AboutThisPlugin}" />-->
                    </ui:FAMenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </StackPanel>
    </spp:PageBase.ActionContent>
    <spp:PageBase.PaneContent>
        <StackPanel Margin="15,20" Spacing="10">
            <TextBlock
                VerticalAlignment="Center"
                Text="{x:Static spp:Strings.L10nGames_History}"
                Theme="{StaticResource CaptionTextBlockStyle}" />
            <ListBox ItemsSource="{ReflectionBinding WindowList, Mode=OneWay}" SelectedItem="{ReflectionBinding SelectWindow}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" Spacing="5" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock>
                                <Run Text="{ReflectionBinding Name, Mode=OneWay}" />
                                <Run Text="(" />
                                <Run Text="{ReflectionBinding Title, Mode=OneWay}" />
                                <Run Text=")" />
                            </TextBlock>
                        </WrapPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </spp:PageBase.PaneContent>

    <ScrollViewer>
		<StackPanel x:Name="Grid_Menu" MaxWidth="1000" Spacing="8">
			<Border Padding="20" Classes="paper" 
                    Height="180">
				<Grid HorizontalAlignment="Center" VerticalAlignment="Center">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Grid HorizontalAlignment="Center" Grid.Column="0">
						<Image
						  Width="64"
						  HorizontalAlignment="Left"
						  Source="avares://BD.WTTS.Client.Plugins.GameTools/UI/Assets/movecross_hide.png">
						</Image>
						<Image
						  x:Name="move"
						  Width="64"
						  HorizontalAlignment="Left"
						  Source="avares://BD.WTTS.Client.Plugins.GameTools/UI/Assets/movecross.png">
							<i:Interaction.Behaviors>
								<ia:EventTriggerBehavior EventName="PointerPressed" SourceObject="{Binding #move}">
									<ia:InvokeCommandAction Command="{ReflectionBinding $parent[spp:PageBase].((spp:BorderlessGamePageViewModel)DataContext).Cross_MouseDown}" />
								</ia:EventTriggerBehavior>
							</i:Interaction.Behaviors>
						</Image>
					</Grid>
					<TextBlock Grid.Column="1"
						Margin="10"
						VerticalAlignment="Center"
						Text="{x:Static spp:Strings.GameRelated_Borderless_MoveMouseTip}"
						TextWrapping="WrapWithOverflow"/>
				</Grid>
			</Border>

			<Expander IsExpanded="True">
				<Expander.Styles>
					<Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
						<Setter Property="HorizontalContentAlignment" Value="Stretch" />
					</Style>
				</Expander.Styles>
				<Expander.Header>
					<DockPanel>
						<StackPanel Orientation="Horizontal" >
							<ui:FAFontIcon FontSize="26" Margin="0 0 12 0" FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE946;" />
							<TextBlock VerticalAlignment="Center" Text="{x:Static spp:Strings.L10nGames_WindowInfo}" />
							<!--<TextBlock VerticalAlignment="Center" Text="{x:Static spp:Strings.SteamAppType_Game}" />-->
							<!--<TextBlock VerticalAlignment="Center" Text="{x:Static spp:Strings.Info}" />-->
						</StackPanel>
						<Button DockPanel.Dock="Right" HorizontalAlignment="Right" 
								Width="100" Content="{x:Static spp:Strings.Copy}"
								Command="{ReflectionBinding CopyGameInfo_Click}"
								IsEnabled="{ReflectionBinding !!SelectWindow}" />
					</DockPanel>
				</Expander.Header>
				
				<StackPanel>
					<Grid
						HorizontalAlignment="Stretch"
						ColumnDefinitions="Auto,*"
						RowDefinitions="Auto,Auto,Auto,Auto">
						<TextBlock VerticalAlignment="Top" Text="{Binding Source={x:Static spp:Strings.GameRelated_Borderless_Title}, Mode=OneTime, StringFormat={}{0}:}" />
						<SelectableTextBlock
							Grid.Column="1"
							Margin="4,0,0,10"
							Text="{ReflectionBinding SelectWindow?.Title,
											 Mode=OneWay}"
							TextWrapping="WrapWithOverflow" 
							Foreground="Gray" VerticalAlignment="Top" />

						<TextBlock
							Grid.Row="1"
							VerticalAlignment="Top"
							Text="{Binding Source={x:Static spp:Strings.GameRelated_Borderless_Process}, Mode=OneTime, StringFormat={}{0}:}" />
						<SelectableTextBlock
							Grid.Row="1"
							Grid.Column="1"
							Margin="4,0,0,10"
							Text="{ReflectionBinding SelectWindow?.Title,
											 Mode=OneWay}"
							TextWrapping="WrapWithOverflow"
							Foreground="Gray" VerticalAlignment="Top" />

						<TextBlock
							Grid.Row="2"
							VerticalAlignment="Top"
							Text="{Binding Source={x:Static spp:Strings.GameRelated_Borderless_ClassName}, Mode=OneTime, StringFormat={}{0}:}" />
						<SelectableTextBlock
							Grid.Row="2"
							Grid.Column="1"
							Margin="4,0,0,10"
							Text="{ReflectionBinding SelectWindow?.Name,
											 Mode=OneWay}"
							TextWrapping="WrapWithOverflow" 
							Foreground="Gray" VerticalAlignment="Top" />

						<TextBlock
							Grid.Row="3"
							VerticalAlignment="Top"
							Text="{Binding Source={x:Static spp:Strings.GameRelated_Borderless_Path}, Mode=OneTime, StringFormat={}{0}:}" />
						<SelectableTextBlock
							Grid.Row="3"
							Grid.Column="1"
							Margin="4,0,0,10"
							Text="{ReflectionBinding SelectWindow?.Path,
											 Mode=OneWay}"
							TextWrapping="WrapWithOverflow"
							Foreground="Gray" VerticalAlignment="Top" />
					</Grid>

					<Border x:Name="ButtonGroup" Padding="4" Classes="paper" Margin="-16 16 -16 -16"
							Height="200">
						<WrapPanel HorizontalAlignment="Center" Orientation="Horizontal">
							<WrapPanel.Styles>
								<Style Selector="Button">
									<Setter Property="Height" Value="30" />
									<Setter Property="Margin" Value="8" />
									<Setter Property="Width" Value="120" />
								</Style>
							</WrapPanel.Styles>

							<!--Button Group 1-->
							<Button Command="{ReflectionBinding BorderlessWindow_Click}" IsEnabled="{ReflectionBinding !!SelectWindow}">
								<!--<Button.Styles>
									<Style Selector="Button">
										<Setter Property="Background" Value="#0071c7" />
										<Setter Property="Foreground" Value="White" />
									</Style>
									<Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
										<Setter Property="TextElement.Foreground" Value="White" />
										<Setter Property="TextElement.Background" Value="#006abb" />
									</Style>
									<Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
										<Setter Property="Background" Value="#0062ae" />
									</Style>
								</Button.Styles>-->

								<StackPanel Orientation="Horizontal">
									<ui:FAFontIcon Glyph="&#xf58a;" FontFamily="Segoe Fluent Icons" />
									<TextBlock Text="{x:Static spp:Strings.GameRelated_Borderless_BorderlessWindow}"/>
								</StackPanel>
							</Button>
							<Button Command="{ReflectionBinding MaximizeWindow_Click}" IsEnabled="{ReflectionBinding !!SelectWindow}">
								<StackPanel Orientation="Horizontal">
									<ui:FAFontIcon Margin="0 0 4 0" FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE922;" />
									<TextBlock Text="{x:Static spp:Strings.GameRelated_Borderless_Maximize}"/>
								</StackPanel>
							</Button>
							<Button Command="{ReflectionBinding NormalWindow_Click}" IsEnabled="{ReflectionBinding !!SelectWindow}">
								<StackPanel Orientation="Horizontal">
									<ui:FAFontIcon Margin="0 0 4 0" FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE923;" />
									<TextBlock Text="{x:Static spp:Strings.GameRelated_Borderless_Normal}"/>
								</StackPanel>
							</Button>

							<!--Button Group 2-->
							<Button Command="{ReflectionBinding HideWindow_Click}" IsEnabled="{ReflectionBinding !!SelectWindow}">
								<StackPanel Orientation="Horizontal">
									<ui:FAFontIcon Margin="0 0 4 0" FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xed1a;" />
									<TextBlock Text="{x:Static spp:Strings.GameRelated_Borderless_Hide}"/>
								</StackPanel>
							</Button>
							<Button Command="{ReflectionBinding ShowWindow_Click}" IsEnabled="{ReflectionBinding !!SelectWindow}">
								<StackPanel Orientation="Horizontal">
									<ui:FAFontIcon Margin="0 0 4 0" FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xe7b3;" />
									<TextBlock Text="{x:Static spp:Strings.GameRelated_Borderless_Show}"/>
								</StackPanel>
							</Button>

							<!--Button Group 3-->
							<Button
								Command="{ReflectionBinding ToWallerpaperWindow_Click}"
								IsEnabled="{ReflectionBinding !!SelectWindow}"
								ToolTip.Tip="{x:Static spp:Strings.GameRelated_Borderless_ToWallerpaperTip}">
								<StackPanel Orientation="Horizontal">
									<ui:FAFontIcon Margin="0 0 4 0" FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE718;" />
									<TextBlock Text="{x:Static spp:Strings.GameRelated_Borderless_ToWallerpaper}"/>
								</StackPanel>
							</Button>
							<Button Command="{ReflectionBinding ResetWallerpaper_Click}" IsEnabled="{ReflectionBinding !!SelectWindow}">
								<StackPanel Orientation="Horizontal">
									<ui:FAFontIcon Margin="0 0 4 0" FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE72C;" />
									<TextBlock Text="{x:Static spp:Strings.GameRelated_Borderless_ResetWallerpaper}"/>
								</StackPanel>
							</Button>

							<Button Command="{ReflectionBinding WindowKill_Click}" IsEnabled="{ReflectionBinding !!SelectWindow}">
								<Button.Styles>
									<Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
										<Setter Property="TextElement.Foreground" Value="White" />
										<Setter Property="TextElement.Background" Value="Red" />
									</Style>
									<Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
										<Setter Property="Background" Value="#f1707a" />
									</Style>
								</Button.Styles>
								<StackPanel Orientation="Horizontal">
									<ui:FAFontIcon Margin="0 0 4 0" FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8BB;" />
									<TextBlock Text="{x:Static spp:Strings.GameRelated_Borderless_KillProcess}"/>
								</StackPanel>
							</Button>

						</WrapPanel>
					</Border>
				</StackPanel>
			</Expander>
		</StackPanel>

        <!--<TextBlock Text="{Binding Source={x:Static spp:Strings.GameRelated_Borderless_ToWallerpaperTip}, Mode=OneTime, StringFormat=*{0}}" TextWrapping="WrapWithOverflow" />-->
    </ScrollViewer>
</spp:PageBase>

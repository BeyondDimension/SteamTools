<spp:PageBase
    x:Class="BD.WTTS.UI.Views.Pages.BorderlessGamePage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:BD.WTTS.Models"
    xmlns:s="https://steampp.net/services"
    xmlns:spp="https://steampp.net/ui"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    Title="{x:Static spp:Strings.L10nGames_BorderlessTitle}"
    d:DesignHeight="850"
    d:DesignWidth="800"
    x:CompileBindings="True"
    x:DataType="spp:BorderlessGamePageViewModel"
    Description="{x:Static spp:Strings.L10nGames_BorderlessDescription}"
    Subtitle="{Binding Author, Source={x:Static s:Plugin.Instance}, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter=Plugin_Author}"
    mc:Ignorable="d">
    <spp:PageBase.PreviewImage>
        <ui:FAImageIconSource Source="avares://BD.WTTS.Client.Plugins.GameTools/UI/Assets/BorderlessWindow.png" />
    </spp:PageBase.PreviewImage>
    <spp:PageBase.ActionContent>
        <StackPanel Orientation="Horizontal" Spacing="2">
            <ToggleButton
                Padding="8,4"
                DockPanel.Dock="Right"
                IsChecked="{Binding $parent[spp:PageBase].IsPaneOpen, Mode=TwoWay}"
                Theme="{StaticResource TransparentButton}">
                <Panel>
                    <Viewbox
                        Width="16"
                        Height="16"
                        HorizontalAlignment="Left">
                        <ui:FAFontIcon Glyph="&#xE81C;" />
                    </Viewbox>
                    <TextBlock
                        Margin="28,4,0,4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="{x:Static spp:Strings.L10nGames_ViewWindowHistory}" />
                </Panel>
            </ToggleButton>
            <DropDownButton
                Padding="8"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Content="{StaticResource More}"
                FontFamily="{StaticResource SymbolThemeFontFamily}"
                FontSize="20"
                Theme="{StaticResource TransparentButton}">
                <DropDownButton.Flyout>
                    <ui:FAMenuFlyout Placement="BottomEdgeAlignedRight">
                        <!--<ui:FAMenuFlyoutItem x:Name="PluginSettingButton" Text="{x:Static spp:Strings.Settings_Plugin}" />-->
                        <!--<ui:FAMenuFlyoutSeparator  />-->
                        <ui:FAMenuFlyoutItem IsEnabled="False">
                            <ui:FAMenuFlyoutItem.Text>
                                <MultiBinding StringFormat="{}{0}{1}">
                                    <Binding Mode="OneTime" Source="{x:Static spp:Strings.Plugin_Version}" />
                                    <CompiledBindingExtension
                                        Mode="OneWay"
                                        Path="Version"
                                        Source="{x:Static s:Plugin.Instance}" />
                                </MultiBinding>
                            </ui:FAMenuFlyoutItem.Text>
                        </ui:FAMenuFlyoutItem>
                        <!--<ui:FAMenuFlyoutItem Text="{x:Static spp:Strings.ViewInStore}" />
                        <ui:FAMenuFlyoutItem Text="{x:Static spp:Strings.UseHelp}" />
                        <ui:FAMenuFlyoutItem Text="{x:Static spp:Strings.AboutThisPlugin}" />-->
                    </ui:FAMenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </StackPanel>
    </spp:PageBase.ActionContent>
    <spp:PageBase.PaneContent>
        <StackPanel Margin="15,20" Spacing="10">
            <TextBlock
                VerticalAlignment="Center"
                Text="{x:Static spp:Strings.L10nGames_History}"
                Theme="{StaticResource CaptionTextBlockStyle}" />
            <ListBox ItemsSource="{Binding WindowList, Mode=OneWay}" SelectedItem="{Binding SelectWindow, Mode=TwoWay}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" Spacing="5" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:NativeWindowModel">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock>
                                <Run Text="{Binding Name, Mode=OneWay}" />
                                <Run Text="(" />
                                <Run Text="{Binding Title, Mode=OneWay}" />
                                <Run Text=")" />
                            </TextBlock>
                        </WrapPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </spp:PageBase.PaneContent>

    <ScrollViewer>
		<StackPanel x:Name="Grid_Menu" MaxWidth="1000" Spacing="8">
			<Border Padding="20" Classes="paper" 
                    Height="180">
				<Grid HorizontalAlignment="Center" VerticalAlignment="Center">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Grid HorizontalAlignment="Center" Grid.Column="0">
						<Image
						  Width="64"
						  HorizontalAlignment="Left"
						  Source="avares://BD.WTTS.Client.Plugins.GameTools/UI/Assets/movecross_hide.png">
						</Image>
						<Image
						  x:Name="move"
						  Width="64"
						  HorizontalAlignment="Left"
                          IsEnabled="{Binding IsWindowPickingSupported}"
                          Source="avares://BD.WTTS.Client.Plugins.GameTools/UI/Assets/movecross.png" />
					</Grid>
					<TextBlock Grid.Column="1"
						Margin="10"
						VerticalAlignment="Center"
						Text="{x:Static spp:Strings.GameRelated_Borderless_MoveMouseTip}"
						TextWrapping="WrapWithOverflow"/>
				</Grid>
			</Border>

			<Expander IsExpanded="True">
				<Expander.Styles>
					<Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
						<Setter Property="HorizontalContentAlignment" Value="Stretch" />
					</Style>
				</Expander.Styles>
				<Expander.Header>
					<DockPanel>
						<StackPanel Orientation="Horizontal" >
							<ui:FAFontIcon FontSize="26" Margin="0 0 12 0" FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE946;" />
							<TextBlock VerticalAlignment="Center" Text="{x:Static spp:Strings.L10nGames_WindowInfo}" />
							<!--<TextBlock VerticalAlignment="Center" Text="{x:Static spp:Strings.SteamAppType_Game}" />-->
							<!--<TextBlock VerticalAlignment="Center" Text="{x:Static spp:Strings.Info}" />-->
						</StackPanel>
						<Button DockPanel.Dock="Right" HorizontalAlignment="Right" 
								Width="100" Content="{x:Static spp:Strings.Copy}"
								Command="{Binding CopyGameInfoCommand}"
								IsEnabled="{Binding HasSelectedWindow}" />
					</DockPanel>
				</Expander.Header>
				
				<StackPanel>
					<Grid
						HorizontalAlignment="Stretch"
						ColumnDefinitions="Auto,*"
						RowDefinitions="Auto,Auto,Auto,Auto">
						<TextBlock VerticalAlignment="Top" Text="{Binding Source={x:Static spp:Strings.GameRelated_Borderless_Title}, Mode=OneTime, StringFormat={}{0}:}" />
						<SelectableTextBlock
							Grid.Column="1"
							Margin="4,0,0,10"
							Text="{Binding SelectWindow.Title, Mode=OneWay}"
							TextWrapping="WrapWithOverflow" 
							Foreground="Gray" VerticalAlignment="Top" />

						<TextBlock
							Grid.Row="1"
							VerticalAlignment="Top"
							Text="{Binding Source={x:Static spp:Strings.GameRelated_Borderless_Process}, Mode=OneTime, StringFormat={}{0}:}" />
						<SelectableTextBlock
							Grid.Row="1"
							Grid.Column="1"
							Margin="4,0,0,10"
							Text="{Binding SelectWindow.Name, Mode=OneWay}"
							TextWrapping="WrapWithOverflow"
							Foreground="Gray" VerticalAlignment="Top" />

						<TextBlock
							Grid.Row="2"
							VerticalAlignment="Top"
							Text="{Binding Source={x:Static spp:Strings.GameRelated_Borderless_ClassName}, Mode=OneTime, StringFormat={}{0}:}" />
						<SelectableTextBlock
							Grid.Row="2"
							Grid.Column="1"
							Margin="4,0,0,10"
							Text="{Binding SelectWindow.ClassName, Mode=OneWay}"
							TextWrapping="WrapWithOverflow" 
							Foreground="Gray" VerticalAlignment="Top" />

						<TextBlock
							Grid.Row="3"
							VerticalAlignment="Top"
							Text="{Binding Source={x:Static spp:Strings.GameRelated_Borderless_Path}, Mode=OneTime, StringFormat={}{0}:}" />
						<SelectableTextBlock
							Grid.Row="3"
							Grid.Column="1"
							Margin="4,0,0,10"
							Text="{Binding SelectWindow.Path, Mode=OneWay}"
							TextWrapping="WrapWithOverflow"
							Foreground="Gray" VerticalAlignment="Top" />
					</Grid>

					<Border x:Name="ButtonGroup" Padding="4" Classes="paper" Margin="-16 16 -16 -16"
							Height="200">
						<WrapPanel HorizontalAlignment="Center" Orientation="Horizontal">
							<WrapPanel.Styles>
								<Style Selector="Button">
									<Setter Property="Height" Value="30" />
									<Setter Property="Margin" Value="8" />
									<Setter Property="Width" Value="120" />
								</Style>
							</WrapPanel.Styles>

							<!--Button Group 1-->
							<Button Command="{Binding BorderlessWindowCommand}" IsEnabled="{Binding HasSelectedWindow}">
								<!--<Button.Styles>
									<Style Selector="Button">
										<Setter Property="Background" Value="#0071c7" />
										<Setter Property="Foreground" Value="White" />
									</Style>
									<Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
										<Setter Property="TextElement.Foreground" Value="White" />
										<Setter Property="TextElement.Background" Value="#006abb" />
									</Style>
									<Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
										<Setter Property="Background" Value="#0062ae" />
									</Style>
								</Button.Styles>-->

								<StackPanel Orientation="Horizontal">
									<ui:FAFontIcon Glyph="&#xf58a;" FontFamily="Segoe Fluent Icons" />
									<TextBlock Text="{x:Static spp:Strings.GameRelated_Borderless_BorderlessWindow}"/>
								</StackPanel>
							</Button>
							<Button Command="{Binding MaximizeWindowCommand}" IsEnabled="{Binding HasSelectedWindow}">
								<StackPanel Orientation="Horizontal">
									<ui:FAFontIcon Margin="0 0 4 0" FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE922;" />
									<TextBlock Text="{x:Static spp:Strings.GameRelated_Borderless_Maximize}"/>
								</StackPanel>
							</Button>
							<Button Command="{Binding NormalWindowCommand}" IsEnabled="{Binding HasSelectedWindow}">
								<StackPanel Orientation="Horizontal">
									<ui:FAFontIcon Margin="0 0 4 0" FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE923;" />
									<TextBlock Text="{x:Static spp:Strings.GameTools_Win_RestoreWindow}"/>
								</StackPanel>
							</Button>

							<!--Button Group 2-->
							<Button Command="{Binding HideWindowCommand}" IsEnabled="{Binding HasSelectedWindow}">
								<StackPanel Orientation="Horizontal">
									<ui:FAFontIcon Margin="0 0 4 0" FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xed1a;" />
									<TextBlock Text="{x:Static spp:Strings.GameRelated_Borderless_Hide}"/>
								</StackPanel>
							</Button>
							<Button Command="{Binding ShowWindowCommand}" IsEnabled="{Binding HasSelectedWindow}">
								<StackPanel Orientation="Horizontal">
									<ui:FAFontIcon Margin="0 0 4 0" FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xe7b3;" />
									<TextBlock Text="{x:Static spp:Strings.GameRelated_Borderless_Show}"/>
								</StackPanel>
							</Button>

							<Button Command="{Binding KillWindowCommand}" IsEnabled="{Binding HasSelectedWindow}">
								<Button.Styles>
									<Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
										<Setter Property="TextElement.Foreground" Value="White" />
										<Setter Property="TextElement.Background" Value="Red" />
									</Style>
									<Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
										<Setter Property="Background" Value="#f1707a" />
									</Style>
								</Button.Styles>
								<StackPanel Orientation="Horizontal">
									<ui:FAFontIcon Margin="0 0 4 0" FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8BB;" />
									<TextBlock Text="{x:Static spp:Strings.GameRelated_Borderless_KillProcess}"/>
								</StackPanel>
							</Button>

						</WrapPanel>
					</Border>
				</StackPanel>
			</Expander>

            <StackPanel IsVisible="{Binding IsWindowPickingSupported}" Spacing="8">
                <Expander Header="{x:Static spp:Strings.GameTools_Win_Advanced}" IsEnabled="{Binding HasSelectedWindow}" IsExpanded="True">
                    <StackPanel Spacing="12">
                        <WrapPanel>
                            <WrapPanel.Styles>
                                <Style Selector="WrapPanel > Control">
                                    <Setter Property="Margin" Value="0,0,8,8" />
                                </Style>
                            </WrapPanel.Styles>
                            <CheckBox Content="{x:Static spp:Strings.GameTools_Win_Topmost}" IsChecked="{Binding Controls.Topmost, Mode=TwoWay}" IsEnabled="{Binding !Controls.WallpaperAttached}" />
                            <CheckBox Content="{x:Static spp:Strings.GameTools_Win_ClickThrough}" IsChecked="{Binding Controls.ClickThrough, Mode=TwoWay}" />
                            <CheckBox Content="{x:Static spp:Strings.GameTools_Win_ConfineCursor}" IsChecked="{Binding Controls.ConfineCursor, Mode=TwoWay}" IsEnabled="{Binding !Controls.WallpaperAttached}" />
                        </WrapPanel>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <TextBlock VerticalAlignment="Center" Text="{x:Static spp:Strings.GameTools_Win_Opacity}" />
                            <Slider
                                Grid.Column="1"
                                IsSnapToTickEnabled="True"
                                Maximum="100"
                                Minimum="20"
                                TickFrequency="1"
                                Value="{Binding Controls.Opacity, Mode=TwoWay}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding Controls.Opacity, StringFormat={}{0:0}%}" />
                        </Grid>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Static spp:Strings.GameTools_Win_Monitor}" />
                            <WrapPanel>
                                <ComboBox
                                    MinWidth="190"
                                    Margin="0,0,8,8"
                                    AutomationProperties.Name="{x:Static spp:Strings.GameTools_Win_Monitor}"
                                    ItemsSource="{Binding Monitors}"
                                    SelectedItem="{Binding Controls.Monitor, Mode=TwoWay}" />
                                <Button Margin="0,0,8,8" Command="{Binding RefreshMonitorsCommand}" Content="{x:Static spp:Strings.GameTools_Win_RefreshMonitors}" />
                            </WrapPanel>
                            <WrapPanel>
                                <WrapPanel.Styles>
                                    <Style Selector="WrapPanel > Button">
                                        <Setter Property="Margin" Value="0,0,8,8" />
                                    </Style>
                                </WrapPanel.Styles>
                                <Button Command="{Binding CenterWindowCommand}" Content="{x:Static spp:Strings.GameTools_Win_Center}" />
                                <Button Command="{Binding MoveToMonitorCommand}" Content="{x:Static spp:Strings.GameTools_Win_MoveToMonitor}" />
                                <Button Command="{Binding FitMonitorCommand}" Content="{x:Static spp:Strings.GameTools_Win_FitMonitor}" />
                            </WrapPanel>
                            <WrapPanel>
                                <WrapPanel.Styles>
                                    <Style Selector="WrapPanel > StackPanel">
                                        <Setter Property="Margin" Value="0,0,8,8" />
                                        <Setter Property="Width" Value="118" />
                                        <Setter Property="Spacing" Value="4" />
                                    </Style>
                                    <Style Selector="NumericUpDown">
                                        <Setter Property="FormatString" Value="0" />
                                        <Setter Property="Maximum" Value="65535" />
                                    </Style>
                                </WrapPanel.Styles>
                                <StackPanel>
                                    <TextBlock Text="{x:Static spp:Strings.GameTools_Win_PositionX}" />
                                    <NumericUpDown AutomationProperties.Name="{x:Static spp:Strings.GameTools_Win_PositionX}" Minimum="-65535" Value="{Binding Controls.X, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{x:Static spp:Strings.GameTools_Win_PositionY}" />
                                    <NumericUpDown AutomationProperties.Name="{x:Static spp:Strings.GameTools_Win_PositionY}" Minimum="-65535" Value="{Binding Controls.Y, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{x:Static spp:Strings.GameTools_Win_Width}" />
                                    <NumericUpDown AutomationProperties.Name="{x:Static spp:Strings.GameTools_Win_Width}" Minimum="1" Value="{Binding Controls.Width, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{x:Static spp:Strings.GameTools_Win_Height}" />
                                    <NumericUpDown AutomationProperties.Name="{x:Static spp:Strings.GameTools_Win_Height}" Minimum="1" Value="{Binding Controls.Height, Mode=TwoWay}" />
                                </StackPanel>
                            </WrapPanel>
                            <Button Command="{Binding SetBoundsCommand}" Content="{x:Static spp:Strings.GameTools_Win_SetBounds}" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <CheckBox Content="{x:Static spp:Strings.GameTools_Win_MuteInBackground}" IsChecked="{Binding Controls.MuteInBackground, Mode=TwoWay}" />
                            <TextBlock Text="{x:Static spp:Strings.GameTools_Win_BackgroundPriority}" />
                            <ComboBox
                                AutomationProperties.Name="{x:Static spp:Strings.GameTools_Win_BackgroundPriority}"
                                ItemsSource="{Binding Priorities}"
                                SelectedItem="{Binding Controls.Priority, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="spp:WindowPriorityChoice">
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <Expander Header="{x:Static spp:Strings.GameTools_Win_Wallpaper}" IsExpanded="True">
                    <StackPanel Spacing="8">
                        <StackPanel IsEnabled="{Binding HasSelectedWindow}" Spacing="6">
                            <CheckBox Content="{x:Static spp:Strings.GameTools_Win_WallpaperMouse}" IsChecked="{Binding Controls.WallpaperMouse, Mode=TwoWay}" />
                            <CheckBox Content="{x:Static spp:Strings.GameTools_Win_WallpaperKeyboard}" IsChecked="{Binding Controls.WallpaperKeyboard, Mode=TwoWay}" />
                            <TextBlock Text="{x:Static spp:Strings.GameTools_Win_WallpaperHelp}" TextWrapping="Wrap" />
                            <WrapPanel>
                                <Button Margin="0,0,8,0" Command="{Binding ToWallpaperWindowCommand}" Content="{x:Static spp:Strings.GameTools_Win_AttachWallpaper}" IsVisible="{Binding !Controls.WallpaperPaused}" />
                                <Button Margin="0,0,8,0" Command="{Binding PauseWallpaperCommand}" Content="{x:Static spp:Strings.GameTools_Win_PauseWallpaper}" IsVisible="{Binding Controls.WallpaperAttached}" />
                                <Button Command="{Binding ReattachWallpaperCommand}" Content="{x:Static spp:Strings.GameTools_Win_ResumeWallpaper}" IsVisible="{Binding Controls.WallpaperPaused}" />
                            </WrapPanel>
                        </StackPanel>
                        <Button Command="{Binding ResetWallpaperCommand}" Content="{x:Static spp:Strings.GameTools_Win_ResetWallpaper}" />
                    </StackPanel>
                </Expander>

                <Expander Header="{x:Static spp:Strings.GameTools_Win_Rules}">
                    <StackPanel Spacing="8">
                        <StackPanel IsEnabled="{Binding HasSelectedWindow}" Spacing="6">
                            <CheckBox Content="{x:Static spp:Strings.GameTools_Win_AutoApply}" IsChecked="{Binding Controls.AutoApply, Mode=TwoWay}" />
                            <Button Command="{Binding SaveRuleCommand}" Content="{x:Static spp:Strings.GameTools_Win_SaveRule}" />
                        </StackPanel>
                        <ComboBox
                            MinWidth="190"
                            AutomationProperties.Name="{x:Static spp:Strings.GameTools_Win_Rules}"
                            ItemsSource="{Binding WindowRules}"
                            SelectedItem="{Binding SelectedRule, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="spp:WindowRuleChoice">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <WrapPanel IsEnabled="{Binding HasSelectedRule}">
                            <Button Margin="0,0,8,0" Command="{Binding ToggleRuleCommand}" Content="{x:Static spp:Strings.GameTools_Win_ToggleRule}" />
                            <Button Command="{Binding RemoveRuleCommand}" Content="{x:Static spp:Strings.GameTools_Win_RemoveRule}" />
                        </WrapPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
		</StackPanel>
    </ScrollViewer>
</spp:PageBase>

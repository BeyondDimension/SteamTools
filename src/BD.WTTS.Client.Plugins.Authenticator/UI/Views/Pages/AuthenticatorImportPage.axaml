<UserControl
    x:Class="BD.WTTS.UI.Views.Pages.AuthenticatorImportPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:spp="https://steampp.net/ui"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:CompileBindings="True"
    x:DataType="spp:AuthenticatorImportPageViewModel"
    mc:Ignorable="d">
    <Grid RowDefinitions="Auto,*">
        <Grid Margin="0,0,0,8" ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding !IsSelecting, FallbackValue=False}">
            <Button
                x:Name="ImportBackButton"
                Padding="8"
                VerticalAlignment="Center"
                AutomationProperties.Name="{x:Static spp:Strings.Back}"
                Command="{Binding BackCommand}"
                Content="{StaticResource Back}"
                FontFamily="{StaticResource SymbolThemeFontFamily}"
                Theme="{StaticResource TransparentButton}" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Text="{Binding ImportTitle}"
                TextWrapping="Wrap"
                Theme="{StaticResource BodyStrongTextBlockStyle}" />
        </Grid>
        <ScrollViewer x:Name="ImportChoices" Grid.Row="1" IsVisible="{Binding IsSelecting}"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      Container.Name="importChoices" Container.Sizing="Width">
            <ItemsControl ItemsSource="{Binding AuthenticatorImportMethods}">
                <ItemsControl.Styles>
                    <ContainerQuery Name="importChoices" Query="max-width:420">
                        <Style Selector="UniformGrid.importCards">
                            <Setter Property="Columns" Value="1" />
                        </Style>
                    </ContainerQuery>
                    <Style Selector="UniformGrid.importCards">
                        <Setter Property="Columns" Value="2" />
                    </Style>
                </ItemsControl.Styles>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Classes="importCards" ColumnSpacing="10" RowSpacing="10" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="spp:AuthenticatorImportMethod">
                        <Button
                            MinHeight="90"
                            Padding="12"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Top"
                            AutomationProperties.Name="{Binding Name}"
                            Command="{Binding Command}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Theme="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <ContentControl Grid.Row="1" Content="{Binding ImportContent}" ClipToBounds="True" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
</UserControl>

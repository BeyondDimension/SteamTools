<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://steampp.net/services"
    xmlns:spp="https://steampp.net/ui"
    x:CompileBindings="True"
    x:DataType="spp:JoinSteamAuthenticatorPageViewModel"
		x:Class="BD.WTTS.UI.Views.Pages.JoinSteamAuthenticatorPage"
    mc:Ignorable="d">
	<UserControl.Styles>
		<Style Selector="Border.coexistForm">
			<Setter Property="MaxWidth" Value="520" />
			<Setter Property="Margin" Value="0,8,6,8" />
			<Setter Property="Padding" Value="16" />
			<Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="8" />
		</Style>
	</UserControl.Styles>
	<Grid RowDefinitions="Auto,*">
		<spp:Stepper SelectedIndex="{Binding SelectIndex}">
			<spp:StepperItem Content="{x:Static spp:Strings.Steam_Login}" />
			<spp:StepperItem Content="{x:Static spp:Strings.LocalAuth_JoinSteamAuthenticator_ConfirmSteamAppAuthenticatorCode}" />
			<spp:StepperItem Content="{x:Static spp:Strings.Btn_Text_Complete}" />
		</spp:Stepper>

		<spp:ContentLoader
				Grid.Row="1"
				IsLoading="{Binding Loading}"
				IsShowNoResultText="False">
			<Carousel IsVisible="{Binding !Loading}" SelectedIndex="{Binding SelectIndex}">
				<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
					<Border Classes="coexistForm">
						<StackPanel Spacing="12">
							<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
								<PathIcon Width="28" Height="28" Data="{StaticResource Steam}" />
								<TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"
								           Theme="{StaticResource BodyStrongTextBlockStyle}"
								           Text="{x:Static spp:Strings.LocalAuth_JoinSteamAuthenticator}" />
							</Grid>
							<TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
							           Text="{x:Static spp:Strings.LocalAuth_JoinSteamAuthenticatorDesc}" />
							<spp:Snackbar IsClosable="False" IsOpen="True" IsVisible="{Binding RequireVerifyCode}"
							              Message="{x:Static spp:Strings.LocalAuth_EmailCodeTip}" Severity="Warning" />
							<StackPanel Spacing="4">
								<TextBlock Text="{x:Static spp:Strings.Steam_User}" />
								<TextBox x:Name="CoexistAccount" MinHeight="36" Text="{Binding UserNameText}"
								         PlaceholderText="{x:Static spp:Strings.Steam_User}" />
							</StackPanel>
							<StackPanel Spacing="4">
								<TextBlock Text="{x:Static spp:Strings.Steam_Password}" />
								<TextBox MinHeight="36" Classes="revealPasswordButton" PasswordChar="{StaticResource PasswordChar}"
								         Text="{Binding PasswordText}" PlaceholderText="{x:Static spp:Strings.Steam_Password}" />
							</StackPanel>
							<TextBox MinHeight="36" IsVisible="{Binding RequireVerifyCode}"
							         PlaceholderText="{x:Static spp:Strings.EmailCode}" Text="{Binding VerifyCodeText}" />
							<Button MinHeight="36" HorizontalAlignment="Right" Theme="{StaticResource AccentButton}"
							        Command="{Binding LoginAsync}" Content="{x:Static spp:Strings.Login}" />
						</StackPanel>
					</Border>
				</ScrollViewer>

				<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
					<Border Classes="coexistForm">
						<StackPanel Spacing="12">
							<spp:Snackbar IsClosable="False" IsOpen="True" Severity="Warning"
							              Message="{x:Static spp:Strings.LocalAuth_JoinSteamAuthenticator_InputSteamAppAuthenticatorCodeTips}" />
							<StackPanel Spacing="4">
								<TextBlock Text="{x:Static spp:Strings.RecoveryCode}" TextWrapping="Wrap" />
								<TextBox MinHeight="36" Text="{Binding RevocationCodeText, Mode=OneWay}" IsReadOnly="True" />
							</StackPanel>
							<StackPanel Spacing="4">
								<TextBlock Text="{x:Static spp:Strings.LocalAuth_JoinSteamAuthenticator_SteamAppAuthenticatorCode}" TextWrapping="Wrap" />
								<TextBox MinHeight="36" Text="{Binding Code}"
								         PlaceholderText="{x:Static spp:Strings.LocalAuth_JoinSteamAuthenticator_InputSteamAppAuthenticatorCode}" />
							</StackPanel>
							<Button MinHeight="36" HorizontalAlignment="Right" Theme="{StaticResource AccentButton}"
							        Command="{Binding VerifyCodeAsync}" Content="{x:Static spp:Strings.Continue}" />
						</StackPanel>
					</Border>
				</ScrollViewer>

				<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
					<Border Classes="coexistForm">
						<StackPanel Spacing="12">
							<spp:Snackbar IsClosable="False" IsOpen="True" Severity="Success"
							              Message="{x:Static spp:Strings.RecoveryCode_RememberTip}" />
							<StackPanel Spacing="4">
								<TextBlock Text="{x:Static spp:Strings.RecoveryCode}" TextWrapping="Wrap" />
								<TextBox MinHeight="36" Text="{Binding RevocationCodeText, Mode=OneWay}" IsReadOnly="True" />
							</StackPanel>
							<Button MinHeight="36" HorizontalAlignment="Right" Theme="{StaticResource AccentButton}"
							        Command="{Binding SaveAsync}" Content="{x:Static spp:Strings.Confirm}" />
						</StackPanel>
					</Border>
				</ScrollViewer>
			</Carousel>
		</spp:ContentLoader>
	</Grid>
</UserControl>
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://steampp.net/services"
    xmlns:spp="https://steampp.net/ui"
    x:CompileBindings="True"
    x:DataType="spp:JoinSteamAuthenticatorPageViewModel"
		x:Class="BD.WTTS.UI.Views.Pages.JoinSteamAuthenticatorPage"
    mc:Ignorable="d">
	<Grid RowDefinitions="Auto,*">
		<spp:Stepper SelectedIndex="{Binding SelectIndex}">
			<spp:StepperItem Content="{x:Static spp:Strings.Steam_Login}" />
			<spp:StepperItem Content="{x:Static spp:Strings.LocalAuth_JoinSteamAuthenticator_ConfirmSteamAppAuthenticatorCode}" />
			<spp:StepperItem Content="{x:Static spp:Strings.Btn_Text_Complete}" />
		</spp:Stepper>

		<spp:ContentLoader
				Grid.Row="1"
				MinWidth="600"
				MinHeight="400"
				IsLoading="{Binding Loading}"
				IsShowNoResultText="False">
			<Carousel IsVisible="{Binding !Loading}" SelectedIndex="{Binding SelectIndex}">
				<Panel>
					<spp:Snackbar
							Title="{x:Static spp:Strings.Notice_Tray_Title}"
							VerticalAlignment="Top"
							IsClosable="False"
							IsOpen="True"
							IsVisible="{Binding RequireVerifyCode}"
							Message="{x:Static spp:Strings.LocalAuth_EmailCodeTip}"
							Severity="Warning" />

					<StackPanel
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Spacing="10">
						<PathIcon
								Width="88"
								Height="88"
								Data="{StaticResource Steam}" />
						<TextBox
								MaxWidth="280"
								Text="{Binding UserNameText}"
								PlaceholderText="{x:Static spp:Strings.Steam_User}" />
						<TextBox
								Name="PasswordText"
								MaxWidth="280"
								Classes="revealPasswordButton"
								PasswordChar="{StaticResource PasswordChar}"
								Text="{Binding PasswordText}"
								PlaceholderText="{x:Static spp:Strings.Steam_Password}" />
						<TextBox
							IsVisible="{Binding RequireVerifyCode}"
							PlaceholderText="{x:Static spp:Strings.EmailCode}"
							Text="{Binding VerifyCodeText}" />
						<Button
								MinWidth="280"
								HorizontalAlignment="Center"
								VerticalAlignment="Bottom"
								HorizontalContentAlignment="Center"
								Command="{Binding LoginAsync}"
								Content="{x:Static spp:Strings.Login}" />
					</StackPanel>
				</Panel>

				<Panel>
					<spp:Snackbar
							Title="{x:Static spp:Strings.Notice_Tray_Title}"
							VerticalAlignment="Top"
							IsClosable="False"
							IsOpen="True"
							Message="{x:Static spp:Strings.LocalAuth_JoinSteamAuthenticator_InputSteamAppAuthenticatorCodeTips}"
							Severity="Warning" />
					<StackPanel
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Spacing="10">
						<DockPanel>
							<TextBlock
									Margin="0,0,0,6"
									DockPanel.Dock="Top"
									Text="{x:Static spp:Strings.RecoveryCode}" />
							<TextBox
									MaxWidth="300"
									Text="{Binding RevocationCodeText}"
									IsReadOnly="True" />
							<!--<Button
								Content="重新生成"
								Command="{Binding ResetRevocationCodeAsync}" />-->
						</DockPanel>
						<DockPanel>
							<TextBlock
									Margin="0,0,0,6"
									DockPanel.Dock="Top"
									Text="{x:Static spp:Strings.LocalAuth_JoinSteamAuthenticator_SteamAppAuthenticatorCode}" />
							<TextBox
									MaxWidth="300"
									PlaceholderText="{x:Static spp:Strings.LocalAuth_JoinSteamAuthenticator_InputSteamAppAuthenticatorCode}"
									Text="{Binding Code}" />
						</DockPanel>

						<Button
								MinWidth="280"
								HorizontalAlignment="Center"
								HorizontalContentAlignment="Center"
								Command="{Binding VerifyCodeAsync}"
								Content="{x:Static spp:Strings.Continue}" />
					</StackPanel>
				</Panel>

				<Panel>
					<spp:Snackbar
							Title="{x:Static spp:Strings.Notice_Tray_Title}"
							VerticalAlignment="Top"
							IsClosable="False"
							IsOpen="True"
							Message="{x:Static spp:Strings.RecoveryCode_RememberTip}"
							Severity="Success" />
					<StackPanel
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Spacing="10">

						<DockPanel>
							<TextBlock
									Margin="0,0,0,6"
									DockPanel.Dock="Top"
									Text="{x:Static spp:Strings.RecoveryCode}" />
							<TextBox
									MaxWidth="300"
									Text="{Binding RevocationCodeText}"
									IsReadOnly="True" />
						</DockPanel>

						<Button
								MinWidth="280"
								HorizontalAlignment="Center"
								HorizontalContentAlignment="Center"
								Command="{Binding SaveAsync}"
								Content="{x:Static spp:Strings.Confirm}" />
					</StackPanel>
				</Panel>
			</Carousel>
		</spp:ContentLoader>
	</Grid>
</UserControl>
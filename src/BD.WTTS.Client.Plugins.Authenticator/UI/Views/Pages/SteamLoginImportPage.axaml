<UserControl
    x:Class="BD.WTTS.UI.Views.Pages.SteamLoginImportPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:spp="https://steampp.net/ui"
    d:DesignHeight="300"
    d:DesignWidth="600"
    x:CompileBindings="True"
    x:DataType="spp:SteamLoginImportPageViewModel"
    mc:Ignorable="d">
    <Grid RowDefinitions="Auto,*" RowSpacing="8">
        <spp:Stepper SelectedIndex="{Binding SelectIndex, Mode=OneWay}">
            <spp:StepperItem Content="{x:Static spp:Strings.Steam_Login}" />
            <spp:StepperItem Content="{x:Static spp:Strings.LoginVerify}" />
            <spp:StepperItem Content="{x:Static spp:Strings.LocalAuth_VerifyCode}" />
            <spp:StepperItem Content="{x:Static spp:Strings.Btn_Text_Complete}" />
        </spp:Stepper>

        <spp:ContentLoader Grid.Row="1" IsLoading="{Binding IsLoading}" IsShowNoResultText="False">
            <Carousel IsVisible="{Binding !IsLoading}" SelectedIndex="{Binding SelectIndex, Mode=OneWay}">
                <spp:SteamLoginView DataContext="{Binding Login}" />

                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12" MaxWidth="360" VerticalAlignment="Center" Spacing="10">
                        <PathIcon Width="88" Height="88" HorizontalAlignment="Center" Data="{StaticResource Steam}" />
                        <Button
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Command="{Binding ContinueCommand}"
                            Content="{x:Static spp:Strings.Continue}" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12" MaxWidth="440" Spacing="10">
                        <spp:Snackbar
                            Title="{x:Static spp:Strings.Notice_Tray_Title}"
                            IsClosable="False"
                            IsVisible="{Binding IsVerifyAccountPhone}"
                            IsOpen="True"
                            Message="{x:Static spp:Strings.LocalAuth_SMSCodeTip}"
                            Severity="Warning" />
                        <spp:Snackbar
                            Title="{x:Static spp:Strings.Notice_Tray_Title}"
                            IsClosable="False"
                            IsVisible="{Binding !IsVerifyAccountPhone}"
                            IsOpen="True"
                            Message="{x:Static spp:Strings.LocalAuth_EmailCodeTip}"
                            Severity="Warning" />
                        <StackPanel Spacing="6" IsVisible="{Binding RevocationCodeText, Converter={StaticResource IsNullConverter}, ConverterParameter=invert}">
                            <TextBlock Text="{x:Static spp:Strings.RecoveryCode}" TextWrapping="Wrap" />
                            <TextBox IsReadOnly="True" Text="{Binding RevocationCodeText, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock IsVisible="{Binding IsVerifyAccountPhone}" Text="{x:Static spp:Strings.SMSCode}" />
                        <TextBlock IsVisible="{Binding !IsVerifyAccountPhone}" Text="{x:Static spp:Strings.EmailCode}" />
                        <TextBox Name="PhoneCodeText" Text="{Binding PhoneCodeText}" />
                        <Button
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Command="{Binding ContinueCommand}"
                            Content="{x:Static spp:Strings.Continue}" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12" MaxWidth="440" Spacing="10">
                        <spp:Snackbar
                            Title="{x:Static spp:Strings.Notice_Tray_Title}"
                            IsClosable="False"
                            IsOpen="True"
                            Message="{x:Static spp:Strings.RecoveryCode_RememberTip}"
                            Severity="Success" />
                        <StackPanel Spacing="6" IsVisible="{Binding RevocationCodeText, Converter={StaticResource IsNullConverter}, ConverterParameter=invert}">
                            <TextBlock Text="{x:Static spp:Strings.RecoveryCode}" TextWrapping="Wrap" />
                            <TextBox IsReadOnly="True" Text="{Binding RevocationCodeText, Mode=OneWay}" />
                        </StackPanel>
                        <Button
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Command="{Binding ResetCommand}"
                            Content="{x:Static spp:Strings.Confirm}" />
                    </StackPanel>
                </ScrollViewer>
            </Carousel>
        </spp:ContentLoader>
    </Grid>
</UserControl>
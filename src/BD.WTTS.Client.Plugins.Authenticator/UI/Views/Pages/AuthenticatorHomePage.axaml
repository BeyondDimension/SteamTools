<spp:PageBase
    x:Class="BD.WTTS.UI.Views.Pages.AuthenticatorHomePage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://steampp.net/services"
    xmlns:spp="https://steampp.net/ui"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    Title="{x:Static spp:Strings.LocalAuth}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:CompileBindings="True"
    x:DataType="spp:AuthenticatorHomePageViewModel"
    Description="{x:Static spp:Strings.L10nAuthIdle_Text029}"
    OpenPaneLength="344"
    Subtitle="{Binding Author, Source={x:Static s:Plugin.Instance}, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter=Plugin_Author}"
    mc:Ignorable="d">
    <spp:PageBase.PreviewImage>
        <ui:FAImageIconSource Source="{Binding Icon, Source={x:Static s:Plugin.Instance}, Mode=OneWay, Converter={StaticResource BitmapAssetValueConverter}}" />
    </spp:PageBase.PreviewImage>
    <spp:PageBase.ActionContent>
        <StackPanel Orientation="Horizontal" Spacing="2">
            <Button
                Padding="8,4"
                Command="{Binding ShowAddWindow}"
                DockPanel.Dock="Right"
                IsEnabled="{Binding IsVerificationPass}"
                Theme="{StaticResource TransparentButton}">
                <Panel>
                    <Viewbox
                        Width="16"
                        Height="16"
                        HorizontalAlignment="Left">
                        <ui:FASymbolIcon Symbol="Add" />
                    </Viewbox>
                    <TextBlock
                        Margin="28,4,0,4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="{x:Static spp:Strings.Add}" />
                </Panel>
            </Button>
            <!--<Button
                Padding="8,4"
                Command="{Binding SyncAuthenticators}"
                DockPanel.Dock="Right"
                Theme="{StaticResource TransparentButton}">
                <Panel>
                    <Viewbox
                        Width="16"
                        Height="16"
                        HorizontalAlignment="Left">
                        <ui:FASymbolIcon Symbol="Sync" />
                    </Viewbox>
                    <TextBlock
                        Margin="28,4,0,4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="{x:Static spp:Strings.LocalAuth_CloudSync}" />
                </Panel>
            </Button>-->
            <Button
                Padding="8,4"
                Command="{Binding Initialize}"
                DockPanel.Dock="Right"
                Theme="{StaticResource TransparentButton}">
                <Panel>
                    <Viewbox
                        Width="16"
                        Height="16"
                        HorizontalAlignment="Left">
                        <ui:FASymbolIcon Symbol="Refresh" />
                    </Viewbox>
                    <TextBlock
                        Margin="28,4,0,4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="{x:Static spp:Strings.Refresh}" />
                </Panel>
            </Button>
            <ToggleButton
                Padding="8,4"
                DockPanel.Dock="Right"
                IsChecked="{Binding $parent[spp:PageBase].IsPaneOpen, Mode=TwoWay}"
                Theme="{StaticResource TransparentToggleButton}">
                <Panel>
                    <Viewbox
                        Width="16"
                        Height="16"
                        HorizontalAlignment="Left">
                        <ui:FASymbolIcon Symbol="Settings" />
                    </Viewbox>
                    <TextBlock
                        Margin="28,4,0,4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="{x:Static spp:Strings.Settings_Auth}" />
                </Panel>
            </ToggleButton>
            <DropDownButton
                Padding="8"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Content="{StaticResource More}"
                FontFamily="{StaticResource SymbolThemeFontFamily}"
                FontSize="20"
                Theme="{StaticResource TransparentButton}">
                <DropDownButton.Flyout>
                    <ui:FAMenuFlyout Placement="BottomEdgeAlignedRight">
                        <ui:FAMenuFlyoutItem Command="{Binding OpenExportWindow}" IsEnabled="{Binding IsVerificationPass}" Text="{x:Static spp:Strings.ExportAll}" />
                        <ui:FAMenuFlyoutSeparator />
                        <ui:FAMenuFlyoutItem IsEnabled="False">
                            <ui:FAMenuFlyoutItem.Text>
                                <MultiBinding StringFormat="{}{0}{1}">
                                    <Binding Mode="OneTime" Source="{x:Static spp:Strings.Plugin_Version}" />
                                    <CompiledBindingExtension
                                        Mode="OneWay"
                                        Path="Version"
                                        Source="{x:Static s:Plugin.Instance}" />
                                </MultiBinding>
                            </ui:FAMenuFlyoutItem.Text>
                        </ui:FAMenuFlyoutItem>
                        <!--<ui:FAMenuFlyoutItem Text="{x:Static spp:Strings.ViewInStore}" />
                        <ui:FAMenuFlyoutItem Text="{x:Static spp:Strings.UseHelp}" />
                        <ui:FAMenuFlyoutItem Text="{x:Static spp:Strings.AboutThisPlugin}" />-->
                    </ui:FAMenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </StackPanel>
    </spp:PageBase.ActionContent>

    <spp:PageBase.PaneContent>
        <StackPanel Margin="14,16" Spacing="14">
            <StackPanel.Styles>
                <Style Selector="Border.token-settings-card">
                    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="Padding" Value="12" />
                </Style>
                <Style Selector="Button.token-settings-action">
                    <Setter Property="MinHeight" Value="34" />
                    <Setter Property="Padding" Value="10,6" />
                </Style>
            </StackPanel.Styles>

            <StackPanel Spacing="6" IsEnabled="{Binding IsVerificationPass}">
                <TextBlock Text="{x:Static spp:Strings.Filter}" Theme="{StaticResource CaptionTextBlockStyle}" />
                <AutoCompleteBox Classes="Search" Text="{Binding SearchText}"
                                 PlaceholderText="{x:Static spp:Strings.L10nAuthIdle_Text040}" />
                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource StringFormatConverter}">
                            <Binding Mode="OneTime" Source="{x:Static spp:Strings.L10nAuthIdle_Text120}" />
                            <Binding Path="Auths.Count" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock VerticalAlignment="Center" Text="{x:Static spp:Strings.EncryptSettings}"
                           Theme="{StaticResource BodyStrongTextBlockStyle}" />
                <Button Grid.Column="1" Padding="6,4" Command="{Binding EncryptHelp}"
                        Content="{x:Static spp:Strings.Auth_VaultHelpLabel}" Theme="{StaticResource TransparentButton}" />
            </Grid>

            <Border Classes="token-settings-card">
                <StackPanel Spacing="10">
                    <TextBlock Text="{Binding VaultProtectionSummary}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <Button Classes="accent token-settings-action" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding ReLockAuthenticator}" Content="{x:Static spp:Strings.Auth_lock}"
                            IsVisible="{Binding CanLockVault}">
                        <Button.IsEnabled>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="IsVerificationPass" />
                                <Binding Path="!IsLoading" />
                                <Binding Path="HasVaultData" />
                            </MultiBinding>
                        </Button.IsEnabled>
                    </Button>
                </StackPanel>
            </Border>

            <StackPanel Spacing="8">
                <StackPanel.IsEnabled>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="IsVerificationPass" />
                        <Binding Path="!IsLoading" />
                        <Binding Path="HasVaultData" />
                    </MultiBinding>
                </StackPanel.IsEnabled>
                <TextBlock Text="{x:Static spp:Strings.Auth_VaultUnlockMethods}" Theme="{StaticResource CaptionTextBlockStyle}" />
                <Border Classes="token-settings-card" IsVisible="{Binding ShowWindowsHello}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Windows Hello" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static spp:Strings.Auth_VaultHelloDescription}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Button Classes="token-settings-action" Command="{Binding ToggleWindowsHelloAsync}"
                                Content="{Binding WindowsHelloActionText}" />
                    </StackPanel>
                </Border>
                <Border Classes="token-settings-card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Static spp:Strings.Auth_VaultPasswordLabel}" FontWeight="SemiBold" />
                        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                            <Button Classes="token-settings-action" Command="{Binding SetPasswordProtection}"
                                    Content="{Binding PasswordActionText}" />
                            <Button Classes="token-settings-action" Command="{Binding RemovePasswordProtection}"
                                    Content="{x:Static spp:Strings.Auth_RemovePasswordProtect}" IsVisible="{Binding HasPasswordEncrypt}"
                                    Theme="{StaticResource TransparentButton}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,6,0,0" Text="{x:Static spp:Strings.Auth_VaultStorageLabel}"
                           Theme="{StaticResource CaptionTextBlockStyle}" />
                <Border Classes="token-settings-card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Static spp:Strings.Auth_VaultHelloLocalDescription}" IsVisible="{Binding WindowsHelloEnabled}"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Button Classes="token-settings-action" Command="{Binding ToggleLocalProtection}"
                                Content="{Binding LocalProtectionActionText}" IsVisible="{Binding !WindowsHelloEnabled}" />
                        <Button Classes="token-settings-action" Command="{Binding UpgradeVaultProtectionAsync}"
                                Content="{x:Static spp:Strings.Auth_VaultUpgrade}" IsVisible="{Binding ProtectionUpgradeAvailable}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </spp:PageBase.PaneContent>
    <Panel>
        <StackPanel
            MaxWidth="440"
            Margin="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsVisible="{Binding !IsVerificationPass}"
            Spacing="12">
            <TextBlock Text="{Binding VaultLockedMessage}" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Text="{Binding VaultReadError}" IsVisible="{Binding !!VaultReadError}"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextAlignment="Center" TextWrapping="Wrap" />
            <Button Classes="accent" HorizontalAlignment="Center" Command="{Binding UnlockVaultAsync}"
                    Content="{Binding UnlockVaultText}" IsEnabled="{Binding !IsLoading}" IsVisible="{Binding CanUnlockVault}" />
        </StackPanel>

        <spp:ContentLoader
            IsLoading="{Binding IsLoading}"
            IsShowNoResultText="{Binding !!!Auths.Count}"
            IsVisible="{Binding IsVerificationPass}">
            <spp:ContentLoader.NoResultMessage>
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="5">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="{x:Static spp:Strings.LocalAuth_NoAuthTip}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </spp:ContentLoader.NoResultMessage>
            <ItemsRepeater x:Name="AuthRepeater" HorizontalCacheLength="0" ItemsSource="{Binding Auths}" VerticalCacheLength="1">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsJustification="Start"
                        ItemsStretch="Fill"
                        MinColumnSpacing="8"
                        MinItemHeight="108"
                        MinItemWidth="280"
                        MinRowSpacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate DataType="{x:Type spp:AuthenticatorItemModel}">
                        <spp:AuthenticatorItem>
                            <spp:AuthenticatorItem.ContextFlyout>
                                <MenuFlyout>
                                    <MenuItem
                                        Command="{Binding CopyCode}"
                                        Header="{x:Static spp:Strings.LocalAuth_Copy}"
                                        ToolTip.Tip="{x:Static spp:Strings.LocalAuth_Copy}">
                                        <MenuItem.Icon>
                                            <ui:FASymbolIcon Symbol="Copy" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem
                                        Command="{Binding EditAuthNameAsync}"
                                        Header="{x:Static spp:Strings.Auth_EditName}">
                                        <MenuItem.Icon>
                                            <ui:FASymbolIcon Symbol="Edit" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem
                                        Command="{Binding ShowSteamTradeWindow}"
                                        Header="{x:Static spp:Strings.LocalAuth_AuthTrade}"
                                        IsVisible="{Binding IsSteamAuthenticator, Mode=OneWay}">
                                        <MenuItem.Icon>
                                            <ui:FAFontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE9D5;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
	                                <MenuItem
		                                Command="{Binding ShowSteamQrLoginWindow}"
		                                Header="{x:Static spp:Strings.L10nAuthIdle_Text110}"
		                                IsVisible="{Binding IsSteamAuthenticator, Mode=OneWay}">
		                                <MenuItem.Icon>
			                                <ui:FAFontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="{StaticResource QrCode}" />
		                                </MenuItem.Icon>
	                                </MenuItem>
                                    <MenuItem Header="-" />
                                    <MenuItem
                                        Click="OnMoveAuthenticatorUp"
                                        Header="{x:Static spp:Strings.Up}">
                                        <MenuItem.Icon>
                                            <ui:FASymbolIcon Symbol="ChevronUp" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem
                                        Click="OnMoveAuthenticatorDown"
                                        Header="{x:Static spp:Strings.MoveDown}">
                                        <MenuItem.Icon>
                                            <ui:FASymbolIcon Symbol="ChevronDown" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <!--<MenuItem
                                        Command="{Binding $parent[spp:PageBase].((spp:AuthenticatorHomePageViewModel)DataContext).AuthenticatorIndexSticky}"
                                        CommandParameter="{Binding}"
                                        Header="{x:Static spp:Strings.FixedTop}">
                                        <MenuItem.Icon>
                                            <ui:FASymbolIcon Symbol="Pin" />
                                        </MenuItem.Icon>
                                    </MenuItem>-->
                                    <MenuItem Header="-" />
                                    <MenuItem
                                        Command="{Binding $parent[spp:PageBase].((spp:AuthenticatorHomePageViewModel)DataContext).ShowAuthenticatorManagement}"
                                        CommandParameter="{Binding}"
                                        Header="{x:Static spp:Strings.L10nAuthIdle_Text111}">
                                        <MenuItem.Icon>
                                            <ui:FASymbolIcon Symbol="Calendar" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="-" />
                                    <MenuItem
                                        Command="{Binding $parent[spp:PageBase].((spp:AuthenticatorHomePageViewModel)DataContext).UnbindingSteamAuthAsync}"
                                        CommandParameter="{Binding}"
                                        Header="{x:Static spp:Strings.LocalAuth_RemoveAuth}"
                                        IsVisible="{Binding IsSteamAuthenticator, Mode=OneWay}">
                                        <MenuItem.Icon>
                                            <ui:FAFontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xECC9;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem
                                        Command="{Binding $parent[spp:PageBase].((spp:AuthenticatorHomePageViewModel)DataContext).DeleteAuthAsync}"
                                        CommandParameter="{Binding}"
                                        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                        Header="{x:Static spp:Strings.LocalAuth_Delete}">
                                        <MenuItem.Icon>
                                            <ui:FASymbolIcon Symbol="Delete" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </MenuFlyout>
                            </spp:AuthenticatorItem.ContextFlyout>
                        </spp:AuthenticatorItem>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </spp:ContentLoader>
        <Canvas x:Name="DragOverlay" ClipToBounds="False" IsHitTestVisible="False">
            <Border
                x:Name="DragPreview"
                x:DataType="spp:AuthenticatorItemModel"
                DataContext="{x:Null}"
                Padding="12"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                BorderThickness="2"
                BoxShadow="{StaticResource InfoBoxShadow}"
                CornerRadius="6"
                IsVisible="False"
                Opacity="0.96">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <PathIcon x:Name="DragPreviewIcon" Width="20" Height="20" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock FontWeight="SemiBold" Text="{Binding AuthName}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding DisplayPlatform}" />
                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static spp:Strings.L10nAuthIdle_Text112}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Canvas>
    </Panel>
</spp:PageBase>
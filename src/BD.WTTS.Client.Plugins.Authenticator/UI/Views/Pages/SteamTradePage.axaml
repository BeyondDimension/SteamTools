<UserControl
    x:Class="BD.WTTS.UI.Views.Pages.SteamTradePage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://steampp.net/services"
    xmlns:spp="https://steampp.net/ui"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:CompileBindings="True"
    x:DataType="spp:SteamTradePageViewModel"
    mc:Ignorable="d">
    <spp:ContentLoader CustomLoadingText="{Binding Path=Res.EnableAccelerationPrompt, Mode=OneWay, Source={x:Static s:ResourceService.Current}}" IsLoading="{Binding IsLoading}">
        <Panel>
            <!--  登录  -->
            <Grid RowDefinitions="*,Auto" RowSpacing="10">
                <Grid.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <CompiledBindingExtension Path="!IsLogged" />
                        <CompiledBindingExtension Path="!IsLoading" />
                    </MultiBinding>
                </Grid.IsVisible>
                <spp:SteamLoginView DataContext="{Binding Login}" ShowRememberLogin="True"
                                    RememberLogin="{Binding $parent[spp:SteamTradePage].((spp:SteamTradePageViewModel)DataContext).RememberLogin, Mode=TwoWay}" />
                <TextBlock Grid.Row="1" Text="{Binding LoginStatus}" TextWrapping="Wrap" HorizontalAlignment="Center" />
            </Grid>

            <!--  确认交易  -->
            <Grid RowDefinitions="Auto,Auto,*">
                <Grid.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <CompiledBindingExtension Path="!IsLoading" />
                        <CompiledBindingExtension Path="IsLogged" />
                    </MultiBinding>
                </Grid.IsVisible>
                <Grid Margin="0,4,0,8" RowDefinitions="Auto,Auto" RowSpacing="8">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <CheckBox VerticalAlignment="Center" Command="{Binding SelectAllCommand}"
                                  Content="{Binding Path=Res.SelectAll, Mode=OneWay, Source={x:Static s:ResourceService.Current}}"
                                  IsChecked="{Binding SelectedAll, Mode=OneWay}" />
                        <Button Grid.Column="1" Command="{Binding Refresh}"
                                Content="{Binding Path=Res.Refresh, Mode=OneWay, Source={x:Static s:ResourceService.Current}}" />
                        <Button Grid.Column="2" Command="{Binding Logout}"
                                Content="{Binding Path=Res.Logout, Mode=OneWay, Source={x:Static s:ResourceService.Current}}" />
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding CancelAllTrade}"
                                Content="{Binding Path=Res.BatchReject, Mode=OneWay, Source={x:Static s:ResourceService.Current}}" />
                        <Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding ConfirmAllTrade}"
                                Content="{Binding Path=Res.BatchPass, Mode=OneWay, Source={x:Static s:ResourceService.Current}}" />
                    </Grid>
                </Grid>
                <TextBlock Grid.Row="1" Margin="0,0,0,8" Text="{Binding LoginStatus}" TextWrapping="Wrap"
                           IsVisible="{Binding LoginStatus, Converter={StaticResource IsNullConverter}, ConverterParameter=invert}" />
                <Panel Grid.Row="2" MaxHeight="300">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{Binding !!!Confirmations.Count}"
                        Text="{Binding Path=Res.LocalAuth_AuthTrade_Null, Mode=OneWay, Source={x:Static s:ResourceService.Current}}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Confirmations}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type spp:SteamTradeConfirmationModel}">
                                    <ui:FASettingsExpander>
                                        <ui:FASettingsExpander.Header>
                                            <Grid ColumnDefinitions="Auto,40,*,Auto" ColumnSpacing="8">
                                                <CheckBox VerticalAlignment="Top" Margin="0,4,0,0"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                <spp:Image2 Grid.Column="1" Width="40" Height="40" VerticalAlignment="Top"
                                                            EnableCancelToken="False" Source="{Binding Icon}" Stretch="Uniform" />
                                                <StackPanel Grid.Column="2" Spacing="2">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding TypeNameText}" TextWrapping="Wrap" />
                                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding CreateTime}" />
                                                    <TextBlock
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        IsVisible="{Binding ReceiveSummary, Converter={StaticResource IsNullConverter}, ConverterParameter=invert}"
                                                        Text="{Binding ReceiveSummary}"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SendSummary}" TextWrapping="Wrap" />
                                                    <TextBlock
                                                        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                        IsVisible="{Binding Warn, Converter={StaticResource IsNullConverter}, ConverterParameter=invert}"
                                                        Text="{Binding Warn}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="4">
                                                    <Button Command="{Binding $parent[spp:SteamTradePage].((spp:SteamTradePageViewModel)DataContext).CancelTradeCommand}"
                                                            CommandParameter="{Binding}" Content="{Binding Cancel}" />
                                                    <Button Command="{Binding $parent[spp:SteamTradePage].((spp:SteamTradePageViewModel)DataContext).ConfirmTradeCommand}"
                                                            CommandParameter="{Binding}" Content="{Binding Accept}" />
                                                </StackPanel>
                                            </Grid>
                                        </ui:FASettingsExpander.Header>
                                        <ui:FASettingsExpanderItem Description="{Binding ReceiveSummary}" IsVisible="{Binding IsTrade}">
                                            <ui:FASettingsExpanderItem.Content>
                                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                                    <ItemsControl ItemsSource="{Binding ReceiveItemImageUrls}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="5" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="x:String">
                                                                <spp:Image2
                                                                    Width="64"
                                                                    Height="64"
                                                                    EnableCancelToken="False"
                                                                    Source="{Binding}"
                                                                    Stretch="Uniform" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </ui:FASettingsExpanderItem.Content>
                                        </ui:FASettingsExpanderItem>
                                        <ui:FASettingsExpanderItem Description="{Binding SendSummary}" IsVisible="{Binding IsTrade}">
                                            <ui:FASettingsExpanderItem.Content>
                                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                                    <ItemsControl ItemsSource="{Binding SendItemImageUrls}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="5" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="x:String">
                                                                <spp:Image2
                                                                    Width="64"
                                                                    Height="64"
                                                                    EnableCancelToken="False"
                                                                    Source="{Binding}"
                                                                    Stretch="Uniform" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </ui:FASettingsExpanderItem.Content>
                                        </ui:FASettingsExpanderItem>
                                    </ui:FASettingsExpander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Panel>
            </Grid>
        </Panel>
    </spp:ContentLoader>
</UserControl>

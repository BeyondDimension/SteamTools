<UserControl
    x:Class="BD.WTTS.UI.Views.Pages.SteamTradePage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:spp="https://steampp.net/ui"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:CompileBindings="True"
    x:DataType="spp:SteamTradePageViewModel"
    mc:Ignorable="d">
    <UserControl.Styles>
        <Style Selector="Button.trade-action">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.trade-card">
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Styles>
    <Grid>
        <ScrollViewer x:Name="TradeLogin" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ScrollViewer.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}" FallbackValue="False">
                    <CompiledBindingExtension Path="!IsLogged" />
                    <CompiledBindingExtension Path="!IsLoading" />
                </MultiBinding>
            </ScrollViewer.IsVisible>
            <StackPanel Spacing="10" VerticalAlignment="Top">
                <spp:Snackbar IsVisible="{Binding LoginStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" IsOpen="True" IsClosable="False"
                              Severity="Warning" Message="{Binding LoginStatus}" />
                <Border Classes="trade-card">
                    <StackPanel Spacing="6">
                        <WrapPanel ItemSpacing="10" LineSpacing="6">
                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Theme="{StaticResource BodyStrongTextBlockStyle}"
                                       Text="{x:Static spp:Strings.SteamTradeLoginMode}" />
                            <ComboBox x:Name="TradeLoginMode" VerticalAlignment="Center"
                                      AutomationProperties.Name="{x:Static spp:Strings.SteamTradeLoginMode}"
                                      SelectedIndex="{Binding LoginModeIndex, Mode=TwoWay}" IsEnabled="{Binding !Login.IsBusy}">
                                <ComboBoxItem Content="{x:Static spp:Strings.SteamTradeWebLogin}" />
                                <ComboBoxItem Content="{x:Static spp:Strings.SteamTradeAppLogin}" />
                            </ComboBox>
                        </WrapPanel>
                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Text="{x:Static spp:Strings.SteamTradeMobileLoginHint}" />
                        <spp:Snackbar x:Name="TradeAppLoginWarning" IsVisible="{Binding Login.RequireMobileSession}"
                                      IsOpen="True" IsClosable="False" Severity="Warning"
                                      Message="{x:Static spp:Strings.SteamTradeMobileLoginWarning}" />
                    </StackPanel>
                </Border>
                <spp:SteamLoginView DataContext="{Binding Login}" ShowRememberLogin="True"
                                    RememberLogin="{Binding $parent[spp:SteamTradePage].((spp:SteamTradePageViewModel)DataContext).RememberLogin, Mode=TwoWay}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel x:Name="TradeLoading" Spacing="10" VerticalAlignment="Top" IsVisible="{Binding IsLoading}">
            <ProgressBar Height="4" MinHeight="0" IsIndeterminate="True" />
            <TextBlock Text="{x:Static spp:Strings.Loading}" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid x:Name="TradeResults" RowDefinitions="Auto,Auto,*">
            <Grid.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}" FallbackValue="False">
                    <CompiledBindingExtension Path="IsLogged" />
                    <CompiledBindingExtension Path="!IsLoading" />
                </MultiBinding>
            </Grid.IsVisible>
            <spp:FlexPanel x:Name="TradeToolbar" Margin="0,0,0,10" AlignItems="Center" ColumnSpacing="12" RowSpacing="6">
                <WrapPanel x:Name="TradeSelectionActions" ItemSpacing="8" LineSpacing="6"
                           IsVisible="{Binding !!Confirmations.Count}" IsEnabled="{Binding CanChangeConfirmations}">
                    <CheckBox x:Name="TradeSelectAll" VerticalAlignment="Center" Command="{Binding SelectAllCommand}"
                              Content="{x:Static spp:Strings.SelectAll}" IsChecked="{Binding SelectedAll, Mode=OneWay}" />
                    <StackPanel x:Name="TradeBatchActions" Orientation="Horizontal" Spacing="8">
                        <Button Classes="trade-action" Command="{Binding CancelAllTrade}"
                                AutomationProperties.Name="{x:Static spp:Strings.BatchReject}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:FASymbolIcon Symbol="Cancel" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static spp:Strings.BatchReject}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="trade-action" Command="{Binding ConfirmAllTrade}"
                                AutomationProperties.Name="{x:Static spp:Strings.BatchPass}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:FASymbolIcon Symbol="Checkmark" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static spp:Strings.BatchPass}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </WrapPanel>
                <WrapPanel x:Name="TradeSessionActions" HorizontalAlignment="Right" ItemSpacing="8" LineSpacing="6"
                           IsEnabled="{Binding !IsOperatingConfirmations}">
                    <Button Classes="trade-action" Command="{Binding Refresh}"
                            AutomationProperties.Name="{x:Static spp:Strings.Refresh}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ui:FASymbolIcon Symbol="Refresh" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static spp:Strings.Refresh}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="trade-action" Command="{Binding Logout}"
                            AutomationProperties.Name="{x:Static spp:Strings.Logout}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ui:FASymbolIcon Symbol="Open" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static spp:Strings.Logout}" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </spp:FlexPanel>
            <StackPanel Grid.Row="1">
                <Border x:Name="TradeError" Margin="0,0,0,8" Classes="trade-card"
                        IsVisible="{Binding ConfirmationLoadError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <Grid ColumnDefinitions="20,*" ColumnSpacing="8">
                        <ui:FASymbolIcon Symbol="Alert" VerticalAlignment="Top"
                                         Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding ConfirmationLoadError}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Grid>
                </Border>
                <spp:Snackbar IsVisible="{Binding LoginStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Margin="0,0,0,8" IsOpen="True"
                              IsClosable="False" Severity="Warning" Message="{Binding LoginStatus}" />
            </StackPanel>
            <Border x:Name="TradeEmpty" Grid.Row="2" Classes="trade-card" VerticalAlignment="Top">
                <Border.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}" FallbackValue="False">
                        <CompiledBindingExtension Path="HasLoadedConfirmations" />
                        <CompiledBindingExtension Path="!Confirmations.Count" />
                        <CompiledBindingExtension Path="ConfirmationLoadError" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                    </MultiBinding>
                </Border.IsVisible>
                <TextBlock Text="{x:Static spp:Strings.LocalAuth_AuthTrade_Null}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Border>
            <ScrollViewer x:Name="TradeConfirmationList" Grid.Row="2" IsVisible="{Binding !!Confirmations.Count}"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Confirmations}" VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type spp:SteamTradeConfirmationModel}">
                            <Border Classes="trade-card">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="Auto,40,*" ColumnSpacing="8">
                                        <CheckBox VerticalAlignment="Top" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  IsEnabled="{Binding $parent[spp:SteamTradePage].((spp:SteamTradePageViewModel)DataContext).CanChangeConfirmations}"
                                                  AutomationProperties.Name="{Binding TypeNameText}" />
                                        <Border Grid.Column="1" Height="40" VerticalAlignment="Top" CornerRadius="6"
                                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <Panel>
                                                <PathIcon Width="20" Height="20" Data="{StaticResource Steam}"
                                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                          IsVisible="{Binding Icon, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                                                <spp:Image2 EnableCancelToken="False" Source="{Binding Icon}"
                                                            Margin="3" Stretch="Uniform"
                                                            IsVisible="{Binding Icon, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            </Panel>
                                        </Border>
                                        <StackPanel Grid.Column="2" Spacing="3">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding TypeNameText}" TextWrapping="Wrap" />
                                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Text="{Binding CreateTime, StringFormat='{}{0:g}'}" TextWrapping="Wrap" />
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       IsVisible="{Binding SendSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                       Text="{Binding SendSummary}" TextWrapping="Wrap" />
                                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       IsVisible="{Binding ReceiveSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                       Text="{Binding ReceiveSummary}" TextWrapping="Wrap" />
                                            <TextBlock Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                       IsVisible="{Binding Warn, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                       Text="{Binding Warn}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                    <WrapPanel HorizontalAlignment="Right" ItemSpacing="8" LineSpacing="6"
                                               IsEnabled="{Binding $parent[spp:SteamTradePage].((spp:SteamTradePageViewModel)DataContext).CanChangeConfirmations}">
                                        <Button Classes="trade-action" Command="{Binding $parent[spp:SteamTradePage].((spp:SteamTradePageViewModel)DataContext).CancelTradeCommand}"
                                                CommandParameter="{Binding}" Content="{Binding Cancel, TargetNullValue={x:Static spp:Strings.Cancel}}" />
                                        <Button Classes="accent trade-action" Command="{Binding $parent[spp:SteamTradePage].((spp:SteamTradePageViewModel)DataContext).ConfirmTradeCommand}"
                                                CommandParameter="{Binding}" Content="{Binding Accept, TargetNullValue={x:Static spp:Strings.Confirm}}" />
                                    </WrapPanel>
                                    <Expander HorizontalContentAlignment="Stretch" Header="{x:Static spp:Strings.ViewDetailedData}">
                                        <Expander.IsVisible>
                                            <MultiBinding Converter="{x:Static BoolConverters.Or}" FallbackValue="False">
                                                <CompiledBindingExtension Path="!!SendItemImageUrls.Count" />
                                                <CompiledBindingExtension Path="!!ReceiveItemImageUrls.Count" />
                                                <CompiledBindingExtension Path="HasDetailLoadError" />
                                            </MultiBinding>
                                        </Expander.IsVisible>
                                        <StackPanel Spacing="8">
                                            <TextBlock IsVisible="{Binding HasDetailLoadError}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       Text="{x:Static spp:Strings.SteamTradeDetailLoadError}" />
                                            <StackPanel Spacing="4" IsVisible="{Binding !!SendItemImageUrls.Count}">
                                                <TextBlock Text="{Binding SendSummary}" TextWrapping="Wrap" />
                                                <ItemsControl ItemsSource="{Binding SendItemImageUrls}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel ItemSpacing="6" LineSpacing="6" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="x:String">
                                                            <spp:Image2 Width="60" Height="60" EnableCancelToken="False" Source="{Binding}" Stretch="Uniform" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            <StackPanel Spacing="4" IsVisible="{Binding !!ReceiveItemImageUrls.Count}">
                                                <TextBlock Text="{Binding ReceiveSummary}" TextWrapping="Wrap" />
                                                <ItemsControl ItemsSource="{Binding ReceiveItemImageUrls}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel ItemSpacing="6" LineSpacing="6" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="x:String">
                                                            <spp:Image2 Width="60" Height="60" EnableCancelToken="False" Source="{Binding}" Stretch="Uniform" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

<UserControl
			xmlns="https://github.com/avaloniaui"
			xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			xmlns:spp="https://steampp.net/ui"
			xmlns:s="https://steampp.net/services"
			d:DesignWidth="400"
			d:DesignHeight="250"
			x:DataType="spp:AddSteamAccountPhoneNumberPageViewModel"
			x:CompileBindings="True"
      x:Class="BD.WTTS.UI.Views.Controls.AddSteamAccountPhoneNumberPage"
			mc:Ignorable="d">

	<Grid RowDefinitions="Auto,*">

		<spp:Stepper SelectedIndex="{Binding SelectIndex, Mode=OneWay}">
			<spp:StepperItem Content="{x:Static spp:Strings.Steam_BindTel}" />
			<spp:StepperItem Content="{x:Static spp:Strings.Steam_ConfirmEmailLink}" />
			<spp:StepperItem Content="{x:Static spp:Strings.TelCode}" />
		</spp:Stepper>

		<spp:ContentLoader
				Grid.Row="1"
				IsLoading="{Binding IsLoading}"
				IsShowNoResultText="False">
			<Carousel IsVisible="{Binding !IsLoading}" SelectedIndex="{Binding SelectIndex, Mode=OneWay}">
				<StackPanel
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Spacing="10">

					<DockPanel>
						<TextBlock
								Margin="0,0,0,6"
								DockPanel.Dock="Top"
								Text="{x:Static spp:Strings.User_Phone}" />
						<TextBox
								Name="PhoneNumberText"
								MaxWidth="300"
								Text="{Binding PhoneNumberText}"
								PlaceholderText="+8601234567890" />
					</DockPanel>

					<Button
							MaxWidth="280"
							HorizontalAlignment="Stretch"
							HorizontalContentAlignment="Center"
							Command="{Binding StartBindingCommand}"
							Content="{x:Static spp:Strings.Continue}" />
				</StackPanel>

				<StackPanel
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Spacing="10">
					<Button
							MaxWidth="280"
							HorizontalAlignment="Stretch"
							HorizontalContentAlignment="Center"
							Command="{Binding ConfirmEmailCommand}"
							Content="{x:Static spp:Strings.Continue}" />
				</StackPanel>

				<StackPanel
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Spacing="10">

					<DockPanel>
						<TextBlock
								Margin="0,0,0,6"
								DockPanel.Dock="Top"
								Text="{x:Static spp:Strings.Error_PleaseEnterTelCode}" />
						<TextBox
								Name="CodeText"
								MaxWidth="300"
								Text="{Binding CodeText}" />
					</DockPanel>

					<Button
							MaxWidth="280"
							HorizontalAlignment="Stretch"
							HorizontalContentAlignment="Center"
							Command="{Binding VerifyCodeCommand}"
							Content="{x:Static spp:Strings.Continue}" />
				</StackPanel>
			</Carousel>
		</spp:ContentLoader>
	</Grid>
</UserControl>
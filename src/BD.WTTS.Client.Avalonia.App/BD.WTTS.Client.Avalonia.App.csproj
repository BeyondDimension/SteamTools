<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AssemblyName>Steam++</AssemblyName>
		<OutputType>Exe</OutputType>
		<RootNamespace>BD.WTTS</RootNamespace>
		<DefineConstants>AVALONIA;$(DefineConstants)</DefineConstants>
		<ApplicationId>net.steampp.app</ApplicationId>
		<ApplicationManifest>Properties\app.manifest</ApplicationManifest>
	</PropertyGroup>

	<PropertyGroup Condition="'$(WttsNativeAot)' == 'true'">
		<PublishAot>true</PublishAot>
		<SelfContained>true</SelfContained>
		<OptimizationPreference Condition="'$(OptimizationPreference)' == ''">Size</OptimizationPreference>
		<InvariantGlobalization>false</InvariantGlobalization>
	</PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release' AND '$(WttsNativeAot)' != 'true' AND $(RuntimeIdentifier.StartsWith('win-'))">
        <PublishReadyToRun Condition="'$(PublishReadyToRun)' == ''">true</PublishReadyToRun>
    </PropertyGroup>

	<PropertyGroup Condition="$(TargetFramework.StartsWith('net3')) OR $(TargetFramework.StartsWith('net4')) OR $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<ApplicationIcon Condition="'$(Configuration)'=='Release'">..\..\res\icons\app\v3\Icon.ico</ApplicationIcon>
		<ApplicationIcon Condition="'$(Configuration)'=='Debug'">..\..\res\icons\app\v3\Icon.ico</ApplicationIcon>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Release' AND ($(TargetFramework.StartsWith('net3')) OR $(TargetFramework.StartsWith('net4')) OR $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows')">
		<OutputType>WinExe</OutputType>
	</PropertyGroup>

	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'macos'">
		<RuntimeIdentifiers>osx-x64;osx-arm64</RuntimeIdentifiers>
	</PropertyGroup>

	<!-- The SDK merges per-RID bundles with lipo; thin dependencies that already ship universal binaries first. -->
	<Target Name="ThinUniversalMacOSNativeLibraries" AfterTargets="_CreateAppBundle"
			Condition="'$(RuntimeIdentifier)' == 'osx-x64' OR '$(RuntimeIdentifier)' == 'osx-arm64'">
		<PropertyGroup>
			<_MacOSNativeArchitecture Condition="'$(RuntimeIdentifier)' == 'osx-x64'">x86_64</_MacOSNativeArchitecture>
			<_MacOSNativeArchitecture Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">arm64</_MacOSNativeArchitecture>
		</PropertyGroup>
		<Exec Command="set -eu; for library in &quot;$(MSBuildProjectDirectory)/$(_AppBundlePath)Contents/MonoBundle/&quot;*.dylib; do if [ -f &quot;$library&quot; ]; then if lipo -verify_arch x86_64 &quot;$library&quot; &gt;/dev/null 2&gt;&amp;1 &amp;&amp; lipo -verify_arch arm64 &quot;$library&quot; &gt;/dev/null 2&gt;&amp;1; then lipo -thin $(_MacOSNativeArchitecture) &quot;$library&quot; -output &quot;$library.thin&quot;; mv &quot;$library.thin&quot; &quot;$library&quot;; fi; fi; done" />
	</Target>

	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<AllowedReferenceRelatedFileExtensions>
			<!-- Prevent default XML and PDB files copied to output in RELEASE. 
           		 Only *.allowedextension files will be included, which doesn't exist in my case.
       		-->
			.allowedextension
		</AllowedReferenceRelatedFileExtensions>
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
	</PropertyGroup>

	<PropertyGroup>
		<!-- 👇 GC 配置 MSBuild 属性 -->
		<ServerGarbageCollection>false</ServerGarbageCollection>
		<RetainVMGarbageCollection>false</RetainVMGarbageCollection>
		<ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
	</PropertyGroup>

	<ItemGroup>
		<!-- 👇 GC 配置 runtimeconfig.json -->
		<RuntimeHostConfigurationOption Include="System.GC.HighMemoryPercent" Value="75" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\ImplicitUsings.MessagePack.cs">
			<LinkBase>Properties</LinkBase>
		</Compile>
		<Compile Include="..\ImplicitUsings.JsonProperty.cs">
			<LinkBase>Properties</LinkBase>
		</Compile>
		<Compile Include="..\ImplicitUsings.SQLite.cs">
			<LinkBase>Properties</LinkBase>
		</Compile>
		<Compile Include="..\ImplicitUsings.Repositories.cs">
			<LinkBase>Properties</LinkBase>
		</Compile>
		<Compile Include="..\ImplicitUsings.Services.cs">
			<LinkBase>Properties</LinkBase>
		</Compile>
		<Compile Include="..\ImplicitUsings.ReactiveUI.cs">
			<LinkBase>Properties</LinkBase>
		</Compile>
		<Compile Include="..\ImplicitUsings.Models.cs">
			<LinkBase>Properties</LinkBase>
		</Compile>
		<Compile Include="..\ImplicitUsings.UI.cs">
			<LinkBase>Properties</LinkBase>
		</Compile>
		<Compile Include="..\ImplicitUsings.UI.ViewModels.cs">
			<LinkBase>Properties</LinkBase>
		</Compile>
		<Compile Include="..\ImplicitUsings.Settings.cs">
			<LinkBase>Properties</LinkBase>
		</Compile>
		<Compile Include="..\ImplicitUsings.AutoMapper.cs">
			<LinkBase>Properties</LinkBase>
		</Compile>
		<Compile Include="..\ImplicitUsings.WTTS.cs">
			<LinkBase>Properties</LinkBase>
		</Compile>
		<Compile Include="..\ImplicitUsings.MSEX.cs">
			<LinkBase>Properties</LinkBase>
		</Compile>
		<Compile Include="..\ImplicitUsings.Nito.cs">
			<LinkBase>Properties</LinkBase>
		</Compile>
		<Compile Include="..\ImplicitUsings.NLog.cs">
			<LinkBase>Properties</LinkBase>
		</Compile>
		<Compile Include="..\ImplicitUsings.Avalonia.cs">
			<LinkBase>Properties</LinkBase>
		</Compile>
		<Compile Include="..\ImplicitUsings.UI.Views.cs">
			<LinkBase>Properties</LinkBase>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\BD.WTTS.Client.Avalonia\BD.WTTS.Client.Avalonia.csproj" />
		<ProjectReference Include="..\BD.WTTS.Client\BD.WTTS.Client.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(WttsUseSimdSkia)' == 'true'">
		<PackageReference Include="SimdSkia.Avalonia.Desktop" />
		<None Update="Properties\SimdSkia-MIT.txt" TargetPath="licenses\SimdSkia\SimdSkia-MIT.txt" CopyToPublishDirectory="PreserveNewest" />
		<None Include="$(NuGetPackageRoot)simdskia.avalonia/$(Version_SimdSkia)/licenses/Avalonia-MIT.txt;
					   $(NuGetPackageRoot)simdskia.core/$(Version_SimdSkia)/licenses/Clipper2-BSL-1.0.txt;
					   $(NuGetPackageRoot)simdskia.core/$(Version_SimdSkia)/licenses/Skia-BSD.txt;
					   $(NuGetPackageRoot)simdskia.compatibility/$(Version_SimdSkia)/licenses/SkiaSharp-MIT.txt;
					   $(NuGetPackageRoot)simdskia.imaging/$(Version_SimdSkia)/licenses/Apache-2.0.txt;
					   $(NuGetPackageRoot)simdskia.imaging/$(Version_SimdSkia)/licenses/Sdcb.SimdCodecs-MIT.txt;
					   $(NuGetPackageRoot)simdskia.text/$(Version_SimdSkia)/licenses/SharpFont-MIT.txt"
			  TargetPath="licenses\SimdSkia\%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
		<None Include="..\..\ref\FluentAvalonia\LICENSE" TargetPath="licenses\FluentAvalonia\LICENSE" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

	<!-- Debug discovers these projects' output DLLs rather than linking them into the app. -->
	<ItemGroup Condition="'$(WttsNativeAot)' == 'true' OR ('$(Configuration)' == 'Debug' AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows')">
		<ProjectReference Include="..\BD.WTTS.Client.Plugins.Accelerator\BD.WTTS.Client.Plugins.Accelerator.csproj" Aliases="AcceleratorPlugin" />
		<ProjectReference Include="..\BD.WTTS.Client.Plugins.GameAccount\BD.WTTS.Client.Plugins.GameAccount.csproj" Aliases="GameAccountPlugin" />
		<ProjectReference Include="..\BD.WTTS.Client.Plugins.GameList\BD.WTTS.Client.Plugins.GameList.csproj" Aliases="GameListPlugin" />
		<ProjectReference Include="..\BD.WTTS.Client.Plugins.Authenticator\BD.WTTS.Client.Plugins.Authenticator.csproj" Aliases="AuthenticatorPlugin" />
		<ProjectReference Include="..\BD.WTTS.Client.Plugins.SteamIdleCard\BD.WTTS.Client.Plugins.SteamIdleCard.csproj" Aliases="SteamIdleCardPlugin" />
		<ProjectReference Include="..\BD.WTTS.Client.Plugins.ArchiSteamFarmPlus\BD.WTTS.Client.Plugins.ArchiSteamFarmPlus.csproj" Aliases="ArchiSteamFarmPlusPlugin"
						  Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />
		<ProjectReference Include="..\BD.WTTS.Client.Plugins.GameTools\BD.WTTS.Client.Plugins.GameTools.csproj" Aliases="GameToolsPlugin"
						  Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />
	</ItemGroup>

	<ItemGroup Condition="'$(WttsNativeAot)' != 'true' AND '$(Configuration)' == 'Debug' AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<ProjectReference Update="..\BD.WTTS.Client.Plugins.*\*.csproj" ReferenceOutputAssembly="false" Private="false" />
		<ProjectReference Include="..\BD.WTTS.Client.Plugins.Accelerator.ReverseProxy\BD.WTTS.Client.Plugins.Accelerator.ReverseProxy.csproj" ReferenceOutputAssembly="false" Private="false" />
	</ItemGroup>

	<Import Project="..\TFM_NETX_WITH_DESKTOP.props" />

</Project>

<UserControl
	x:Class="BD.WTTS.UI.Views.Controls.SteamLoginView"
	x:Name="Root"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:s="https://steampp.net/services"
	xmlns:spp="https://steampp.net/ui"
	xmlns:ui="using:FluentAvalonia.UI.Controls"
	x:DataType="spp:SteamLoginViewModel"
	x:CompileBindings="True">
	<UserControl.Styles>
		<Style Selector="TextBox">
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="MinHeight" Value="36" />
		</Style>
		<Style Selector="Button.primary">
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="MinHeight" Value="36" />
		</Style>
		<Style Selector="Button.loginModeSelected">
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
			<Setter Property="BorderThickness" Value="0,0,0,2" />
			<Setter Property="CornerRadius" Value="0,0,0,0" />
		</Style>
	</UserControl.Styles>
	<Grid RowDefinitions="*,Auto">
		<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
		              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
			<StackPanel MaxWidth="760" Margin="12" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
				<Grid x:Name="FormsLayout" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
				      ColumnSpacing="16" RowSpacing="16">
					<Border x:Name="AccountPanel" Grid.Column="0" Padding="18" MinWidth="300"
					        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
					        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
					        BorderThickness="1" CornerRadius="8">
						<Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
							<StackPanel Orientation="Horizontal" Spacing="10">
								<PathIcon Width="26" Height="26" Data="{StaticResource Steam}" />
								<TextBlock FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"
								           Text="{x:Static spp:Strings.AccountLogin}" />
							</StackPanel>
							<StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="10" IsEnabled="{Binding !IsBusy}"
							            IsVisible="{Binding !RequiresManualGuardCode}">
								<TextBlock Text="{x:Static spp:Strings.Steam_User}" />
								<TextBox Text="{Binding UserName}" KeyUp="OnCredentialKeyUp"
								         PlaceholderText="{x:Static spp:Strings.Steam_User}" />
								<TextBlock Text="{x:Static spp:Strings.Steam_Password}" />
								<TextBox Text="{Binding Password}" KeyUp="OnCredentialKeyUp"
								         Classes="revealPasswordButton" PasswordChar="●"
								         PlaceholderText="{x:Static spp:Strings.Steam_Password}" />
								<CheckBox IsVisible="{Binding #Root.ShowRememberLogin}" IsChecked="{Binding #Root.RememberLogin, Mode=TwoWay}"
								          Content="{x:Static spp:Strings.User_Rememberme}" />
							</StackPanel>
							<StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="10" IsEnabled="{Binding !IsBusy}"
							            IsVisible="{Binding RequiresManualGuardCode}">
								<TextBlock Text="{Binding UserName}" FontWeight="SemiBold" TextWrapping="Wrap" />
								<TextBlock IsVisible="{Binding Requires2FA}" TextWrapping="Wrap"
								           Text="{x:Static spp:Strings.LocalAuth_Steam2FACodeTip}" />
								<TextBlock IsVisible="{Binding RequiresEmailAuth}" TextWrapping="Wrap"
								           Text="{x:Static spp:Strings.LocalAuth_EmailCodeTip}" />
								<TextBox Text="{Binding GuardCode}" KeyUp="OnCredentialKeyUp" FontSize="22" TextAlignment="Center" />
								<Button Command="{Binding CancelCommand}"
								        Content="{x:Static spp:Strings.Back}" />
							</StackPanel>
							<Button Grid.Row="2" Classes="primary" Command="{Binding LoginCommand}" IsEnabled="{Binding !IsBusy}"
							        Content="{x:Static spp:Strings.Login}" />
						</Grid>
					</Border>
					<Border x:Name="QrPanel" Grid.Column="1" MinWidth="250" MinHeight="250" Padding="18"
					        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
					        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
					        BorderThickness="1" CornerRadius="8">
						<StackPanel Spacing="12">
							<TextBlock FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"
							           Text="{x:Static spp:Strings.ScanQRCode}" />
							<Border Width="200" Height="200" Padding="8" Background="White" CornerRadius="8"
							        HorizontalAlignment="Center"
							        IsVisible="{Binding QrCodeImage, Converter={StaticResource IsNullConverter}, ConverterParameter=invert}">
								<spp:Image2 Source="{Binding QrCodeImage}" KeepSourceStreamOpen="True" Stretch="Uniform" />
							</Border>
							<ProgressBar IsIndeterminate="True" Height="3">
								<ProgressBar.IsVisible>
									<MultiBinding Converter="{x:Static BoolConverters.And}">
										<CompiledBindingExtension Path="IsQrBusy" />
										<CompiledBindingExtension Path="QrCodeImage" Converter="{StaticResource IsNullConverter}" />
									</MultiBinding>
								</ProgressBar.IsVisible>
							</ProgressBar>
							<TextBlock Text="{Binding QrStatusMessage}" TextWrapping="Wrap" TextAlignment="Center"
							           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
							<Button Command="{Binding QrLoginCommand}" IsVisible="{Binding HasQrError}"
							        IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Center"
							        Content="{x:Static spp:Strings.Retry}" />
						</StackPanel>
					</Border>
				</Grid>
				<Border x:Name="CookiePanel" IsVisible="False" Padding="18" MinWidth="300" MaxWidth="400"
				        HorizontalAlignment="Stretch" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
				        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
					<StackPanel Spacing="10" IsEnabled="{Binding !IsBusy}">
						<TextBlock FontSize="18" FontWeight="SemiBold"
						           Text="{x:Static spp:Strings.CookieLogin}" />
						<TextBlock Text="sessionid" />
						<TextBox Text="{Binding SessionId}" KeyUp="OnCookieKeyUp" PasswordChar="●" />
						<TextBlock Text="steamLoginSecure" />
						<TextBox Text="{Binding SteamLoginSecure}" KeyUp="OnCookieKeyUp" PasswordChar="●" />
						<CheckBox IsVisible="{Binding #Root.ShowRememberLogin}" IsChecked="{Binding #Root.RememberLogin, Mode=TwoWay}"
						          Content="{x:Static spp:Strings.User_Rememberme}" />
						<Button Classes="primary" Command="{Binding CookieLoginCommand}"
						        Content="{x:Static spp:Strings.Login}" />
					</StackPanel>
				</Border>
				<Border x:Name="SavedAccountPanel" IsVisible="False" Padding="18" MinWidth="300" MaxWidth="400"
				        HorizontalAlignment="Stretch" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
				        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
					<StackPanel Spacing="10" IsEnabled="{Binding !IsBusy}">
						<TextBlock FontSize="18" FontWeight="SemiBold" Text="{x:Static spp:Strings.L10nApp_TokenConfirmationLogin}" />
						<TextBlock Text="{x:Static spp:Strings.L10nApp_SelectConfirmedTokenAccount}" TextWrapping="Wrap" />
						<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
							<ComboBox HorizontalAlignment="Stretch" MinWidth="0" MinHeight="36" VerticalAlignment="Center"
							          VerticalContentAlignment="Center"
							          ItemsSource="{Binding SavedAccounts}" SelectedItem="{Binding SelectedSavedAccount, Mode=TwoWay}"
								          PlaceholderText="{x:Static spp:Strings.L10nApp_SelectTokenAccount}">
								<ComboBox.ItemTemplate>
									<DataTemplate x:DataType="spp:SteamSavedLoginAccount">
										<TextBlock Text="{Binding DisplayName}" />
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
							<Button Grid.Column="1" Width="36" MinHeight="36" Padding="0"
							        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
								        Command="{Binding LoadSavedAccountsCommand}" AutomationProperties.Name="{x:Static spp:Strings.L10nApp_RefreshTokenAccounts}"
								        ToolTip.Tip="{x:Static spp:Strings.L10nApp_RefreshTokenAccounts}" Theme="{StaticResource TransparentButton}">
								<ui:FASymbolIcon Symbol="Refresh" />
							</Button>
						</Grid>
						<CheckBox IsVisible="{Binding #Root.ShowRememberLogin}" IsChecked="{Binding #Root.RememberLogin, Mode=TwoWay}"
						          Content="{x:Static spp:Strings.User_Rememberme}" />
						<Button Classes="primary" Command="{Binding SavedAccountLoginCommand}" Content="{x:Static spp:Strings.L10nApp_LoginSelectedAccount}"
						        IsEnabled="{Binding SelectedSavedAccount, Converter={StaticResource IsNullConverter}, ConverterParameter=invert}" />
					</StackPanel>
				</Border>
				<ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" Height="3" />
				<TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" TextAlignment="Center"
				           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
				<Button Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" HorizontalAlignment="Center"
				        Content="{x:Static spp:Strings.Cancel}" />
			</StackPanel>
		</ScrollViewer>
		<StackPanel Grid.Row="1" Margin="0,10" Orientation="Horizontal" HorizontalAlignment="Center"
		            VerticalAlignment="Bottom" IsVisible="{Binding AllowCookieLogin}">
			<Button x:Name="AccountSwitch" Classes="loginModeSelected" Theme="{StaticResource HyperlinkButton}"
			        IsEnabled="{Binding !IsBusy}" Click="OnAccountMode"
			        Content="{x:Static spp:Strings.AccountLogin}" />
			<Separator Height="18" Margin="10,0" VerticalAlignment="Stretch" Classes="Vertical"
			           Background="{DynamicResource ButtonBorderBrush}" IsHitTestVisible="False" />
			<Button x:Name="CookieSwitch" Theme="{StaticResource HyperlinkButton}"
			        IsEnabled="{Binding !IsBusy}" Click="OnCookieMode"
			        Content="{x:Static spp:Strings.CookieLogin}" />
			<Separator x:Name="SavedAccountSeparator" Height="18" Margin="10,0" VerticalAlignment="Stretch" Classes="Vertical"
			           Background="{DynamicResource ButtonBorderBrush}" IsHitTestVisible="False" />
			<Button x:Name="SavedAccountSwitch" Theme="{StaticResource HyperlinkButton}"
				        IsEnabled="{Binding !IsBusy}" Click="OnSavedAccountMode" Content="{x:Static spp:Strings.L10nApp_TokenLogin}" />
		</StackPanel>
	</Grid>
</UserControl>
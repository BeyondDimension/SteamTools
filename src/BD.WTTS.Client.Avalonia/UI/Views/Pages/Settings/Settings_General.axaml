<UserControl
    x:Class="BD.WTTS.UI.Views.Pages.Settings_General"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ms="https://steampp.net/settings"
    xmlns:s="https://steampp.net/services"
    xmlns:spp="https://steampp.net/ui"
    xmlns:spp_enums="using:BD.WTTS.Enums"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    d:DesignHeight="680"
    d:DesignWidth="1080"
    x:CompileBindings="True"
    x:DataType="spp:SettingsPageViewModel"
    mc:Ignorable="d">
    <StackPanel Spacing="{StaticResource SettingsSpacing}">
        <TextBlock
            Margin="0,0,0,10"
            Text="{x:Static spp:Strings.Settings_General}"
            Theme="{StaticResource SubtitleTextBlockStyle}" />
        <spp:OptionsDisplayItem
            Description="{x:Static spp:Strings.Settings_StartupAutoRun}"
            Header="{x:Static spp:Strings.Settings_General_StartAutoRun}"
            IsVisible="{spp:OnPlatform Windows}">
            <spp:OptionsDisplayItem.Icon>
                <ui:FAFontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE770;" />
            </spp:OptionsDisplayItem.Icon>
            <spp:OptionsDisplayItem.ActionButton>
                <ToggleSwitch Classes="LeftContent" IsChecked="{Binding Source={x:Static ms:GeneralSettings.AutoRunOnStartup}, Path=Value, Mode=TwoWay}" />
            </spp:OptionsDisplayItem.ActionButton>
        </spp:OptionsDisplayItem>

        <spp:OptionsDisplayItem Description="{x:Static spp:Strings.Settings_StartupNoShowMainWindow}" Header="{x:Static spp:Strings.Settings_General_RuningMinimize}">
            <spp:OptionsDisplayItem.Icon>
                <ui:FAFontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xEA6C;" />
            </spp:OptionsDisplayItem.Icon>
            <spp:OptionsDisplayItem.ActionButton>
                <ToggleSwitch Classes="LeftContent" IsChecked="{Binding Source={x:Static ms:GeneralSettings.MinimizeOnStartup}, Path=Value, Mode=TwoWay}" />
            </spp:OptionsDisplayItem.ActionButton>
        </spp:OptionsDisplayItem>

        <spp:OptionsDisplayItem Description="{x:Static spp:Strings.Settings_General_EnableTrayIcon_Tip}" Header="{x:Static spp:Strings.Settings_General_EnableTrayIcon}">
            <spp:OptionsDisplayItem.Icon>
                <ui:FAFontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE9E9;" />
            </spp:OptionsDisplayItem.Icon>
            <spp:OptionsDisplayItem.ActionButton>
                <ToggleSwitch Classes="LeftContent" IsChecked="{Binding Source={x:Static ms:GeneralSettings.TrayIcon}, Path=Value, Mode=TwoWay}" />
            </spp:OptionsDisplayItem.ActionButton>
        </spp:OptionsDisplayItem>

        <spp:OptionsDisplayItem Header="{x:Static spp:Strings.Settings_General_AutoCheckUpdate}">
            <spp:OptionsDisplayItem.Icon>
                <ui:FAFontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE895;" />
            </spp:OptionsDisplayItem.Icon>
            <spp:OptionsDisplayItem.ActionButton>
                <ToggleSwitch Classes="LeftContent" IsChecked="{Binding Source={x:Static ms:GeneralSettings.AutoCheckAppUpdate}, Path=Value, Mode=TwoWay}" />
            </spp:OptionsDisplayItem.ActionButton>
        </spp:OptionsDisplayItem>

        <spp:OptionsDisplayItem Header="{x:Static spp:Strings.Settings_General_UpdateChannel}" IsVisible="{spp:OnPlatform OfficialRelease}">
            <spp:OptionsDisplayItem.Icon>
                <ui:FAFontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE71D;" />
            </spp:OptionsDisplayItem.Icon>
            <spp:OptionsDisplayItem.ActionButton>
                <ComboBox SelectedItem="{Binding Source={x:Static ms:GeneralSettings.UpdateChannel}, Path=Value, Mode=TwoWay, Converter={StaticResource EnumConverter}, ConverterParameter={x:Type spp_enums:UpdateChannelType}}">
                    <ComboBox.Items>
                        <spp_enums:UpdateChannelType>Auto</spp_enums:UpdateChannelType>
                        <spp_enums:UpdateChannelType>GitHub</spp_enums:UpdateChannelType>
                        <spp_enums:UpdateChannelType>Official</spp_enums:UpdateChannelType>
                    </ComboBox.Items>
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="spp_enums:UpdateChannelType">
                            <TextBlock Text="{Binding ., Converter={StaticResource EnumLocalizationNameConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </spp:OptionsDisplayItem.ActionButton>
        </spp:OptionsDisplayItem>

        <spp:OptionsDisplayItem Description="{x:Static spp:Strings.Settings_RestartEffective}" Header="{x:Static spp:Strings.Settings_General_UseGPURendering}">
            <spp:OptionsDisplayItem.Icon>
                <ui:FAFontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE950;" />
            </spp:OptionsDisplayItem.Icon>
            <spp:OptionsDisplayItem.ActionButton>
                <ToggleSwitch Classes="LeftContent" IsChecked="{Binding Source={x:Static ms:GeneralSettings.GPU}, Path=Value, Mode=TwoWay}" />
            </spp:OptionsDisplayItem.ActionButton>
        </spp:OptionsDisplayItem>

        <spp:OptionsDisplayItem Header="{x:Static spp:Strings.L10nApp_EnablePushNotifications}">
            <spp:OptionsDisplayItem.Icon>
                <ui:FAFontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE7E7;" />
            </spp:OptionsDisplayItem.Icon>
            <spp:OptionsDisplayItem.ActionButton>
                <ToggleSwitch Classes="LeftContent" IsChecked="{Binding Source={x:Static ms:GeneralSettings.MessagePopupNotification}, Path=Value, Mode=TwoWay}" />
            </spp:OptionsDisplayItem.ActionButton>
        </spp:OptionsDisplayItem>

        <ui:FASettingsExpander
            x:Name="StorageSpace"
            Header="{x:Static spp:Strings.Settings_General_StorageSpace}"
            IsExpanded="False">
            <ui:FASettingsExpander.IconSource>
                <ui:FAFontIconSource FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE7F1;" />
            </ui:FASettingsExpander.IconSource>

            <!-- Use the item content for the full row so its actions do not depend on the theme's optional footer. -->
            <ui:FASettingsExpanderItem HorizontalContentAlignment="Stretch">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Static spp:Strings.Settings_Storage_AppFolder}" TextWrapping="Wrap" />
                        <TextBlock x:Name="AppSize" Text="{x:Static spp:Strings.Settings_General_Calcing}"
                                   Theme="{StaticResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Center" Command="{Binding OpenFolder_Click}" CommandParameter="App"
                            AutomationProperties.Name="{Binding Mode=OneTime, Source={x:Static spp:Strings.Settings_General_BrowseCustomFolder}, Converter={StaticResource StringFormatConverter}, ConverterParameter=App}"
                            Content="{x:Static spp:Strings.Settings_Storage_OpenFolder}" />
                </Grid>
            </ui:FASettingsExpanderItem>

            <ui:FASettingsExpanderItem HorizontalContentAlignment="Stretch">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Static spp:Strings.Settings_General_AppData}" TextWrapping="Wrap" />
                        <TextBlock x:Name="AppDataSize" Text="{x:Static spp:Strings.Settings_General_Calcing}"
                                   Theme="{StaticResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Center" Command="{Binding OpenFolder_Click}" CommandParameter="AppData"
                            AutomationProperties.Name="{Binding Mode=OneTime, Source={x:Static spp:Strings.Settings_General_BrowseCustomFolder}, Converter={StaticResource StringFormatConverter}, ConverterParameter=AppData}"
                            Content="{x:Static spp:Strings.Settings_Storage_OpenFolder}" />
                </Grid>
            </ui:FASettingsExpanderItem>

            <ui:FASettingsExpanderItem HorizontalContentAlignment="Stretch">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Static spp:Strings.Settings_General_CacheData}" TextWrapping="Wrap" />
                        <TextBlock x:Name="CacheSize" Text="{x:Static spp:Strings.Settings_General_Calcing}"
                                   Theme="{StaticResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Center" Command="{Binding OpenFolder_Click}" CommandParameter="Cache"
                            AutomationProperties.Name="{Binding Mode=OneTime, Source={x:Static spp:Strings.Settings_General_BrowseCustomFolder}, Converter={StaticResource StringFormatConverter}, ConverterParameter=Cache}"
                            Content="{x:Static spp:Strings.Settings_Storage_OpenFolder}" />
                </Grid>
            </ui:FASettingsExpanderItem>

            <ui:FASettingsExpanderItem HorizontalContentAlignment="Stretch">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Static spp:Strings.Settings_General_LogsData}" TextWrapping="Wrap" />
                        <TextBlock x:Name="LogSize" Text="{x:Static spp:Strings.Settings_General_Calcing}"
                                   Theme="{StaticResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="SettingsViewLogs" AutomationProperties.AutomationId="SettingsViewLogs"
                                Classes="accent" Click="ViewLogs_Click" Content="{x:Static spp:Strings.LogConsole_ViewLogs}"
                                ToolTip.Tip="{x:Static spp:Strings.LogConsole_ViewLogsDescription}" />
                        <Button Command="{Binding OpenFolder_Click}" CommandParameter="Logs"
                                AutomationProperties.Name="{Binding Mode=OneTime, Source={x:Static spp:Strings.Settings_General_BrowseCustomFolder}, Converter={StaticResource StringFormatConverter}, ConverterParameter=Logs}"
                                Content="{x:Static spp:Strings.Settings_Storage_OpenFolder}" />
                    </StackPanel>
                </Grid>
            </ui:FASettingsExpanderItem>
        </ui:FASettingsExpander>
    </StackPanel>
</UserControl>

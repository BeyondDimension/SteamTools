<UserControl
    x:Class="BD.WTTS.UI.Views.Pages.Settings_General"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ms="https://steampp.net/settings"
    xmlns:s="https://steampp.net/services"
    xmlns:spp="https://steampp.net/ui"
    xmlns:spp_enums="using:BD.WTTS.Enums"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    d:DesignHeight="680"
    d:DesignWidth="1080"
    x:CompileBindings="True"
    x:DataType="spp:SettingsPageViewModel"
    mc:Ignorable="d">
    <StackPanel Spacing="{StaticResource SettingsSpacing}">
        <TextBlock
            Margin="0,0,0,10"
            Text="{x:Static spp:Strings.Settings_General}"
            Theme="{StaticResource SubtitleTextBlockStyle}" />
        <spp:OptionsDisplayItem Description="{x:Static spp:Strings.Settings_StartupAutoRun}" Header="{x:Static spp:Strings.Settings_General_StartAutoRun}">
            <spp:OptionsDisplayItem.Icon>
                <ui:FAFontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE770;" />
            </spp:OptionsDisplayItem.Icon>
            <spp:OptionsDisplayItem.ActionButton>
                <ToggleSwitch Classes="LeftContent" IsChecked="{Binding Source={x:Static ms:GeneralSettings.AutoRunOnStartup}, Path=Value, Mode=TwoWay}" />
            </spp:OptionsDisplayItem.ActionButton>
        </spp:OptionsDisplayItem>

        <spp:OptionsDisplayItem Description="{x:Static spp:Strings.Settings_StartupNoShowMainWindow}" Header="{x:Static spp:Strings.Settings_General_RuningMinimize}">
            <spp:OptionsDisplayItem.Icon>
                <ui:FAFontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xEA6C;" />
            </spp:OptionsDisplayItem.Icon>
            <spp:OptionsDisplayItem.ActionButton>
                <ToggleSwitch Classes="LeftContent" IsChecked="{Binding Source={x:Static ms:GeneralSettings.MinimizeOnStartup}, Path=Value, Mode=TwoWay}" />
            </spp:OptionsDisplayItem.ActionButton>
        </spp:OptionsDisplayItem>

        <spp:OptionsDisplayItem Description="{x:Static spp:Strings.Settings_General_EnableTrayIcon_Tip}" Header="{x:Static spp:Strings.Settings_General_EnableTrayIcon}">
            <spp:OptionsDisplayItem.Icon>
                <ui:FAFontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE9E9;" />
            </spp:OptionsDisplayItem.Icon>
            <spp:OptionsDisplayItem.ActionButton>
                <ToggleSwitch Classes="LeftContent" IsChecked="{Binding Source={x:Static ms:GeneralSettings.TrayIcon}, Path=Value, Mode=TwoWay}" />
            </spp:OptionsDisplayItem.ActionButton>
        </spp:OptionsDisplayItem>

        <spp:OptionsDisplayItem Header="{x:Static spp:Strings.Settings_General_AutoCheckUpdate}">
            <spp:OptionsDisplayItem.Icon>
                <ui:FAFontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE895;" />
            </spp:OptionsDisplayItem.Icon>
            <spp:OptionsDisplayItem.ActionButton>
                <ToggleSwitch Classes="LeftContent" IsChecked="{Binding Source={x:Static ms:GeneralSettings.AutoCheckAppUpdate}, Path=Value, Mode=TwoWay}" />
            </spp:OptionsDisplayItem.ActionButton>
        </spp:OptionsDisplayItem>

        <spp:OptionsDisplayItem Header="{x:Static spp:Strings.Settings_General_UpdateChannel}" IsVisible="{spp:OnPlatform OfficialRelease}">
            <spp:OptionsDisplayItem.Icon>
                <ui:FAFontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE71D;" />
            </spp:OptionsDisplayItem.Icon>
            <spp:OptionsDisplayItem.ActionButton>
                <ComboBox SelectedItem="{Binding Source={x:Static ms:GeneralSettings.UpdateChannel}, Path=Value, Mode=TwoWay, Converter={StaticResource EnumConverter}, ConverterParameter={x:Type spp_enums:UpdateChannelType}}">
                    <ComboBox.Items>
                        <spp_enums:UpdateChannelType>Auto</spp_enums:UpdateChannelType>
                        <spp_enums:UpdateChannelType>GitHub</spp_enums:UpdateChannelType>
                        <spp_enums:UpdateChannelType>Official</spp_enums:UpdateChannelType>
                    </ComboBox.Items>
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="spp_enums:UpdateChannelType">
                            <TextBlock Text="{Binding ., Converter={StaticResource EnumLocalizationNameConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </spp:OptionsDisplayItem.ActionButton>
        </spp:OptionsDisplayItem>

        <spp:OptionsDisplayItem Description="{x:Static spp:Strings.Settings_RestartEffective}" Header="{x:Static spp:Strings.Settings_General_UseGPURendering}">
            <spp:OptionsDisplayItem.Icon>
                <ui:FAFontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE950;" />
            </spp:OptionsDisplayItem.Icon>
            <spp:OptionsDisplayItem.ActionButton>
                <ToggleSwitch Classes="LeftContent" IsChecked="{Binding Source={x:Static ms:GeneralSettings.GPU}, Path=Value, Mode=TwoWay}" />
            </spp:OptionsDisplayItem.ActionButton>
        </spp:OptionsDisplayItem>

        <spp:OptionsDisplayItem Header="{x:Static spp:Strings.L10nApp_EnablePushNotifications}">
            <spp:OptionsDisplayItem.Icon>
                <ui:FAFontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE7E7;" />
            </spp:OptionsDisplayItem.Icon>
            <spp:OptionsDisplayItem.ActionButton>
                <ToggleSwitch Classes="LeftContent" IsChecked="{Binding Source={x:Static ms:GeneralSettings.MessagePopupNotification}, Path=Value, Mode=TwoWay}" />
            </spp:OptionsDisplayItem.ActionButton>
        </spp:OptionsDisplayItem>

        <ui:FASettingsExpander
            Header="{x:Static spp:Strings.Settings_General_StorageSpace}"
            IconSource="Globe"
            IsClickEnabled="False"
            IsExpanded="True">
            <ui:FASettingsExpander.IconSource>
                <ui:FAFontIconSource FontFamily="Segoe Fluent Icons" Glyph="&#xE7F1;" />
            </ui:FASettingsExpander.IconSource>
            <ui:FASettingsExpander.Footer>
                <Button
                    Command="{Binding OpenFolder_Click}"
                    CommandParameter="{x:Null}"
                    Content="{Binding Mode=OneTime, Source={x:Static spp:Strings.Settings_General_BrowseCustomFolder}, Converter={StaticResource StringFormatConverter}, ConverterParameter=App}" />
            </ui:FASettingsExpander.Footer>

            <ui:FASettingsExpanderItem
                ActionIconSource="Open"
                Command="{Binding OpenFolder_Click}"
                CommandParameter="AppData"
                Content="{x:Static spp:Strings.Settings_General_AppData}"
                IsClickEnabled="True"
                ToolTip.Tip="{Binding Mode=OneTime, Source={x:Static spp:Strings.Settings_General_BrowseCustomFolder}, Converter={StaticResource StringFormatConverter}, ConverterParameter=AppData}" />
            <ui:FASettingsExpanderItem
                ActionIconSource="Open"
                Command="{Binding OpenFolder_Click}"
                CommandParameter="Cache"
                Content="{x:Static spp:Strings.Settings_General_CacheData}"
                IsClickEnabled="True"
                ToolTip.Tip="{Binding Mode=OneTime, Source={x:Static spp:Strings.Settings_General_BrowseCustomFolder}, Converter={StaticResource StringFormatConverter}, ConverterParameter=Cache}">
                <ui:FASettingsExpanderItem.Footer>
                    <TextBlock
                        Name="CacheSize"
                        Margin="0,0,8,0"
                        FontSize="{DynamicResource DefaultFontSize}"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </ui:FASettingsExpanderItem.Footer>
            </ui:FASettingsExpanderItem>
            <ui:FASettingsExpanderItem
                ActionIconSource="Open"
                Command="{Binding OpenFolder_Click}"
                CommandParameter="Logs"
                Content="{x:Static spp:Strings.Settings_General_LogsData}"
                IsClickEnabled="True"
                ToolTip.Tip="{Binding Mode=OneTime, Source={x:Static spp:Strings.Settings_General_BrowseCustomFolder}, Converter={StaticResource StringFormatConverter}, ConverterParameter=Logs}">
                <ui:FASettingsExpanderItem.Footer>
                    <TextBlock
                        Name="LogSize"
                        Margin="0,0,8,0"
                        FontSize="{DynamicResource DefaultFontSize}"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </ui:FASettingsExpanderItem.Footer>
            </ui:FASettingsExpanderItem>
        </ui:FASettingsExpander>
    </StackPanel>
</UserControl>

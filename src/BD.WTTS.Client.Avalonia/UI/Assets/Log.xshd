<?xml version="1.0" encoding="utf-8"?>
<SyntaxDefinition name="Log" extensions=".log" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Verbose" foreground="#A2AFC0" />
  <Color name="Debug" foreground="#93BCFA" />
  <Color name="Info" foreground="#85DBAD" />
  <Color name="Warning" foreground="#FFD08A" fontWeight="bold" />
  <Color name="Error" foreground="#FFA3A3" fontWeight="bold" />
  <Color name="Date" foreground="#A0ADC1" />
  <Color name="Category" foreground="#9EACC4" />
  <Color name="Separator" foreground="#78869D" />
  <Color name="Constant" foreground="#A5C8F4" />
  <Color name="String" foreground="#E6BEA2" />
  <Color name="Exception" foreground="#FFA3A3" fontStyle="italic" />
  <Color name="Stack" foreground="#B0BCD0" />
  <RuleSet>
    <Rule color="Category">(?&lt;=^\d{4}-\d{2}-\d{2}[^|]*\|[a-zA-Z]+\|)[^|]+(?=\|)</Rule>
    <Rule color="Separator">(?&lt;=^\d{4}-\d{2}-\d{2}(?:[^|]*\|){0,2}[^|]*)\|</Rule>
    <Rule color="Verbose">\bTrace\b:|(?i:\[(?:verbose|verb|vrb|vb|v)\])|(?&lt;=^[\s\d\p{P}]*)\bV\b</Rule>
    <Rule color="Debug">\b(?:DEBUG|Debug)\b|(?i:\bdebug:|\[(?:debug|dbug|dbg|de|d)\])|(?&lt;=^[\s\d\p{P}]*)\bD\b</Rule>
    <Rule color="Info">\b(?:HINT|INFO|INFORMATION|Info|NOTICE|II)\b|(?i:\b(?:info|information):|\[(?:information|info|inf|in|i)\])|(?&lt;=^[\s\d\p{P}]*)\bI\b</Rule>
    <Rule color="Warning">\b(?:WARNING|WARN|Warn|WW)\b|(?i:\bwarning:|\[(?:warning|warn|wrn|wn|w)\])|(?&lt;=^[\s\d\p{P}]*)\bW\b</Rule>
    <Rule color="Error">\b(?:ALERT|CRITICAL|EMERGENCY|ERROR|FAILURE|FAIL|Fatal|FATAL|Error|EE)\b|(?i:\berror:|\[(?:error|eror|err|er|e|fatal|fatl|ftl|fa|f)\])|(?&lt;=^[\s\d\p{P}]*)\bE\b</Rule>
    <Rule color="Date">\b\d{4}-\d{2}-\d{2}(?:T|\b)|\d{2}[^\w\s]\d{2}[^\w\s]\d{4}\b|\d{1,2}:\d{2}(?::\d{2}(?:[.,]\d+)?)?(?:Z|[ ]?[+-]\d{1,2}:\d{2})?\b</Rule>
    <Rule color="Constant">\b(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{10}|[0-9a-fA-F]{7})\b|\b[0-9a-fA-F]{8}-?(?:[0-9a-fA-F]{4}-?){3}[0-9a-fA-F]{12}\b|\b(?:[0-9a-fA-F]{2,}[:-])+[0-9a-fA-F]{2,}\b|\b(?:[0-9]+|true|false|null|0x[a-fA-F0-9]+)\b</Rule>
    <Rule color="String">"[^"]*"|(?&lt;!\w)'[^']*'</Rule>
    <Rule color="Exception">\b[a-zA-Z.]*Exception\b</Rule>
    <Rule color="Stack">^[\t ]*at.*$</Rule>
    <Rule color="Constant">\b[a-z]+://\S+\b/?|(?&lt;![\w/\\])(?:[\w-]+\.)+[\w-]+(?![\w/\\])</Rule>
  </RuleSet>
</SyntaxDefinition>

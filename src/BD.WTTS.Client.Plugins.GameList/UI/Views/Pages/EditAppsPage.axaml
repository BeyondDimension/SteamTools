<spp:PageBase
    x:Class="BD.WTTS.UI.Views.Pages.EditAppsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://steampp.net/services"
    xmlns:spp="https://steampp.net/ui"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    Title="{x:Static spp:Strings.L10nGames_EditTitle}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:CompileBindings="True"
    x:DataType="spp:EditAppsPageViewModel"
    Description="{x:Static spp:Strings.L10nGames_EditDescription}"
    Subtitle="{Binding Author, Source={x:Static s:Plugin.Instance}, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter=Plugin_Author}"
    mc:Ignorable="d">
    <spp:PageBase.PreviewImage>
        <ui:FAImageIconSource Source="{Binding Icon, Source={x:Static s:Plugin.Instance}, Mode=OneWay, Converter={StaticResource BitmapAssetValueConverter}}" />
    </spp:PageBase.PreviewImage>
    <spp:PageBase.ActionContent>
        <StackPanel Orientation="Horizontal" Spacing="2">
            <Button
                Padding="8,4"
                Command="{Binding SaveSteamEditedApps}"
                Theme="{StaticResource TransparentButton}">
                <Panel>
                    <Viewbox
                        Width="16"
                        Height="16"
                        HorizontalAlignment="Left">
                        <ui:FASymbolIcon Symbol="Save" />
                    </Viewbox>
                    <TextBlock
                        Margin="28,4,0,4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="{x:Static spp:Strings.SaveEditedAppInfo_SaveToSteam}" />
                </Panel>
            </Button>
            <Button
                Padding="8,4"
                Command="{Binding LoadSteamEditedApps}"
                DockPanel.Dock="Right"
                Theme="{StaticResource TransparentButton}">
                <Panel>
                    <Viewbox
                        Width="16"
                        Height="16"
                        HorizontalAlignment="Left">
                        <ui:FASymbolIcon Symbol="Refresh" />
                    </Viewbox>
                    <TextBlock
                        Margin="28,4,0,4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="{x:Static spp:Strings.Refresh}" />
                </Panel>
            </Button>
            <DropDownButton
                Padding="8"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Content="{StaticResource More}"
                FontFamily="{StaticResource SymbolThemeFontFamily}"
                FontSize="20"
                Theme="{StaticResource TransparentButton}">
                <DropDownButton.Flyout>
                    <ui:FAMenuFlyout Placement="BottomEdgeAlignedRight">
                        <ui:FAMenuFlyoutItem
                            Command="{Binding ExportSteamEditedAppsBackup}"
                            IsEnabled="{Binding !IsExportingBackup}"
                            Text="{x:Static spp:Strings.Export}" />
                        <ui:FAMenuFlyoutItem
                            Command="{Binding ImportSteamEditedAppsBackup}"
                            Text="{x:Static spp:Strings.Import}" />
                        <ui:FAMenuFlyoutSeparator />
                        <!--<ui:FAMenuFlyoutItem
                            Command="{Binding DeleteAllButton_Click}"
                            IconSource="Delete"
                            Text="{x:Static spp:Strings.GameList_RemoveBtn}" />
                        <ui:FAMenuFlyoutSeparator />-->
                        <ui:FAMenuFlyoutItem IsEnabled="False">
                            <ui:FAMenuFlyoutItem.Text>
                                <MultiBinding StringFormat="{}{0}{1}">
                                    <Binding Mode="OneTime" Source="{x:Static spp:Strings.Plugin_Version}" />
                                    <CompiledBindingExtension
                                        Mode="OneWay"
                                        Path="Version"
                                        Source="{x:Static s:Plugin.Instance}" />
                                </MultiBinding>
                            </ui:FAMenuFlyoutItem.Text>
                        </ui:FAMenuFlyoutItem>
                        <!--<ui:FAMenuFlyoutItem Text="{x:Static spp:Strings.ViewInStore}" />
                        <ui:FAMenuFlyoutItem Text="{x:Static spp:Strings.UseHelp}" />
                        <ui:FAMenuFlyoutItem Text="{x:Static spp:Strings.AboutThisPlugin}" />-->
                    </ui:FAMenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </StackPanel>
    </spp:PageBase.ActionContent>
    <spp:ContentLoader
        IsLoading="false"
        IsShowNoResultText="{Binding !!!SteamEditedApps.Count, Mode=OneWay}"
        NoResultMessage="{x:Static spp:Strings.SaveEditedAppInfo_AppsEmpty}">
        <ui:FAItemsRepeater
            HorizontalCacheLength="0"
            ItemsSource="{Binding SteamEditedApps}"
            VerticalCacheLength="1">
            <ui:FAItemsRepeater.Layout>
                <ui:FAUniformGridLayout
                    ItemsJustification="Start"
                    ItemsStretch="Uniform"
                    MinColumnSpacing="10"
                    MinItemHeight="310"
                    MinItemWidth="150"
                    MinRowSpacing="10" />
            </ui:FAItemsRepeater.Layout>
            <ui:FAItemsRepeater.ItemTemplate>
                <spp:ScopedRecycleTemplate>
                <DataTemplate DataType="spp:SteamApp">
                    <spp:AppItem
                        Title="{Binding DisplayName}"
                        Classes="Vertical"
                        ClickCommand="{Binding $parent[spp:PageBase].((spp:EditAppsPageViewModel)DataContext).EditAppInfoClickCommand}"
                        ClickCommandParameter="{Binding}"
                        Cursor="Hand">
                        <spp:AppItem.Status>
                            <Border Classes="Status">
                                <TextBlock Text="{x:Static spp:Strings.Edit}" />
                            </Border>
                        </spp:AppItem.Status>
                        <spp:AppItem.Image>
                            <Panel Width="{Binding $parent[spp:AppItem].Bounds.Width}">
                                <spp:Image2
                                    Name="AppImage"
                                    DecodeWidth="120"
                                    FallbackSource="avares://BD.WTTS.Client.Plugins.GameList/UI/Assets/defaultappimage.png"
                                    RenderOptions.BitmapInterpolationMode="HighQuality"
                                    spp:SteamAppImageSource.App="{Binding}"
                                    Stretch="UniformToFill" />
                                <TextBlock
                                    Margin="8,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    IsVisible="{Binding #AppImage.IsFailed}"
                                    Text="{Binding DisplayName}"
                                    TextAlignment="Center"
                                    TextWrapping="WrapWithOverflow"
                                    Theme="{StaticResource BodyStrongTextBlockStyle}" />
                                <Border
                                    Margin="10,0,10,-3"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Background="#3D4450"
                                    CornerRadius="3"
                                    IsVisible="{Binding IsInstalled}">
                                    <DockPanel Margin="10,3" HorizontalAlignment="Center">
                                        <TextBlock
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            IsVisible="{Binding InstalledDrive, Converter={StaticResource IsNullConverter}, ConverterParameter=invert}"
                                            Text="{Binding InstalledDrive}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="{Binding SizeOnDisk, Converter={StaticResource StringFormatConverter}, ConverterParameter=size}"
                                            TextWrapping="Wrap" />
                                    </DockPanel>
                                </Border>
                            </Panel>
                        </spp:AppItem.Image>
                    </spp:AppItem>
                </DataTemplate>
                </spp:ScopedRecycleTemplate>
            </ui:FAItemsRepeater.ItemTemplate>
        </ui:FAItemsRepeater>
    </spp:ContentLoader>
</spp:PageBase>

<spp:PageBase
    x:Class="BD.WTTS.UI.Views.Pages.GameSavesPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:s="https://steampp.net/services"
    xmlns:spp="https://steampp.net/ui"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:vm="using:BD.WTTS.UI.ViewModels"
    xmlns:saves="using:BD.WTTS.GameList.Saves"
    xmlns:controls="using:BD.WTTS.UI.Views.Controls"
    xmlns:converters="using:Avalonia.Data.Converters"
    x:CompileBindings="True"
    x:DataType="vm:GameSavesPageViewModel"
    Title="{x:Static spp:Strings.GameList_Saves_PageTitle}"
    Description="{x:Static spp:Strings.GameList_Saves_Description}"
    ScrollViewer.VerticalScrollBarVisibility="Auto">
    <spp:PageBase.PreviewImage>
        <ui:FAImageIconSource Source="{Binding Icon, Source={x:Static s:Plugin.Instance}, Mode=OneWay, Converter={StaticResource BitmapAssetValueConverter}}" />
    </spp:PageBase.PreviewImage>

    <spp:PageBase.ActionContent>
        <StackPanel Orientation="Horizontal" Spacing="4">
            <ToggleButton
                Padding="8,4"
                IsChecked="{Binding $parent[spp:PageBase].IsPaneOpen, Mode=TwoWay}"
                Theme="{StaticResource TransparentToggleButton}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ui:FASymbolIcon FontSize="16" Symbol="Filter" />
                    <TextBlock Text="{x:Static spp:Strings.GameList_Saves_FilterSettings}" />
                </StackPanel>
            </ToggleButton>
            <Button Click="Rescan_Click" IsEnabled="{Binding CanRefreshAccounts}" IsVisible="{Binding !IsScanningInstalled}"
                    Padding="8,4" Theme="{StaticResource TransparentButton}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ui:FASymbolIcon FontSize="16" Symbol="Refresh" />
                    <TextBlock Text="{x:Static spp:Strings.GameList_Saves_Refresh}" />
                </StackPanel>
            </Button>
            <Button Click="CancelScan_Click" Content="{x:Static spp:Strings.GameList_Saves_Cancel}"
                    IsVisible="{Binding IsScanningInstalled}" Padding="8,4" Theme="{StaticResource TransparentButton}" />
        </StackPanel>
    </spp:PageBase.ActionContent>

    <spp:PageBase.PaneContent>
        <StackPanel Margin="15,20" Spacing="12">
            <TextBlock Text="{x:Static spp:Strings.GameList_Saves_FilterSettings}" Theme="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBox AutomationProperties.Name="{x:Static spp:Strings.GameList_Saves_Search}"
                     PlaceholderText="{x:Static spp:Strings.GameList_Saves_Search}"
                     Text="{Binding SearchText, Mode=TwoWay}" />
            <StackPanel Spacing="4">
                <WrapPanel ItemSpacing="8" LineSpacing="4">
                    <TextBlock Text="{x:Static spp:Strings.GameList_Saves_Account}" Classes="save-caption" VerticalAlignment="Center" />
                    <Button Click="RefreshAccounts_Click" IsEnabled="{Binding CanRefreshAccounts}"
                            Padding="6,3" Theme="{StaticResource TransparentButton}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <ui:FASymbolIcon Symbol="Refresh" FontSize="12" />
                            <TextBlock Text="{x:Static spp:Strings.GameList_Saves_RefreshAccounts}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
                <ComboBox HorizontalAlignment="Stretch" IsVisible="{Binding HasAccounts}"
                          AutomationProperties.Name="{x:Static spp:Strings.GameList_Saves_Account}"
                          ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                          IsEnabled="{Binding CanRefreshAccounts}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="saves:GameSaveAccountInfo">
                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Static spp:Strings.GameList_Saves_Filter}" Classes="save-caption" />
                <ComboBox HorizontalAlignment="Stretch"
                          AutomationProperties.Name="{x:Static spp:Strings.GameList_Saves_Filter}"
                          ItemsSource="{Binding Filters}" SelectedIndex="{Binding FilterIndex, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Static spp:Strings.GameList_Saves_Sort}" Classes="save-caption" />
                <ComboBox HorizontalAlignment="Stretch"
                          AutomationProperties.Name="{x:Static spp:Strings.GameList_Saves_Sort}"
                          ItemsSource="{Binding SortOptions}" SelectedIndex="{Binding SortIndex, Mode=TwoWay}" />
            </StackPanel>

            <Separator />
            <TextBlock Text="{x:Static spp:Strings.GameList_Saves_BackupSettings}" Theme="{StaticResource BodyStrongTextBlockStyle}" />
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Static spp:Strings.GameList_Saves_CurrentBackupFolder}" Classes="save-caption" />
                <spp:PathLink Path="{Binding BackupRootPath}" />
            </StackPanel>
            <WrapPanel ItemSpacing="6" LineSpacing="6">
                <Button Click="ChangeBackupFolder_Click" Content="{x:Static spp:Strings.GameList_Saves_ChangeBackupFolder}"
                        IsEnabled="{Binding CanMutate}" />
                <Button Click="OpenBackupFolder_Click" Content="{x:Static spp:Strings.GameList_Saves_OpenBackupFolder}" />
                <Button Click="OpenSteamScreenshotsFolder_Click" Content="{x:Static spp:Strings.GameList_Saves_OpenSteamScreenshotsFolder}"
                        IsEnabled="{Binding HasSteamScreenshotsPath}" />
                <Button Click="Rescan_Click" Content="{x:Static spp:Strings.GameList_Saves_Rescan}"
                        IsEnabled="{Binding CanRefreshAccounts}" />
            </WrapPanel>
            <CheckBox IsChecked="{Binding AutoBackupBeforeRestore, Mode=TwoWay}" IsEnabled="{Binding CanMutate}">
                <TextBlock Text="{x:Static spp:Strings.GameList_Saves_RestoreAutoBackup}" TextWrapping="Wrap" />
            </CheckBox>

            <Separator />
            <TextBlock Text="{x:Static spp:Strings.GameList_Saves_BatchSelection}" Theme="{StaticResource BodyStrongTextBlockStyle}" />
            <WrapPanel ItemSpacing="6" LineSpacing="6">
                <Button Click="SelectAll_Click" Content="{x:Static spp:Strings.GameList_Saves_SelectAll}" IsEnabled="{Binding CanSelectAll}" />
                <Button Click="ClearSelection_Click" Content="{x:Static spp:Strings.GameList_Saves_ClearSelection}" IsEnabled="{Binding CanBatch}" />
                <Button Click="ExpandAll_Click" Content="{x:Static spp:Strings.GameList_Saves_ExpandAll}" />
                <Button Click="CollapseAll_Click" Content="{x:Static spp:Strings.GameList_Saves_CollapseAll}" />
            </WrapPanel>
        </StackPanel>
    </spp:PageBase.PaneContent>

    <spp:PageBase.Styles>
        <Style Selector="Border.save-card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="Border.save-card.game-row">
            <Setter Property="Padding" Value="0" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.save-header">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="6,3" />
        </Style>
        <Style Selector="Border.save-details">
            <Setter Property="Padding" Value="20,12,14,14" />
        </Style>
        <Style Selector="Border.save-header, Border.save-entry">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Border.save-header:pointerover, Border.save-entry:pointerover">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="Border.save-entry">
            <Setter Property="Padding" Value="4,2" />
        </Style>
        <Style Selector="Border.tree-children">
            <Setter Property="Margin" Value="14,2,0,6" />
            <Setter Property="Padding" Value="12,2,0,2" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        </Style>
        <Style Selector="TextBlock.save-caption">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Theme" Value="{StaticResource CaptionTextBlockStyle}" />
        </Style>
        <Style Selector="Border.save-badge">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="7,2" />
        </Style>
        <Style Selector="Border.save-badge.backed-up">
            <Style.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <SolidColorBrush x:Key="SaveBackupBadgeBackgroundBrush">#DEEEFF</SolidColorBrush>
                            <SolidColorBrush x:Key="SaveBackupBadgeForegroundBrush">#174B73</SolidColorBrush>
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Dark">
                            <SolidColorBrush x:Key="SaveBackupBadgeBackgroundBrush">#163C5C</SolidColorBrush>
                            <SolidColorBrush x:Key="SaveBackupBadgeForegroundBrush">#B7DDFF</SolidColorBrush>
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </Style.Resources>
            <Setter Property="Background" Value="{DynamicResource SaveBackupBadgeBackgroundBrush}" />
        </Style>
        <Style Selector="Border.save-badge.backed-up > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SaveBackupBadgeForegroundBrush}" />
        </Style>
        <Style Selector="Border.save-badge.success">
            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
        </Style>
        <Style Selector="Border.save-badge.success > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
        </Style>
        <Style Selector="Button.save-icon">
            <Setter Property="Padding" Value="6" />
            <Setter Property="Theme" Value="{StaticResource TransparentButton}" />
        </Style>
        <Style Selector="Button.save-compact, DropDownButton.save-compact">
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.save-danger">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </Style>
        <Style Selector="spp|PathLink.save-path">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" />
            <Setter Property="FontSize" Value="{StaticResource CaptionTextBlockFontSize}" />
        </Style>
        <Style Selector="WrapPanel#SaveCardActions">
            <Setter Property="(Grid.Column)" Value="2" />
        </Style>
        <Style Selector="WrapPanel.save-tree-actions">
            <Setter Property="(Grid.Column)" Value="2" />
        </Style>
        <Style Selector="WrapPanel.save-branch-actions">
            <Setter Property="(Grid.Column)" Value="1" />
        </Style>
        <Style Selector="Grid#SaveCardTitle > WrapPanel, StackPanel.save-scan-progress">
            <Setter Property="(Grid.Column)" Value="1" />
        </Style>
        <ContainerQuery Name="saveCard" Query="max-width:680">
            <Style Selector="WrapPanel#SaveCardActions">
                <Setter Property="(Grid.Row)" Value="1" />
                <Setter Property="(Grid.Column)" Value="0" />
                <Setter Property="(Grid.ColumnSpan)" Value="3" />
                <Setter Property="Margin" Value="0,4,0,0" />
            </Style>
            <Style Selector="WrapPanel.save-branch-actions">
                <Setter Property="(Grid.Row)" Value="1" />
                <Setter Property="(Grid.Column)" Value="0" />
                <Setter Property="(Grid.ColumnSpan)" Value="2" />
            </Style>
        </ContainerQuery>
        <ContainerQuery Name="saveCard" Query="max-width:460">
            <Style Selector="WrapPanel.save-tree-actions">
                <Setter Property="(Grid.Row)" Value="1" />
                <Setter Property="(Grid.Column)" Value="0" />
                <Setter Property="(Grid.ColumnSpan)" Value="3" />
            </Style>
            <Style Selector="Border.tree-children">
                <Setter Property="Margin" Value="6,2,0,6" />
                <Setter Property="Padding" Value="6,2,0,2" />
            </Style>
            <Style Selector="Border.save-details">
                <Setter Property="Padding" Value="10,10,8,10" />
            </Style>
            <Style Selector="Grid#SaveCardTitle > WrapPanel">
                <Setter Property="(Grid.Row)" Value="1" />
                <Setter Property="(Grid.Column)" Value="0" />
                <Setter Property="(Grid.ColumnSpan)" Value="2" />
            </Style>
            <Style Selector="Grid#SaveCardTitle > TextBlock">
                <Setter Property="(Grid.ColumnSpan)" Value="2" />
            </Style>
        </ContainerQuery>
        <ContainerQuery Name="storageSummary" Query="max-width:520">
            <Style Selector="StackPanel.save-scan-progress">
                <Setter Property="(Grid.Row)" Value="1" />
                <Setter Property="(Grid.Column)" Value="0" />
                <Setter Property="(Grid.ColumnSpan)" Value="2" />
                <Setter Property="Margin" Value="0,6,0,0" />
            </Style>
        </ContainerQuery>
    </spp:PageBase.Styles>

    <spp:PageBase.Resources>
        <ControlTheme x:Key="SaveDisclosureTheme" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                </ControlTemplate>
            </Setter>
        </ControlTheme>
        <DataTemplate x:Key="SaveTreeRowTemplate" x:DataType="vm:GameSaveTreeRowViewModel">
            <Panel Margin="{Binding Indent}">
                <Button Click="TreeRowAction_Click" Content="{Binding Name}" IsVisible="{Binding IsMore}"
                        Theme="{StaticResource TransparentButton}" />
                <Border Classes="save-entry" IsVisible="{Binding !IsMore}">
                    <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="6" MinHeight="26">
                        <Button Classes="save-icon" Click="TreeRowAction_Click" IsVisible="{Binding IsDirectory}"
                                AutomationProperties.Name="{Binding ExpansionLabel}" ToolTip.Tip="{Binding ExpansionLabel}">
                            <Panel>
                                <ui:FASymbolIcon Symbol="ChevronRight" FontSize="12" IsVisible="{Binding !IsExpanded}" />
                                <ui:FASymbolIcon Symbol="ChevronDown" FontSize="12" IsVisible="{Binding IsExpanded}" />
                            </Panel>
                        </Button>
                        <ui:FASymbolIcon Symbol="Image" FontSize="14" IsVisible="{Binding ShowImage}" VerticalAlignment="Center" />
                        <ui:FASymbolIcon Symbol="Document" FontSize="14" IsVisible="{Binding IsDocument}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip.Tip="{Binding FullPath}"
                                   FontWeight="Medium" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                            <TextBlock Classes="save-caption" Text="{Binding Size}" VerticalAlignment="Center" />
                            <TextBlock Classes="save-caption" Text="{Binding Modified}" VerticalAlignment="Center" />
                            <Button Classes="save-compact" Click="OpenScreenshot_Click" IsVisible="{Binding ShowImage}"
                                    Theme="{StaticResource TransparentButton}"
                                    Content="{x:Static spp:Strings.GameList_Saves_ViewScreenshot}"
                                    AutomationProperties.Name="{x:Static spp:Strings.GameList_Saves_OpenScreenshot}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Panel>
        </DataTemplate>

        <DataTemplate x:Key="SaveLocationTemplate" x:DataType="vm:GameSaveLocationItemViewModel">
            <StackPanel Spacing="4">
                <Border Classes="save-entry">
                    <Grid ColumnDefinitions="24,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="6">
                        <ToggleButton IsChecked="{Binding Tree.IsExpanded, Mode=TwoWay}"
                                      IsVisible="{Binding Tree.HasFiles}"
                                      AutomationProperties.Name="{Binding Tree.ExpansionLabel}"
                                      ToolTip.Tip="{Binding Tree.ExpansionLabel}"
                                      Padding="6" Theme="{StaticResource SaveDisclosureTheme}">
                            <Panel>
                                <ui:FASymbolIcon Symbol="ChevronRight" FontSize="12" IsVisible="{Binding !Tree.IsExpanded}" />
                                <ui:FASymbolIcon Symbol="ChevronDown" FontSize="12" IsVisible="{Binding Tree.IsExpanded}" />
                            </Panel>
                        </ToggleButton>
                        <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalAlignment="Center">
                            <ui:FASymbolIcon Symbol="Folder" FontSize="14" />
                            <TextBlock Grid.Column="1" Text="{Binding Source}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </Grid>
                        <WrapPanel Classes="save-tree-actions" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   ItemSpacing="6" LineSpacing="4">
                            <TextBlock Classes="save-caption" Text="{Binding Statistics}" VerticalAlignment="Center" />
                            <Button Classes="save-compact" Click="OpenLocation_Click" Content="{x:Static spp:Strings.GameList_Saves_Open}"
                                    IsEnabled="{Binding CanOpen}" Theme="{StaticResource TransparentButton}" />
                            <Button Classes="save-compact" Click="CopyPath_Click" Content="{x:Static spp:Strings.Copy}"
                                    IsEnabled="{Binding HasPath}" Theme="{StaticResource TransparentButton}"
                                    AutomationProperties.Name="{x:Static spp:Strings.GameList_Saves_CopyPath}" />
                        </WrapPanel>
                        <Panel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2,0,0">
                            <spp:PathLink Classes="save-path" Path="{Binding Path}"
                                          IsVisible="{Binding HasPath}" IsEnabled="{Binding CanOpen}" />
                            <TextBlock Classes="save-caption" Text="{Binding PathDisplay}"
                                       TextWrapping="Wrap" IsVisible="{Binding !HasPath}" />
                        </Panel>
                    </Grid>
                </Border>
                <ui:FAProgressRing Margin="32,4,0,4" HorizontalAlignment="Left" Width="16" Height="16"
                                   IsVisible="{Binding Tree.IsLoading}" IsActive="{Binding Tree.IsLoading}" />
                <Border Classes="tree-children" IsVisible="{Binding Tree.IsExpanded}">
                    <ItemsControl ItemsSource="{Binding Tree.Rows}" ItemTemplate="{StaticResource SaveTreeRowTemplate}" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ScreenshotTreeTemplate" x:DataType="vm:GameSaveScreenshotItemViewModel">
            <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                    <WrapPanel ItemSpacing="7" LineSpacing="4" VerticalAlignment="Center">
                        <ui:FASymbolIcon Symbol="Image" FontSize="16" />
                        <TextBlock Text="{x:Static spp:Strings.GameList_Saves_SteamScreenshots}"
                                   Theme="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <Border Classes="save-badge success"><TextBlock Classes="save-caption" Text="{Binding Statistics}" /></Border>
                        <ToggleButton IsChecked="{Binding Tree.IsExpanded, Mode=TwoWay}" IsVisible="{Binding Tree.HasFiles}"
                                      AutomationProperties.Name="{Binding Tree.ExpansionLabel}" ToolTip.Tip="{Binding Tree.ExpansionLabel}"
                                      Padding="6" Theme="{StaticResource SaveDisclosureTheme}">
                            <Panel>
                                <ui:FASymbolIcon Symbol="ChevronRight" FontSize="12" IsVisible="{Binding !Tree.IsExpanded}" />
                                <ui:FASymbolIcon Symbol="ChevronDown" FontSize="12" IsVisible="{Binding Tree.IsExpanded}" />
                            </Panel>
                        </ToggleButton>
                    </WrapPanel>
                    <WrapPanel Classes="save-branch-actions" HorizontalAlignment="Right">
                        <Button Classes="save-compact" Click="OpenScreenshotFolder_Click" IsEnabled="{Binding CanOpen}"
                                Content="{x:Static spp:Strings.GameList_Saves_OpenScreenshotFolder}" ToolTip.Tip="{Binding Path}" />
                    </WrapPanel>
                </Grid>
                <ui:FAProgressRing Margin="32,4,0,4" HorizontalAlignment="Left" Width="16" Height="16"
                                   IsVisible="{Binding Tree.IsLoading}" IsActive="{Binding Tree.IsLoading}" />
                <Border Classes="tree-children" IsVisible="{Binding Tree.IsExpanded}">
                    <ItemsControl ItemsSource="{Binding Tree.Rows}" ItemTemplate="{StaticResource SaveTreeRowTemplate}" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="BackupSnapshotTemplate" x:DataType="vm:GameSaveBackupItemViewModel">
            <Border Classes="save-entry" ToolTip.Tip="{Binding Note}">
                <Grid ColumnDefinitions="20,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="6">
                    <ui:FASymbolIcon Symbol="Clock" FontSize="14" VerticalAlignment="Center" />
                    <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Timestamp}" VerticalAlignment="Center" Theme="{StaticResource BodyStrongTextBlockStyle}" />
                        <Border Grid.Column="1" Classes="save-badge backed-up" IsVisible="{Binding IsAutoPreRestore}">
                            <TextBlock Classes="save-caption" Text="{x:Static spp:Strings.GameList_Saves_AutoBackupBadge}" />
                        </Border>
                        <Border Grid.Column="2" Classes="save-badge" IsVisible="{Binding HasNote}" HorizontalAlignment="Left">
                            <TextBlock Classes="save-caption" Text="{Binding Note}" TextTrimming="CharacterEllipsis" />
                        </Border>
                    </Grid>
                    <WrapPanel Classes="save-tree-actions" HorizontalAlignment="Right" VerticalAlignment="Center"
                               ItemSpacing="5" LineSpacing="4">
                        <TextBlock Classes="save-caption" Text="{Binding Statistics}" VerticalAlignment="Center" />
                        <Button Classes="accent save-compact" Click="QuickRestore_Click" Content="{x:Static spp:Strings.GameList_Saves_QuickRestore}"
                                IsEnabled="{Binding Game.Page.CanMutate}" />
                        <Button Classes="save-compact" Click="OpenSnapshot_Click" Content="{x:Static spp:Strings.GameList_Saves_Open}"
                                Theme="{StaticResource TransparentButton}" />
                        <Button Classes="save-compact save-danger" Click="DeleteSnapshot_Click" Content="{x:Static spp:Strings.GameList_Saves_Delete}"
                                IsEnabled="{Binding Game.Page.CanMutate}" Theme="{StaticResource TransparentButton}" />
                    </WrapPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SaveGameDetailsTemplate" x:DataType="vm:GameSaveGameItemViewModel">
            <Border Classes="save-details" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource LayerFillColorAltBrush}">
                <StackPanel Spacing="10">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                            <WrapPanel ItemSpacing="7" LineSpacing="4" VerticalAlignment="Center">
                                <ui:FASymbolIcon Symbol="Folder" FontSize="16" />
                                <TextBlock Text="{x:Static spp:Strings.GameList_Saves_LocalSaves}"
                                           Theme="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                <Border Classes="save-badge"><TextBlock Classes="save-caption" Text="{Binding SavesStatistics}" /></Border>
                            </WrapPanel>
                            <WrapPanel Classes="save-branch-actions" HorizontalAlignment="Right"
                                       ItemSpacing="6" LineSpacing="4" IsEnabled="{Binding Page.CanMutate}">
                                <Button Classes="save-compact" Click="BackupElsewhere_Click"
                                        Content="{x:Static spp:Strings.GameList_Saves_BackupElsewhere}" IsEnabled="{Binding HasLocalSaves}" />
                                <Button Classes="save-compact" Click="RestoreExternal_Click"
                                        Content="{x:Static spp:Strings.GameList_Saves_RestoreExternal}" />
                            </WrapPanel>
                        </Grid>
                        <Border Classes="tree-children">
                            <StackPanel>
                                <TextBlock Classes="save-caption" IsVisible="{Binding !HasLocations}"
                                           Text="{x:Static spp:Strings.GameList_Saves_NoLocations}" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding Locations}" ItemTemplate="{StaticResource SaveLocationTemplate}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <ContentControl Content="{Binding ScreenshotTree}" ContentTemplate="{StaticResource ScreenshotTreeTemplate}"
                                    HorizontalContentAlignment="Stretch" />
                    <StackPanel Spacing="4">
                        <WrapPanel ItemSpacing="7" LineSpacing="4" VerticalAlignment="Center">
                            <ui:FASymbolIcon Symbol="Save" FontSize="16" />
                            <TextBlock Text="{x:Static spp:Strings.GameList_Saves_BackupSnapshots}"
                                       Theme="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <Border Classes="save-badge"><TextBlock Classes="save-caption" Text="{Binding BackupCountDisplay}" /></Border>
                        </WrapPanel>
                        <Border Classes="tree-children">
                            <StackPanel>
                                <TextBlock Classes="save-caption" IsVisible="{Binding !HasBackups}"
                                           Text="{x:Static spp:Strings.GameList_Saves_EmptyBackups}" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding Backups}" ItemTemplate="{StaticResource BackupSnapshotTemplate}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </spp:PageBase.Resources>

    <StackPanel MaxWidth="1120" Spacing="12">
        <Border Classes="save-card" Container.Name="storageSummary" Container.Sizing="Width" Padding="16">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="save-caption" FontWeight="SemiBold" Text="{Binding StorageTitle}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StoragePath}" />
                        <TextBlock Text="{Binding StorageGameCountDisplay}" Theme="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{Binding TotalTrackedSizeDisplay}" Theme="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                    <StackPanel Classes="save-scan-progress" IsVisible="{Binding IsScanningInstalled}"
                                Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                        <ui:FAProgressRing Width="16" Height="16" IsActive="{Binding IsScanningInstalled}" />
                        <TextBlock Classes="save-caption" Text="{Binding InstalledProgressDisplay}"
                                   MaxWidth="220" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Click="CancelScan_Click" Content="{x:Static spp:Strings.GameList_Saves_Cancel}"
                                Theme="{StaticResource TransparentButton}" />
                    </StackPanel>
                    <StackPanel Classes="save-scan-progress" IsVisible="{Binding IsScanningBackground}"
                                Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                        <ui:FAProgressRing Width="12" Height="12" IsActive="{Binding IsScanningBackground}" />
                        <TextBlock Classes="save-caption" Text="{Binding BackgroundProgressDisplay}"
                                   MaxWidth="220" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Click="StopBackground_Click" Content="{x:Static spp:Strings.GameList_Saves_Stop}"
                                Theme="{StaticResource TransparentButton}" />
                    </StackPanel>
                </Grid>
                <controls:StorageBreakdownBar
                    Height="12" ClipToBounds="True" VerticalAlignment="Center"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                    SavesBytes="{Binding TotalSavesBytes}" ScreenshotsBytes="{Binding TotalScreenshotsBytes}"
                    BackupsBytes="{Binding TotalBackupsBytes}" />
                <WrapPanel ItemSpacing="20" LineSpacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" Fill="{x:Static controls:StorageBreakdownBar.SavesBrush}" />
                        <TextBlock Classes="save-caption" Text="{x:Static spp:Strings.GameList_Saves_GameSaves}" />
                        <TextBlock Classes="save-caption" FontWeight="SemiBold" Text="{Binding TotalSavesSizeDisplay}" />
                        <TextBlock Classes="save-caption" Text="{Binding SavesLegendDisplay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" Fill="{x:Static controls:StorageBreakdownBar.ScreenshotsBrush}" />
                        <TextBlock Classes="save-caption" Text="{x:Static spp:Strings.GameList_Saves_SteamScreenshots}" />
                        <TextBlock Classes="save-caption" FontWeight="SemiBold" Text="{Binding TotalScreenshotsSizeDisplay}" />
                        <TextBlock Classes="save-caption" Text="{Binding ScreenshotsLegendDisplay}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" Fill="{x:Static controls:StorageBreakdownBar.BackupsBrush}" />
                        <TextBlock Classes="save-caption" Text="{x:Static spp:Strings.GameList_Saves_LocalBackups}" />
                        <TextBlock Classes="save-caption" FontWeight="SemiBold" Text="{Binding TotalBackupsSizeDisplay}" />
                        <TextBlock Classes="save-caption" Text="{Binding BackupsLegendDisplay}" />
                    </StackPanel>
                </WrapPanel>
                <ProgressBar Height="3" IsVisible="{Binding IsScanning}" IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Maximum="{Binding ProgressMaximum}" Value="{Binding ProgressValue}" />
            </StackPanel>
        </Border>

        <Border Classes="save-card" IsVisible="{Binding HasSelectedGames}">
            <WrapPanel ItemSpacing="8" LineSpacing="6" IsEnabled="{Binding CanBatch}">
                <TextBlock Text="{Binding SelectedGamesDisplay}" Margin="0,0,8,0"
                           VerticalAlignment="Center" Theme="{StaticResource BodyStrongTextBlockStyle}" />
                <Button Classes="accent" Click="BatchBackup_Click" Content="{x:Static spp:Strings.GameList_Saves_BatchBackup}" />
                <Button Click="BatchCopy_Click" Content="{x:Static spp:Strings.GameList_Saves_BatchCopy}" />
                <Button Click="ClearSelection_Click" Content="{x:Static spp:Strings.GameList_Saves_CancelSelection}"
                        Theme="{StaticResource TransparentButton}" />
            </WrapPanel>
        </Border>

        <ItemsRepeater ItemsSource="{Binding FilteredGames}">
            <ItemsRepeater.Layout><StackLayout Spacing="8" /></ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:GameSaveGameItemViewModel">
                    <Border Classes="save-card game-row" Container.Name="saveCard" Container.Sizing="Width">
                        <StackPanel>
                            <Border Classes="save-header">
                                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                                    <CheckBox MinWidth="0" Padding="0" VerticalAlignment="Center"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding Name}">
                                        <CheckBox.IsEnabled>
                                            <MultiBinding Converter="{x:Static converters:BoolConverters.And}">
                                                <Binding Path="HasLocalSaves" />
                                                <Binding Path="Page.CanMutate" />
                                            </MultiBinding>
                                        </CheckBox.IsEnabled>
                                    </CheckBox>
                                    <ToggleButton Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                  AutomationProperties.Name="{Binding Name}"
                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}" ToolTip.Tip="{Binding ExpansionLabel}"
                                                  Padding="4" Theme="{StaticResource SaveDisclosureTheme}">
                                        <Grid ColumnDefinitions="16,76,*" ColumnSpacing="8">
                                            <Panel VerticalAlignment="Center">
                                                <ui:FASymbolIcon Symbol="ChevronRight" FontSize="12" IsVisible="{Binding !IsExpanded}" />
                                                <ui:FASymbolIcon Symbol="ChevronDown" FontSize="12" IsVisible="{Binding IsExpanded}" />
                                            </Panel>
                                            <Border Grid.Column="1" Width="76" Height="36" CornerRadius="5" ClipToBounds="True">
                                                <spp:Image2 Width="76" Height="36" Stretch="UniformToFill" DecodeWidth="152"
                                                            FallbackSource="avares://BD.WTTS.Client.Plugins.GameList/UI/Assets/defaultappimage.png"
                                                            spp:SteamAppImageSource.App="{Binding App}" spp:SteamAppImageSource.IsHeader="True" />
                                            </Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                                                <Grid Name="SaveCardTitle" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
                                                      ColumnSpacing="6" RowSpacing="2" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                               Theme="{StaticResource BodyStrongTextBlockStyle}" />
                                                    <WrapPanel ItemSpacing="5" LineSpacing="2" VerticalAlignment="Center">
                                                        <Border Classes="save-badge" Classes.success="{Binding IsInstalled}">
                                                            <TextBlock Classes="save-caption" Text="{Binding InstallStatus}" />
                                                        </Border>
                                                        <Border Classes="save-badge backed-up" IsVisible="{Binding HasBackups}">
                                                            <TextBlock Classes="save-caption" Text="{Binding BackupBadge}" />
                                                        </Border>
                                                    </WrapPanel>
                                                </Grid>
                                                <TextBlock Classes="save-caption" Text="{Binding Metadata}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </ToggleButton>
                                    <WrapPanel Name="SaveCardActions" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               ItemSpacing="6" LineSpacing="4">
                                        <TextBlock Text="{Binding TotalOccupiedSizeDisplay}" VerticalAlignment="Center" Margin="0,0,4,0"
                                                   Theme="{StaticResource BodyStrongTextBlockStyle}" />
                                        <Button Classes="save-compact" Click="OpenGameFolder_Click" IsEnabled="{Binding HasOpenableFolder}"
                                                Content="{x:Static spp:Strings.GameList_Saves_Open}"
                                                AutomationProperties.Name="{x:Static spp:Strings.GameList_Saves_OpenFolder}"
                                                ToolTip.Tip="{x:Static spp:Strings.GameList_Saves_OpenFolder}" />
                                        <Button Classes="accent save-compact" Click="QuickBackup_Click"
                                                Content="{x:Static spp:Strings.GameList_Saves_BackUp}"
                                                ToolTip.Tip="{x:Static spp:Strings.GameList_Saves_QuickBackupHint}">
                                            <Button.IsEnabled>
                                                <MultiBinding Converter="{x:Static converters:BoolConverters.And}">
                                                    <Binding Path="HasLocalSaves" />
                                                    <Binding Path="Page.CanMutate" />
                                                </MultiBinding>
                                            </Button.IsEnabled>
                                        </Button>
                                        <DropDownButton Classes="save-compact" AutomationProperties.Name="{x:Static spp:Strings.GameList_Saves_More}"
                                                        ToolTip.Tip="{x:Static spp:Strings.GameList_Saves_More}">
                                            <ui:FASymbolIcon Symbol="More" FontSize="16" />
                                            <DropDownButton.Flyout>
                                                <ui:FAMenuFlyout x:DataType="vm:GameSaveGameItemViewModel" Placement="BottomEdgeAlignedRight">
                                                    <ui:FAMenuFlyoutItem Click="BackupElsewhere_Click" Text="{x:Static spp:Strings.GameList_Saves_BackupElsewhere}">
                                                        <ui:FAMenuFlyoutItem.IsEnabled>
                                                            <MultiBinding Converter="{x:Static converters:BoolConverters.And}">
                                                                <Binding Path="HasLocalSaves" />
                                                                <Binding Path="Page.CanMutate" />
                                                            </MultiBinding>
                                                        </ui:FAMenuFlyoutItem.IsEnabled>
                                                    </ui:FAMenuFlyoutItem>
                                                    <ui:FAMenuFlyoutItem Click="RestoreExternal_Click" IsEnabled="{Binding Page.CanMutate}"
                                                                        Text="{x:Static spp:Strings.GameList_Saves_RestoreExternal}" />
                                                    <ui:FAMenuFlyoutItem Click="OpenScreenshotFolder_Click" IsVisible="{Binding HasScreenshotFolder}"
                                                                        Text="{x:Static spp:Strings.GameList_Saves_OpenScreenshotFolder}" />
                                                </ui:FAMenuFlyout>
                                            </DropDownButton.Flyout>
                                        </DropDownButton>
                                    </WrapPanel>
                                </Grid>
                            </Border>
                            <ContentControl Content="{Binding ExpandedDetails}" IsVisible="{Binding IsExpanded}"
                                            ContentTemplate="{StaticResource SaveGameDetailsTemplate}" HorizontalContentAlignment="Stretch" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <Border Classes="save-card" IsVisible="{Binding ShowEmptyState}">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding EmptyTitle}" Theme="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="{Binding EmptyHint}" Classes="save-caption" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>
</spp:PageBase>

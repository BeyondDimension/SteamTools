<UserControl
	x:Class="BD.WTTS.UI.Views.Pages.EditAppInfoPage"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:s="https://steampp.net/services"
	xmlns:spp="https://steampp.net/ui"
	xmlns:ui="using:FluentAvalonia.UI.Controls"
	d:DesignHeight="520"
	d:DesignWidth="560"
	x:CompileBindings="True"
	x:DataType="spp:EditAppInfoPageViewModel"
	mc:Ignorable="d">

	<UserControl.Styles>
		<Style Selector="TabControl#EditorTabs TabItem">
			<Setter Property="FontSize" Value="14" />
			<Setter Property="MinHeight" Value="18" />
			<Setter Property="Padding" Value="12,4" />
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
			<Setter Property="VerticalContentAlignment" Value="Stretch" />
		</Style>
		<!--  Cancel the application's negative tab margin inside the dialog.  -->
		<Style Selector="TabControl#EditorTabs /template/ DockPanel">
			<Setter Property="Margin" Value="0" />
		</Style>
		<Style Selector="ScrollViewer.page-scroll">
			<Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
			<Setter Property="VerticalScrollBarVisibility" Value="Auto" />
		</Style>
		<Style Selector="Border.card">
			<Setter Property="Padding" Value="16" />
			<Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
		</Style>
		<Style Selector="Grid.row">
			<Setter Property="MinHeight" Value="32" />
			<Setter Property="ColumnSpacing" Value="12" />
		</Style>
		<Style Selector="TextBlock.label">
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="TextTrimming" Value="None" />
		</Style>
		<Style Selector="Grid.field">
			<Setter Property="RowSpacing" Value="6" />
		</Style>
		<Style Selector="Grid.row > TextBlock.value">
			<Setter Property="(Grid.Column)" Value="1" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="TextTrimming" Value="None" />
		</Style>
		<Style Selector="Grid.field > TextBox">
			<Setter Property="(Grid.Row)" Value="1" />
			<Setter Property="MinHeight" Value="36" />
			<Setter Property="Padding" Value="10,7" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
		<Style Selector="Grid.row > HyperlinkButton">
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		</Style>
		<Style Selector="TextBlock.hint">
			<Setter Property="Theme" Value="{StaticResource CaptionTextBlockStyle}" />
			<Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="TextTrimming" Value="None" />
		</Style>
		<Style Selector="Button.tool">
			<Setter Property="Width" Value="32" />
			<Setter Property="Height" Value="32" />
			<Setter Property="Padding" Value="6" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Theme" Value="{StaticResource TransparentButton}" />
		</Style>
		<Style Selector="WrapPanel.actions > Button">
			<Setter Property="Margin" Value="4,4,0,0" />
			<Setter Property="MinHeight" Value="32" />
		</Style>
		<Style Selector="Border.preview">
			<Setter Property="Padding" Value="8" />
			<Setter Property="CornerRadius" Value="6" />
			<Setter Property="ClipToBounds" Value="True" />
			<Setter Property="Background" Value="{DynamicResource ControlAltFillColorSecondaryBrush}" />
		</Style>
		<Style Selector="Border.preview > spp|CustomFilePicker">
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
			<Setter Property="VerticalContentAlignment" Value="Stretch" />
		</Style>
		<Style Selector="Border#LogoCard">
			<Setter Property="(Grid.Row)" Value="0" />
			<Setter Property="(Grid.Column)" Value="1" />
		</Style>
	</UserControl.Styles>

	<TabControl x:Name="EditorTabs" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
		<!--  信息  -->
		<TabItem Header="{x:Static spp:Strings.Info}">
			<ScrollViewer Classes="page-scroll">
				<StackPanel Margin="0,12,12,16" Spacing="12">
					<Border Classes="card">
						<StackPanel Spacing="12">
							<Grid Classes="field" RowDefinitions="Auto,Auto">
								<TextBlock Classes="label"
								           Text="{x:Static spp:Strings.Name}" />
								<TextBox Text="{Binding App.Name}" />
							</Grid>
							<Grid Classes="field" RowDefinitions="Auto,Auto">
								<TextBlock Classes="label"
								           Text="{x:Static spp:Strings.SortAs}" />
								<TextBox Text="{Binding App.SortAs}" />
							</Grid>
							<Grid Classes="field" RowDefinitions="Auto,Auto">
								<TextBlock Classes="label"
								           Text="{x:Static spp:Strings.Developer}" />
								<TextBox Text="{Binding App.Developer}" />
							</Grid>
							<Grid Classes="field" RowDefinitions="Auto,Auto">
								<TextBlock Classes="label"
								           Text="{x:Static spp:Strings.Publisher}" />
								<TextBox Text="{Binding App.Publisher}" />
							</Grid>
						</StackPanel>
					</Border>

					<Border Classes="card">
						<StackPanel Spacing="12">
							<Grid Classes="row" ColumnDefinitions="3*,7*">
								<TextBlock Classes="label" Text="AppId" />
								<TextBlock Classes="value" Text="{Binding App.AppId}" />
							</Grid>
							<Grid Classes="row" ColumnDefinitions="3*,7*">
								<TextBlock Classes="label"
								           Text="{x:Static spp:Strings.SupportSystem}" />
								<TextBlock Classes="value" Text="{Binding App.OSList}" />
							</Grid>
							<Grid Classes="row" ColumnDefinitions="3*,7*" IsVisible="{Binding App.IsInstalled}">
								<TextBlock Classes="label"
								           Text="{x:Static spp:Strings.DiskUsage}" />
								<TextBlock Classes="value"
								           Text="{Binding App.SizeOnDisk, Converter={StaticResource StringFormatConverter}, ConverterParameter=size}" />
							</Grid>
							<Grid Classes="row" ColumnDefinitions="3*,7*" IsVisible="{Binding App.IsInstalled}">
								<TextBlock Classes="label"
								           Text="{x:Static spp:Strings.LastUpdatedDateTime}" />
								<TextBlock Classes="value" Text="{Binding App.LastUpdated, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
							</Grid>
							<Grid Classes="row" ColumnDefinitions="3*,7*" IsVisible="{Binding App.IsInstalled}">
								<TextBlock Classes="label"
								           Text="{x:Static spp:Strings.InstalledPath}" />
								<HyperlinkButton
									Grid.Column="1"
									Padding="0"
									HorizontalAlignment="Stretch"
									Command="{Binding OpenFolder}"
									CommandParameter="{Binding App.InstalledDir}"
									ToolTip.Tip="{Binding Source={x:Static spp:Strings.Settings_General_BrowseCustomFolder}, Mode=OneTime, Converter={StaticResource StringFormatConverter}, ConverterParameter={x:Null}}">
									<TextBlock Text="{Binding App.InstalledDir}" TextWrapping="Wrap" TextTrimming="None" />
								</HyperlinkButton>
							</Grid>
						</StackPanel>
					</Border>

				</StackPanel>
			</ScrollViewer>
		</TabItem>

		<!--  媒体  -->
		<TabItem Header="{x:Static spp:Strings.Media}">
			<Panel>
				<Grid
					x:Name="SteamGridDBContent"
					Margin="0,12,0,0"
					RowDefinitions="Auto,*"
					IsVisible="False">
					<Border
						Margin="0,0,0,8"
						BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
						BorderThickness="0,0,0,1">
						<Grid Margin="0,0,0,6" ColumnDefinitions="Auto,*">
							<Button
								Padding="8,6"
								Click="HideGridDialog_Click"
								Cursor="Hand"
								Theme="{StaticResource TransparentButton}">
								<StackPanel Orientation="Horizontal" Spacing="8">
									<ui:FASymbolIcon FontSize="16" Symbol="Back" />
									<TextBlock VerticalAlignment="Center"
									           Text="{x:Static spp:Strings.Back}" />
								</StackPanel>
							</Button>
							<TextBlock
								Grid.Column="1"
								HorizontalAlignment="Right"
								VerticalAlignment="Center"
								Classes="hint"
								Text="SteamGridDB" />
						</Grid>
					</Border>
					<spp:ContentLoader
						Grid.Row="1"
						IsLoading="{Binding IsLoadingSteamGrid}"
						IsShowNoResultText="{Binding IsSteamGridEmpty}"
						NoResultMessage="{x:Static spp:Strings.FailedGetImageFromSteamGridDB}">
						<ScrollViewer Classes="page-scroll">
							<ItemsControl
								Margin="0,0,12,12"
								ItemsSource="{Binding SteamGridItems}"
								ScrollViewer.HorizontalScrollBarVisibility="Disabled"
								ScrollViewer.VerticalScrollBarVisibility="Auto">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel Orientation="Horizontal" />
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate DataType="{x:Type spp:SteamGridItem}">
										<spp:AppItem
											Title="{Binding Author.Name}"
											MaxWidth="150"
											Margin="5"
											Classes="Vertical"
											Cursor="Hand"
											Tapped="SteamGridDBItem_Tapped"
											ToolTip.Tip="{Binding Author.Name}">
											<spp:AppItem.MoreFlyout>
												<MenuFlyout>
													<MenuItem
														Command="{Binding $parent[UserControl].((spp:EditAppInfoPageViewModel)DataContext).OpenSteamGridDBImageUrlCommand}"
														CommandParameter="{Binding}"
														Header="{x:Static spp:Strings.OpenImageInBrowser}" />
													<MenuItem
														Command="{Binding $parent[UserControl].((spp:EditAppInfoPageViewModel)DataContext).OpenSteamGridDBAppUrlCommand}"
														CommandParameter="{Binding}"
														Header="{x:Static spp:Strings.OpenSteamGridDBInBrowser}" />
													<MenuItem
														Command="{Binding $parent[UserControl].((spp:EditAppInfoPageViewModel)DataContext).OpenSteamGridDBAuthorUrlCommand}"
														CommandParameter="{Binding}"
														Header="{x:Static spp:Strings.OpenTheAuthorPageInBrowser}" />
												</MenuFlyout>
											</spp:AppItem.MoreFlyout>
											<spp:AppItem.Image>
												<spp:Image2
													Width="150"
													DecodeWidth="150"
													Source="{Binding Thumb}"
													Stretch="Uniform" />
											</spp:AppItem.Image>
										</spp:AppItem>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
					</spp:ContentLoader>
				</Grid>

				<ScrollViewer x:Name="MediaContent" Classes="page-scroll" Container.Name="media" Container.Sizing="Width">
					<Grid
						Margin="0,12,12,16"
						ColumnDefinitions="*,*"
						ColumnSpacing="12"
						RowDefinitions="Auto,Auto,Auto,Auto"
						RowSpacing="12">
						<Grid.Styles>
							<ContainerQuery Name="media" Query="max-width:480">
								<Style Selector="Border#PortraitCard">
									<Setter Property="(Grid.ColumnSpan)" Value="2" />
								</Style>
								<Style Selector="Border#LogoCard">
									<Setter Property="(Grid.Row)" Value="1" />
									<Setter Property="(Grid.Column)" Value="0" />
									<Setter Property="(Grid.ColumnSpan)" Value="2" />
								</Style>
							</ContainerQuery>
						</Grid.Styles>

						<!--  横版封面  -->
						<Border Grid.Row="2" Classes="card" Grid.ColumnSpan="2">
							<StackPanel Spacing="8">
								<Grid ColumnDefinitions="*,Auto">
									<StackPanel VerticalAlignment="Center">
										<TextBlock FontWeight="SemiBold" TextWrapping="Wrap"
										           Text="{x:Static spp:Strings.HorizontalTitlePage}" />
										<TextBlock
											Classes="hint"
											Text="460 x 215 px"
											ToolTip.Tip="{x:Static spp:Strings.RecommendedResolution}" />
									</StackPanel>
									<StackPanel
										Grid.Column="1"
										Orientation="Horizontal"
										Spacing="2">
										<Button
											Classes="tool"
											Click="ShowGridDialog_Click"
											Tag="{x:Static spp:SteamGridItemType.Header}"
											ToolTip.Tip="{x:Static spp:Strings.GetImageFromSteamGridDB}">
											<ui:FASymbolIcon FontSize="18" Symbol="CloudDownload" />
										</Button>
										<Button
											Classes="tool"
											Click="ResetGridImage_Click"
											Tag="{x:Static spp:SteamGridItemType.Header}"
											ToolTip.Tip="{x:Static spp:Strings.Reset}">
											<ui:FASymbolIcon FontSize="18" Symbol="Redo" />
										</Button>
									</StackPanel>
								</Grid>
								<Border Classes="preview">
									<spp:CustomFilePicker
										MinWidth="0"
										Height="132"
										FileStream="{Binding App.EditHeaderLogoStream, Mode=TwoWay}">
										<spp:Image2
											DecodeHeight="220"
											KeepSourceStreamOpen="True"
											Source="{Binding App.EditHeaderLogoStream}"
											Stretch="Uniform" />
									</spp:CustomFilePicker>
								</Border>
							</StackPanel>
						</Border>

						<!--  背景  -->
						<Border
							Grid.Row="3"
							Classes="card"
							Grid.ColumnSpan="2">
							<StackPanel Spacing="8">
								<Grid ColumnDefinitions="*,Auto">
									<StackPanel VerticalAlignment="Center">
										<TextBlock FontWeight="SemiBold" TextWrapping="Wrap"
										           Text="{x:Static spp:Strings.Background}" />
										<TextBlock
											Classes="hint"
											Text="1920 x 620 px"
											ToolTip.Tip="{x:Static spp:Strings.RecommendedResolution}" />
									</StackPanel>
									<StackPanel
										Grid.Column="1"
										Orientation="Horizontal"
										Spacing="2">
										<Button
											Classes="tool"
											Click="ShowGridDialog_Click"
											Tag="{x:Static spp:SteamGridItemType.Hero}"
											ToolTip.Tip="{x:Static spp:Strings.GetImageFromSteamGridDB}">
											<ui:FASymbolIcon FontSize="18" Symbol="CloudDownload" />
										</Button>
										<Button
											Classes="tool"
											Click="ResetGridImage_Click"
											Tag="{x:Static spp:SteamGridItemType.Hero}"
											ToolTip.Tip="{x:Static spp:Strings.Reset}">
											<ui:FASymbolIcon FontSize="18" Symbol="Redo" />
										</Button>
									</StackPanel>
								</Grid>
								<Border Classes="preview">
									<spp:CustomFilePicker
										MinWidth="0"
										Height="112"
										FileStream="{Binding App.EditLibraryHeroStream, Mode=TwoWay}">
										<spp:Image2
											DecodeHeight="180"
											KeepSourceStreamOpen="True"
											Source="{Binding App.EditLibraryHeroStream}"
											Stretch="Uniform" />
									</spp:CustomFilePicker>
								</Border>
							</StackPanel>
						</Border>

						<!--  竖版封面  -->
						<Border x:Name="PortraitCard" Grid.Row="0" Classes="card">
							<StackPanel Spacing="8">
								<Grid ColumnDefinitions="*,Auto">
									<StackPanel VerticalAlignment="Center">
										<TextBlock FontWeight="SemiBold" TextWrapping="Wrap"
										           Text="{x:Static spp:Strings.VerticalTitlePage}" />
										<TextBlock
											Classes="hint"
											Text="600 x 900 px"
											ToolTip.Tip="{x:Static spp:Strings.RecommendedResolution}" />
									</StackPanel>
									<StackPanel
										Grid.Column="1"
										Orientation="Horizontal"
										Spacing="2">
										<Button
											Classes="tool"
											Click="ShowGridDialog_Click"
											Tag="{x:Static spp:SteamGridItemType.Grid}"
											ToolTip.Tip="{x:Static spp:Strings.GetImageFromSteamGridDB}">
											<ui:FASymbolIcon FontSize="18" Symbol="CloudDownload" />
										</Button>
										<Button
											Classes="tool"
											Click="ResetGridImage_Click"
											Tag="{x:Static spp:SteamGridItemType.Grid}"
											ToolTip.Tip="{x:Static spp:Strings.Reset}">
											<ui:FASymbolIcon FontSize="18" Symbol="Redo" />
										</Button>
									</StackPanel>
								</Grid>
								<Border Classes="preview">
									<spp:CustomFilePicker
										MinWidth="0"
										Height="176"
										FileStream="{Binding App.EditLibraryGridStream, Mode=TwoWay}">
										<spp:Image2
											DecodeHeight="300"
											KeepSourceStreamOpen="True"
											Source="{Binding App.EditLibraryGridStream}"
											Stretch="Uniform" />
									</spp:CustomFilePicker>
								</Border>
							</StackPanel>
						</Border>

						<!--  图标  -->
						<Border
							x:Name="LogoCard"
							Classes="card">
							<StackPanel Spacing="8">
								<Grid ColumnDefinitions="*,Auto">
									<StackPanel VerticalAlignment="Center">
										<TextBlock FontWeight="SemiBold" TextWrapping="Wrap"
										           Text="{x:Static spp:Strings.Icon}" />
										<TextBlock
											Classes="hint"
											Text="120 x 120 px"
											ToolTip.Tip="{x:Static spp:Strings.RecommendedResolution}" />
									</StackPanel>
									<StackPanel
										Grid.Column="1"
										Orientation="Horizontal"
										Spacing="2">
										<Button
											Classes="tool"
											Click="ShowGridDialog_Click"
											Tag="{x:Static spp:SteamGridItemType.Logo}"
											ToolTip.Tip="{x:Static spp:Strings.GetImageFromSteamGridDB}">
											<ui:FASymbolIcon FontSize="18" Symbol="CloudDownload" />
										</Button>
										<Button
											Classes="tool"
											Click="ResetGridImage_Click"
											Tag="{x:Static spp:SteamGridItemType.Logo}"
											ToolTip.Tip="{x:Static spp:Strings.Reset}">
											<ui:FASymbolIcon FontSize="18" Symbol="Redo" />
										</Button>
									</StackPanel>
								</Grid>
								<Border Classes="preview">
									<spp:CustomFilePicker
										MinWidth="0"
										Height="176"
										FileStream="{Binding App.EditLibraryLogoStream, Mode=TwoWay}">
										<spp:Image2
											DecodeHeight="300"
											KeepSourceStreamOpen="True"
											Source="{Binding App.EditLibraryLogoStream}"
											Stretch="Uniform" />
									</spp:CustomFilePicker>
								</Border>
							</StackPanel>
						</Border>
					</Grid>
				</ScrollViewer>
			</Panel>
		</TabItem>

		<!--  启动项  -->
		<TabItem Header="{x:Static spp:Strings.LaunchItem}"
		         IsVisible="{Binding App.IsInstalled}">
			<ScrollViewer Classes="page-scroll">
				<StackPanel Margin="0,12,12,16" Spacing="12">
					<ItemsControl ItemsSource="{Binding App.LaunchItems}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Orientation="Vertical" Spacing="10" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate DataType="{x:Type spp:SteamAppLaunchItem}">
								<Border Classes="card">
									<StackPanel Spacing="12">
										<Grid Classes="field" RowDefinitions="Auto,Auto">
											<TextBlock Classes="label"
											           Text="{x:Static spp:Strings.Name}" />
											<TextBox Text="{Binding Label}" />
										</Grid>
										<Grid Classes="field" RowDefinitions="Auto,Auto">
											<TextBlock Classes="label"
											           Text="{x:Static spp:Strings.ExecutableFile}" />
											<TextBox Text="{Binding Executable}" />
										</Grid>
										<Grid Classes="field" RowDefinitions="Auto,Auto">
											<TextBlock Classes="label"
											           Text="{x:Static spp:Strings.Arguments}" />
											<TextBox Text="{Binding Arguments}" />
										</Grid>
										<Grid Classes="field" RowDefinitions="Auto,Auto">
											<TextBlock Classes="label"
											           Text="{x:Static spp:Strings.WorkingDir}" />
											<TextBox Text="{Binding WorkingDir}" />
										</Grid>
										<Grid Classes="field" RowDefinitions="Auto,Auto">
											<TextBlock Classes="label"
											           Text="{x:Static spp:Strings.SupportSystem}" />
											<ui:FAComboBox
												Grid.Row="1"
												HorizontalAlignment="Stretch"
												IsEditable="True"
												Text="{Binding Platform, Mode=TwoWay}">
												<ui:FAComboBox.Items>
													<x:String>windows</x:String>
													<x:String>linux</x:String>
													<x:String>macos</x:String>
												</ui:FAComboBox.Items>
											</ui:FAComboBox>
										</Grid>

										<WrapPanel Classes="actions" HorizontalAlignment="Right" Orientation="Horizontal">
											<Button
												Command="{Binding $parent[UserControl].((spp:EditAppInfoPageViewModel)DataContext).UpLaunchItemCommand}"
												CommandParameter="{Binding}"
												Content="{x:Static spp:Strings.MoveUp}"
												Cursor="Hand" />
											<Button
												Command="{Binding $parent[UserControl].((spp:EditAppInfoPageViewModel)DataContext).DownLaunchItemCommand}"
												CommandParameter="{Binding}"
												Content="{x:Static spp:Strings.MoveDown}"
												Cursor="Hand" />
											<Button
												Command="{Binding $parent[UserControl].((spp:EditAppInfoPageViewModel)DataContext).DeleteLaunchItemCommand}"
												CommandParameter="{Binding}"
												Content="{x:Static spp:Strings.Delete}"
												Cursor="Hand" />
										</WrapPanel>
									</StackPanel>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
					<Button
						HorizontalAlignment="Stretch"
						HorizontalContentAlignment="Center"
						Command="{Binding AddLaunchItem}"
						Cursor="Hand">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<ui:FASymbolIcon FontSize="18" Symbol="Add" />
							<TextBlock VerticalAlignment="Center"
							           Text="{x:Static spp:Strings.Add}" />
						</StackPanel>
					</Button>
				</StackPanel>
			</ScrollViewer>
		</TabItem>

		<!--  云存档  -->
		<TabItem Header="{x:Static spp:Strings.SaveFile}"
		         IsVisible="{Binding App.IsCloudArchive}">
			<ScrollViewer Classes="page-scroll">
				<StackPanel Margin="0,12,12,16" Spacing="12">
					<Border Classes="card">
						<StackPanel Spacing="12">
							<Grid Classes="row" ColumnDefinitions="*,Auto">
								<Grid
									ColumnDefinitions="*,Auto"
									ColumnSpacing="8"
									VerticalAlignment="Center">
									<TextBlock Classes="label"
									           Text="{x:Static spp:Strings.CloudSaveFileSize}" />
									<Button
										Grid.Column="1"
										Classes="tool"
										Command="{Binding ManageCloudArchive_Click}"
										ToolTip.Tip="{x:Static spp:Strings.GameList_CloudArchiveManager}">
										<ui:FASymbolIcon FontSize="18" Symbol="CloudBackup" />
									</Button>
								</Grid>
								<TextBlock
									Grid.Column="1"
									VerticalAlignment="Center"
									Text="{Binding App.CloudQuota, Converter={StaticResource StringFormatConverter}, ConverterParameter=size}" />
							</Grid>
							<Grid Classes="row" ColumnDefinitions="*,Auto">
								<TextBlock Classes="label"
								           Text="{x:Static spp:Strings.CloudMaxnumFiles}" />
								<TextBlock
									Grid.Column="1"
									VerticalAlignment="Center"
									Text="{Binding App.CloudMaxnumFiles}" />
							</Grid>
						</StackPanel>
					</Border>

					<ItemsControl ItemsSource="{Binding App.SaveFiles}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Orientation="Vertical" Spacing="10" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate DataType="{x:Type spp:SteamAppSaveFile}">
								<Border Classes="card">
									<StackPanel Spacing="12">
										<Grid Classes="row" ColumnDefinitions="3*,7*">
											<TextBlock Classes="label" Text="Root" />
											<TextBlock Classes="value" Text="{Binding Root}" />
										</Grid>
										<Grid Classes="row" ColumnDefinitions="3*,7*">
											<TextBlock Classes="label" Text="Path" />
											<TextBlock Classes="value" Text="{Binding Path}" />
										</Grid>
										<Grid Classes="row" ColumnDefinitions="3*,7*">
											<TextBlock Classes="label" Text="Pattern" />
											<TextBlock Classes="value" Text="{Binding Pattern}" />
										</Grid>
										<Grid Classes="row" ColumnDefinitions="3*,7*">
											<TextBlock Classes="label"
											           Text="{x:Static spp:Strings.DirPath}" />
											<HyperlinkButton
												Grid.Column="1"
												Padding="0"
												HorizontalAlignment="Stretch"
												Command="{Binding $parent[UserControl].((spp:EditAppInfoPageViewModel)DataContext).OpenFolder}"
												CommandParameter="{Binding FormatDirPath}"
												ToolTip.Tip="{Binding Source={x:Static spp:Strings.Settings_General_BrowseCustomFolder}, Mode=OneTime, Converter={StaticResource StringFormatConverter}, ConverterParameter={x:Null}}">
												<TextBlock Text="{Binding FormatDirPath}" TextWrapping="Wrap" TextTrimming="None" />
											</HyperlinkButton>
										</Grid>
									</StackPanel>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>
			</ScrollViewer>
		</TabItem>
	</TabControl>
</UserControl>